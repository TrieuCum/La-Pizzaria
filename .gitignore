## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## See https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# [Bb]in/ and [Oo]bj/
[Bb]in/
[Oo]bj/

# Visual Studio 2015/2017/2019/2022 cache/options directory
.vs/

# Visual Studio Code directory
.vscode/

# User-specific files
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
x64/
x86/
[Aa]rm/
[Aa]rm64/
bbin/
obj/
external/

# Others
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
*.docstates

# ASP.NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# Environment files
appsettings.Development.json
.env
.env.*

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# Rider / IntelliJ
.idea/

# Logs
*.log
Thumbs.db
