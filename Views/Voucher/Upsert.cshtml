@model LaPizzaria.Models.Voucher
@using LaPizzaria.Models

@{
    ViewData["Title"] = (Model.Id == 0 ? "Tạo Voucher Mới" : "Chỉnh Sửa Voucher");
    var users = ViewBag.Users as List<ApplicationUser> ?? new List<ApplicationUser>();
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    :root {
        --brand-orange: #ff7a00;
        --brand-orange-light: #fff7ed;
        --brand-dark: #0f172a;
        --brand-gray: #64748b;
        --brand-gray-light: #f1f5f9;
        --success: #10b981;
        --card-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    }

    body {
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        font-family: 'Plus Jakarta Sans', sans-serif;
        color: var(--brand-dark);
        min-height: 100vh;
    }

    .upsert-wrapper {
        padding: 3rem 1rem;
        max-width: 1000px;
        margin: 0 auto;
    }

    .glass-header {
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(8px);
        border-radius: 16px;
        padding: 1.5rem 2rem;
        border: 1px solid rgba(255, 255, 255, 0.5);
        margin-bottom: 2.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-shadow: var(--card-shadow);
    }

    .header-title-group h1 {
        font-size: 24px;
        font-weight: 800;
        margin: 0;
        color: var(--brand-dark);
        letter-spacing: -0.025em;
    }

    .header-title-group p {
        margin: 0.25rem 0 0 0;
        color: var(--brand-gray);
        font-size: 14px;
    }

    .section-card {
        background: white;
        border-radius: 20px;
        border: 1px solid #e2e8f0;
        padding: 2rem;
        margin-bottom: 2rem;
        box-shadow: var(--card-shadow);
        transition: transform 0.2s ease;
    }

    .section-title {
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        color: var(--brand-dark);
    }

    .section-title i {
        width: 36px;
        height: 36px;
        background: var(--brand-orange-light);
        color: var(--brand-orange);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    .form-group-custom {
        margin-bottom: 1.5rem;
    }

    .label-brand {
        font-size: 13px;
        font-weight: 700;
        color: var(--brand-gray);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.6rem;
        display: block;
    }

    .input-brand {
        width: 100%;
        padding: 0.8rem 1.2rem;
        background: #f8fafc;
        border: 1.5px solid #e2e8f0;
        border-radius: 12px;
        font-size: 15px;
        font-weight: 500;
        color: var(--brand-dark);
        transition: all 0.2s ease;
        outline: none;
    }

    .input-brand:focus {
        background: white;
        border-color: var(--brand-orange);
        box-shadow: 0 0 0 4px rgba(255, 122, 0, 0.1);
    }

    .input-brand::placeholder {
        color: #94a3b8;
    }

    .select-brand {
        appearance: none;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%2364748b' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M6 8l4 4 4-4'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right 1rem center;
        background-size: 1.25rem;
    }

    .helper-text {
        font-size: 12px;
        color: var(--brand-gray);
        margin-top: 0.5rem;
    }

    .day-selector {
        background: #f8fafc;
        padding: 1.25rem;
        border-radius: 14px;
        border: 1px solid #e2e8f0;
    }

    .day-pill {
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 600;
        transition: all 0.2s ease;
    }

    .day-check:checked + .day-pill {
        background: var(--brand-orange);
        border-color: var(--brand-orange);
        color: white;
    }

    .action-bar {
        position: sticky;
        bottom: 2rem;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(12px);
        padding: 1.25rem 2rem;
        border-radius: 20px;
        border: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 1rem;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
        z-index: 100;
    }

    .btn-brand-primary {
        background: var(--brand-orange);
        color: white;
        border: none;
        padding: 0.8rem 2.5rem;
        border-radius: 12px;
        font-weight: 700;
        font-size: 15px;
        transition: all 0.2s ease;
    }

    .btn-brand-primary:hover {
        background: #e66e00;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(255, 122, 0, 0.2);
    }

    .btn-brand-ghost {
        background: transparent;
        color: var(--brand-gray);
        border: 1px solid transparent;
        padding: 0.8rem 1.5rem;
        border-radius: 12px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .btn-brand-ghost:hover {
        background: var(--brand-gray-light);
        color: var(--brand-dark);
    }

    .badge-status {
        font-size: 12px;
        font-weight: 800;
        padding: 0.4rem 1rem;
        border-radius: 100px;
        text-transform: uppercase;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }

    .badge-active { background: #ecfdf5; color: #059669; }
    .badge-inactive { background: #fef2f2; color: #dc2626; }

    .switch-modern {
        position: relative;
        display: inline-block;
        width: 48px;
        height: 24px;
    }

    .switch-modern input { display: none; }

    .slider-modern {
        position: absolute;
        cursor: pointer;
        top: 0; left: 0; right: 0; bottom: 0;
        background-color: #cbd5e1;
        transition: .4s;
        border-radius: 24px;
    }

    .slider-modern:before {
        position: absolute;
        content: "";
        height: 18px; width: 18px;
        left: 3px; bottom: 3px;
        background-color: white;
        transition: .4s;
        border-radius: 50%;
    }

    input:checked + .slider-modern { background-color: var(--brand-orange); }
    input:checked + .slider-modern:before { transform: translateX(24px); }
</style>

<div class="upsert-wrapper">
    <div class="glass-header">
        <div class="header-title-group">
            <h1>@ViewData["Title"]</h1>
            <p>Hệ thống quản lý chương trình khuyến mãi LaPizzaria</p>
        </div>
        <div>
            @if (Model.Id > 0)
            {
                <span class="badge-status @(Model.IsActive ? "badge-active" : "badge-inactive")">
                    <i class="bi bi-circle-fill" style="font-size: 8px;"></i>
                    @(Model.IsActive ? "Đang hoạt động" : "Tạm ngưng")
                </span>
            }
        </div>
    </div>

    <form method="post">
        <input type="hidden" asp-for="Id" />
        
        <!-- Section: Basic Information -->
        <div class="section-card">
            <div class="section-title">
                <i class="bi bi-info-square"></i>
                Thông tin cơ bản
            </div>
            
            <div class="row g-4">
                <div class="col-md-5">
                    <div class="form-group-custom">
                        <label asp-for="Code" class="label-brand">Mã Voucher</label>
                        <input asp-for="Code" class="input-brand" placeholder="Ví dụ: PIZZA_SEAFOOD_50" required />
                        <p class="helper-text">Khách hàng sẽ nhập mã này tại bước thanh toán.</p>
                    </div>
                </div>
                <div class="col-md-7">
                    <div class="form-group-custom">
                        <label asp-for="Name" class="label-brand">Tên Chương Trình</label>
                        <input asp-for="Name" class="input-brand" placeholder="Ví dụ: Giảm 50k cho đơn có Pizza Hải Sản" required />
                    </div>
                </div>
            </div>

            <div class="row g-4 mt-1">
                <div class="col-md-5">
                    <div class="form-group-custom">
                        <label asp-for="VoucherType" class="label-brand">Loại ưu đãi</label>
                        <select asp-for="VoucherType" class="input-brand select-brand" id="voucherTypeSelect">
                            <option value="Percentage">Phần trăm (%)</option>
                            <option value="FixedAmount">Số tiền cố định (VNĐ)</option>
                            <option value="FreeShipping">Miễn phí giao hàng</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-7">
                    <div id="percentField" class="form-group-custom">
                        <label asp-for="DiscountPercent" class="label-brand">Giá trị giảm giá (%)</label>
                        <div class="position-relative">
                            <input type="number" step="1" min="0" max="100" asp-for="DiscountPercent" class="input-brand" placeholder="0 - 100" />
                            <span class="position-absolute end-0 top-50 translate-middle-y pe-4 fw-bold text-brand-gray">%</span>
                        </div>
                    </div>

                    <div id="amountField" class="form-group-custom" style="display: none;">
                        <label asp-for="DiscountAmount" class="label-brand" id="amountLabel">Số tiền giảm (VNĐ)</label>
                        <div class="position-relative">
                            <input type="number" step="1000" min="0" asp-for="DiscountAmount" class="input-brand" placeholder="Nhập số tiền" />
                            <span class="position-absolute end-0 top-50 translate-middle-y pe-4 fw-bold text-brand-gray">₫</span>
                        </div>
                        <p class="helper-text" id="amountHelper">Đơn hàng sẽ được trừ thẳng số tiền này.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section: Usage Rules -->
        <div class="section-card">
            <div class="section-title">
                <i class="bi bi-shield-check"></i>
                Điều kiện áp dụng
            </div>

            <div class="row g-4">
                <div class="col-md-6">
                    <div class="form-group-custom">
                        <label asp-for="TargetProductId" class="label-brand">Món ăn bắt buộc (Điều kiện cần)</label>
                        <select asp-for="TargetProductId" class="input-brand select-brand">
                            <option value="">Tất cả các món (Không bắt buộc)</option>
                            @if (ViewBag.Products != null)
                            {
                                foreach(var product in (List<Product>)ViewBag.Products)
                                {
                                    <option value="@product.Id">@product.Name [@product.Category]</option>
                                }
                            }
                        </select>
                        <p class="helper-text">Đơn hàng **phải chứa món này** để có thể sử dụng voucher.</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group-custom">
                        <label asp-for="MinOrderValue" class="label-brand">Giá trị đơn hàng tối thiểu</label>
                        <div class="position-relative">
                            <input type="number" step="1000" min="0" asp-for="MinOrderValue" class="input-brand" placeholder="0 = Không yêu cầu" />
                            <span class="position-absolute end-0 top-50 translate-middle-y pe-4 fw-bold text-brand-gray">₫</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-4 mt-1">
                <div class="col-md-6">
                    <div class="form-group-custom">
                        <label asp-for="TargetUserId" class="label-brand">Khách hàng mục tiêu</label>
                        <select asp-for="TargetUserId" class="input-brand select-brand">
                            <option value="">Công khai (Tất cả khách hàng)</option>
                            @foreach(var user in users)
                            {
                                <option value="@user.Id">@user.Email (@user.FirstName @user.LastName)</option>
                            }
                        </select>
                        <p class="helper-text">Nếu chọn, chỉ khách hàng này mới thấy và dùng được mã.</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group-custom">
                        <label asp-for="MaxUses" class="label-brand">Tổng lượt sử dụng tối đa</label>
                        <input type="number" min="0" asp-for="MaxUses" class="input-brand" placeholder="0 = Không giới hạn" />
                        <p class="helper-text">Đã dùng: <strong>@Model.UsedCount</strong> lượt.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section: Schedule & Availability -->
        <div class="section-card">
            <div class="section-title">
                <i class="bi bi-calendar-check"></i>
                Lịch trình & Hiệu lực
            </div>

            <div class="row g-4">
                <div class="col-md-6">
                    <div class="form-group-custom">
                        <label asp-for="StartsAt" class="label-brand">Ngày bắt đầu</label>
                        <input type="text" asp-for="StartsAt" id="StartsAt" class="input-brand flatpickr-datetime" placeholder="Chọn ngày bắt đầu" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group-custom">
                        <label asp-for="ExpiresAt" class="label-brand">Ngày hết hạn</label>
                        <input type="text" asp-for="ExpiresAt" id="ExpiresAt" class="input-brand flatpickr-datetime" placeholder="Chọn ngày hết hạn" />
                    </div>
                </div>
            </div>

            <div class="mt-4">
                <label class="label-brand">Lặp lại vào các ngày trong tuần</label>
                <div class="day-selector d-flex flex-wrap gap-2">
                    <input type="hidden" asp-for="ValidDaysOfWeek" id="validDaysValue" />
                    @{
                        var days = new[] { ("0", "CN"), ("1", "T2"), ("2", "T3"), ("3", "T4"), ("4", "T5"), ("5", "T6"), ("6", "T7") };
                        var currentDays = Model.ValidDaysOfWeek?.Split(',') ?? Array.Empty<string>();
                    }
                    @foreach (var day in days)
                    {
                        <div class="flex-grow-1">
                            <input class="day-check d-none" type="checkbox" value="@day.Item1" id="day_@day.Item1" @(currentDays.Contains(day.Item1) ? "checked" : "")>
                            <label class="day-pill justify-content-center" for="day_@day.Item1">@day.Item2</label>
                        </div>
                    }
                </div>
                <p class="helper-text mt-2">Ví dụ: Chỉ cho phép dùng mã vào Thứ 7 và Chủ Nhật.</p>
            </div>

            <div class="row g-4 mt-3">
                <div class="col-md-6">
                    <div class="form-group-custom">
                        <label asp-for="StartTime" class="label-brand">Giờ bắt đầu (Mỗi ngày)</label>
                        <input type="text" asp-for="StartTime" id="StartTime" class="input-brand flatpickr-time" placeholder="--:--" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group-custom">
                        <label asp-for="EndTime" class="label-brand">Giờ kết thúc (Mỗi ngày)</label>
                        <input type="text" asp-for="EndTime" id="EndTime" class="input-brand flatpickr-time" placeholder="--:--" />
                    </div>
                </div>
            </div>

            <div class="d-flex align-items-center gap-3 mt-4 pt-3 border-top">
                <label class="switch-modern">
                    <input type="checkbox" asp-for="IsActive">
                    <span class="slider-modern"></span>
                </label>
                <div>
                    <label class="label-brand mb-0" style="text-transform: none; font-size: 15px;">Kích hoạt Voucher này</label>
                    <p class="helper-text mt-0">Cho phép hệ thống nhận diện và áp dụng mã này.</p>
                </div>
            </div>
        </div>

        <div class="action-bar">
            <a asp-action="Index" class="btn-brand-ghost">Hủy bỏ</a>
            <button type="submit" class="btn-brand-primary">
                <i class="bi bi-check-lg me-2"></i>
                @(Model.Id == 0 ? "Tạo Voucher" : "Cập nhật Voucher")
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Flatpickr Initializations
            flatpickr(".flatpickr-datetime", {
                enableTime: true,
                dateFormat: "Y-m-d H:i:S", // Format for the underlying input (matching model)
                altInput: true,
                altFormat: "d/m/Y H:i",    // Display format: dd/mm/yyyy
                locale: "vn",
                time_24hr: true,
                allowInput: true
            });

            flatpickr(".flatpickr-time", {
                enableTime: true,
                noCalendar: true,
                dateFormat: "H:i",
                altInput: true,
                altFormat: "H:i",
                locale: "vn",
                time_24hr: true,
                allowInput: true
            });

            function toggleFields() {
                var type = $('#voucherTypeSelect').val();
                var $percent = $('#percentField');
                var $amount = $('#amountField');
                var $label = $('#amountLabel');
                var $helper = $('#amountHelper');

                if (type === 'Percentage') {
                    $percent.show();
                    $amount.hide();
                } else if (type === 'FixedAmount') {
                    $percent.hide();
                    $amount.show();
                    $label.text('Số tiền giảm trực tiếp (VNĐ)');
                    $helper.text('Đơn hàng sẽ được trừ thẳng số tiền này.');
                } else if (type === 'FreeShipping') {
                    $percent.hide();
                    $amount.show();
                    $label.text('Số tiền hỗ trợ tối đa (VNĐ)');
                    $helper.text('Mức giảm phí vận chuyển tối đa cho mã này.');
                }
            }

            $('#voucherTypeSelect').on('change', toggleFields);
            toggleFields();

            $('.day-check').on('change', function() {
                var selectedDays = [];
                $('.day-check:checked').each(function() {
                    selectedDays.push($(this).val());
                });
                $('#validDaysValue').val(selectedDays.join(','));
            });
        });
    </script>
}
