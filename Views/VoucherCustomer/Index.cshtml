@model LaPizzaria.ViewModels.VoucherCustomerIndexViewModel
@using LaPizzaria.Models
@{
    ViewData["Title"] = "Ưu đãi & Khuyến mãi";
    Layout = "_Layout";
    string SanitizeUrl(string? url) {
        if (string.IsNullOrEmpty(url)) return "/images/v17_2002.png";
        if (url.StartsWith("file:///", StringComparison.OrdinalIgnoreCase)) return "/images/" + System.IO.Path.GetFileName(url);
        return url;
    }

    // Format percent without trailing ".00" (e.g. 20.00 -> 20, 12.50 -> 12.5)
    string FormatPercent(decimal p) => p.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
}

<style>
    .voucher-hero-pill {
        color: #F97316;
        font-weight: 800;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.12em;
    }

    .voucher-hero-title {
        font-weight: 900;
        font-size: clamp(28px, 3vw, 38px);
        margin: 6px 0 4px;
        color: #0f172a;
        animation: voucher-heading-glow 0.9s ease-out forwards;
    }

    .voucher-hero-subtitle {
        color: #64748b;
        font-size: 15px;
        max-width: 520px;
    }

    .voucher-tabs {
        display: flex;
        gap: 24px;
        border-bottom: 1px solid #e2e8f0;
        padding-bottom: 12px;
        margin-bottom: 28px;
        font-weight: 600;
        font-size: 14px;
    }

    .voucher-tab {
        text-decoration: none;
        color: #94a3b8;
        padding-bottom: 10px;
        position: relative;
    }

    .voucher-tab.active {
        color: #F97316;
    }

    .voucher-tab.active::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: -11px;
        height: 3px;
        background: #F97316;
        border-radius: 999px;
    }

    .voucher-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 24px;
    }

    .voucher-card {
        background: #ffffff;
        border-radius: 20px;
        overflow: hidden;
        border: 1px solid #e2e8f0;
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.04);
        transform: translateY(18px) scale(0.98);
        opacity: 0;
        animation: voucher-card-in 0.6s ease-out forwards;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .voucher-card:nth-child(1) { animation-delay: 0.05s; }
    .voucher-card:nth-child(2) { animation-delay: 0.12s; }
    .voucher-card:nth-child(3) { animation-delay: 0.19s; }
    .voucher-card:nth-child(4) { animation-delay: 0.26s; }
    .voucher-card:nth-child(5) { animation-delay: 0.33s; }

    .voucher-card:hover {
        transform: translateY(0) scale(1.015);
        box-shadow: 0 18px 40px rgba(15, 23, 42, 0.18);
    }

    .voucher-card-banner {
        height: 180px;
        position: relative;
        overflow: hidden;
    }

    .voucher-card-banner img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transform: scale(1.02);
        transition: transform 0.4s ease;
    }

    .voucher-card:hover .voucher-card-banner img {
        transform: scale(1.06);
    }

    .voucher-badge {
        position: absolute;
        top: 14px;
        left: 14px;
        background: #F97316;
        color: #ffffff;
        padding: 6px 14px;
        border-radius: 999px;
        font-weight: 800;
        font-size: 13px;
    }

    .voucher-title {
        position: absolute;
        bottom: 14px;
        left: 14px;
        right: 14px;
        color: #ffffff;
        font-weight: 800;
        font-size: 19px;
        text-shadow: 0 4px 16px rgba(15, 23, 42, 0.9);
    }

    .voucher-card-body {
        padding: 22px 22px 20px;
    }

    .voucher-expiry {
        color: #F97316;
        font-weight: 700;
        font-size: 13px;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .voucher-desc {
        color: #64748b;
        font-size: 14px;
        line-height: 1.6;
        min-height: 44px;
    }

    .voucher-code-box {
        background: #f8fafc;
        border: 1px dashed #cbd5e1;
        border-radius: 12px;
        padding: 10px 14px;
        margin-top: 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .voucher-code-box.saved {
        background: #fefce8;
        border: 1px dashed #e2e8f0;
    }

    .voucher-code-box .voucher-code-label {
        display: none;
        font-weight: 700;
        font-size: 12px;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .voucher-code-box.saved .voucher-code-label {
        display: inline;
    }

    .voucher-code-box.saved .voucher-code-text {
        color: #F97316;
    }

    .voucher-code-box.saved .voucher-copy-btn {
        display: none;
    }

    .voucher-code-text {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
        font-weight: 800;
        font-size: 16px;
        color: #0f172a;
    }

    .voucher-btn-row {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 14px;
    }

    .voucher-btn-row .voucher-primary-btn {
        margin-top: 0;
        flex: 1;
    }

    .voucher-primary-btn.saved {
        background: #334155;
        color: #fff;
        box-shadow: none;
        cursor: default;
    }

    .voucher-primary-btn.saved:hover {
        transform: none;
        box-shadow: none;
    }

    .voucher-saved-check {
        width: 44px;
        height: 44px;
        min-width: 44px;
        border-radius: 12px;
        background: #fefce8;
        border: 1px dashed #e2e8f0;
        display: none;
        align-items: center;
        justify-content: center;
        color: #F97316;
        font-size: 20px;
    }

    .voucher-saved-check.show {
        display: flex;
    }

    .voucher-primary-btn,
    .voucher-secondary-btn {
        width: 100%;
        border-radius: 12px;
        border: none;
        padding: 13px 16px;
        font-weight: 800;
        margin-top: 14px;
        font-size: 14px;
        transition: transform 0.12s ease, box-shadow 0.12s ease, background-color 0.12s ease, color 0.12s ease;
    }

    .voucher-primary-btn {
        background: #F97316;
        color: #ffffff;
        box-shadow: 0 8px 18px rgba(248, 113, 22, 0.35);
    }

    .voucher-primary-btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 10px 26px rgba(248, 113, 22, 0.45);
    }

    .voucher-secondary-btn {
        background: #e2e8f0;
        color: #64748b;
    }

    .voucher-secondary-btn:hover {
        background: #cbd5f1;
        color: #475569;
    }

    .voucher-empty-card {
        border-radius: 20px;
        border: 2px dashed #e2e8f0;
        min-height: 240px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        color: #94a3b8;
    }

    .voucher-footer-widgets {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 24px;
        margin-top: 48px;
    }

    .voucher-widget {
        background: #ffffff;
        border-radius: 18px;
        padding: 22px 24px;
        display: flex;
        align-items: center;
        gap: 18px;
        border: 1px solid #e2e8f0;
    }

    .voucher-widget-icon {
        width: 54px;
        height: 54px;
        border-radius: 999px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        background: #fff7ed;
        color: #F97316;
    }

    .voucher-widget-title {
        font-weight: 800;
        margin: 0;
        color: #0f172a;
    }

    .voucher-widget-text {
        color: #94a3b8;
        margin: 4px 0 0;
        font-size: 13px;
    }

    .voucher-widget-link {
        font-weight: 800;
        text-decoration: none;
        font-size: 13px;
    }

    .voucher-site-footer {
        text-align: center;
        padding: 40px 0 10px;
        color: #94a3b8;
        font-weight: 600;
        font-size: 13px;
    }

    /* Animations */
    @@keyframes voucher-card-in {
        from {
            opacity: 0;
            transform: translateY(26px) scale(0.96);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @@keyframes voucher-heading-glow {
        0% { text-shadow: 0 0 0 rgba(248, 113, 22, 0); }
        100% { text-shadow: 0 10px 30px rgba(248, 113, 22, 0.55); }
    }

    .voucher-cat-pill {
        display: inline-block;
        padding: 10px 20px;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 999px;
        color: #64748b;
        text-decoration: none;
        font-weight: 700;
        font-size: 14px;
        transition: all 0.2s ease;
    }
    .voucher-cat-pill:hover { color: #F97316; border-color: #F97316; background: #fff7ed; }
    .voucher-cat-pill.active { background: #F97316; color: #fff; border-color: #F97316; }
</style>

<section class="py-5" style="background-color:#f8f7f5;">
    <div class="container">
        <div class="mb-4">
            <span class="voucher-hero-pill">Ưu đãi của bạn</span>
            <h1 class="voucher-hero-title">Ưu đãi &amp; Khuyến mãi</h1>
            <p class="voucher-hero-subtitle">
                Khám phá các ưu đãi độc quyền dành cho bữa tiệc pizza của bạn. Lưu mã để sử dụng nhanh khi thanh toán.
            </p>
        </div>

        <div class="voucher-tabs">
            <a asp-action="Index" asp-route-tab="vouchers" class="voucher-tab @(Model.CurrentTab == "vouchers" ? "active" : "")">Tất cả vouchers</a>
            <a asp-action="Index" asp-route-tab="monan" asp-route-category="All" class="voucher-tab @(Model.CurrentTab == "monan" ? "active" : "")">Món ăn</a>
            <a asp-action="Index" asp-route-tab="vanchuyen" class="voucher-tab @(Model.CurrentTab == "vanchuyen" ? "active" : "")">Vận chuyển</a>
            <a asp-action="Index" asp-route-tab="thanhvien" class="voucher-tab @(Model.CurrentTab == "thanhvien" ? "active" : "")">Thành viên</a>
        </div>

        <div id="panel-vouchers" class="voucher-tab-panel" style="@(Model.CurrentTab == "vouchers" ? "" : "display:none;")">
        <div class="voucher-grid" id="vouchers">
            @if (Model.Vouchers != null && Model.Vouchers.Any())
            {
                var imgs = new[] { "v17_2002.png", "v17_2035.png", "v17_2068.png", "v17_2101.png", "v17_2134.png" };
                var idx = 0;
                @foreach (var v in Model.Vouchers)
                {
                    var imgSrc = imgs[idx % imgs.Length];
                    idx++;
                    var badge = v.VoucherType == "Percentage" ? $"{FormatPercent(v.DiscountPercent)}% OFF" : v.VoucherType == "FixedAmount" ? $"{v.DiscountAmount:N0}₫" : "FREESHIP";
                    var isSaved = Model.SavedVoucherIds.Contains(v.Id);
                    <div class="voucher-card" data-voucher-id="@v.Id">
                        <div class="voucher-card-banner">
                            <img src="~/images/@imgSrc" alt="@v.Name" />
                            <span class="voucher-badge">@badge</span>
                            <div class="voucher-title">@v.Name</div>
                        </div>
                        <div class="voucher-card-body">
                            <div class="voucher-expiry">
                                <i class="bi bi-clock"></i>
                                @(v.ExpiresAtUtc.HasValue ? $"Hết hạn: {v.ExpiresAtUtc.Value:dd/MM/yyyy}" : "Không giới hạn")
                            </div>
                            <p class="voucher-desc">
                                @if (v.VoucherType == "Percentage") { <text>Giảm @FormatPercent(v.DiscountPercent)% cho đơn hàng. Min @v.MinOrderValue.ToString("N0")₫.</text> }
                                else if (v.VoucherType == "FixedAmount") { <text>Giảm @v.DiscountAmount.ToString("N0")₫. Min đơn @v.MinOrderValue.ToString("N0")₫.</text> }
                                else { <text>Miễn phí vận chuyển.</text> }
                            </p>
                            <div class="voucher-code-box @(isSaved ? "saved" : "")">
                                <span class="voucher-code-label">MÃ ƯU ĐÃI</span>
                                <span class="voucher-code-text">@v.Code</span>
                                <button type="button" class="btn btn-link p-0 text-secondary voucher-copy-btn" onclick="copyVoucher('@v.Code')"><i class="bi bi-clipboard"></i></button>
                            </div>
                            <div class="voucher-btn-row">
                                <button type="button" class="voucher-primary-btn @(isSaved ? "saved" : "")" data-voucher-id="@v.Id" data-code="@v.Code" @(isSaved ? "disabled" : "") onclick="saveVoucherCode(this)">@(isSaved ? "Đã nhận mã" : "Lưu mã")</button>
                                <span class="voucher-saved-check @(isSaved ? "show" : "")" aria-hidden="true"><i class="bi bi-check-lg"></i></span>
                            </div>
                        </div>
                    </div>
                }
            }
            <div class="voucher-empty-card">
                <i class="bi bi-plus-circle mb-2" style="font-size:36px;"></i>
                <h5 class="fw-bold text-dark mb-1">Đang cập nhật thêm!</h5>
                <p class="text-muted mb-0 text-center" style="max-width:260px;">
                    Chúng tôi bổ sung các ưu đãi mới vào mỗi sáng Thứ Ba hàng tuần.
                </p>
            </div>
        </div>
        </div>

        <!-- Tab Món ăn: bộ lọc theo loại món, khi bấm vào món thì hiện các món thuộc loại đó -->
        <div id="panel-monan" class="voucher-tab-panel" style="@(Model.CurrentTab == "monan" ? "" : "display:none;")">
        <div class="mt-4">
            <h2 class="voucher-hero-title mb-3">Món ăn đang ưu đãi</h2>
            <p class="voucher-hero-subtitle mb-4">Chọn loại món để xem các món tương ứng.</p>
            <div class="d-flex flex-wrap gap-2 mb-4">
                @foreach (var cat in Model.CategoryFilters)
                {
                    <a asp-action="Index" asp-route-tab="monan" asp-route-category="@cat.Value"
                       class="voucher-cat-pill @(Model.CurrentCategory == cat.Value ? "active" : "")">@cat.Label</a>
                }
            </div>
            <div class="row g-4">
                @if (Model.CurrentCategory == "Combo" || Model.CurrentCategory == "All")
                {
                    @foreach (var c in Model.Combos)
                    {
                        var firstImg = c.Items?.FirstOrDefault(i => i.Product != null && !string.IsNullOrEmpty(i.Product.ImageUrl))?.Product?.ImageUrl;
                        var thumb = SanitizeUrl(!string.IsNullOrEmpty(c.ImageUrl) ? c.ImageUrl : firstImg);
                        var orig = c.Items?.Where(i => i.Product != null).Sum(i => i.Product!.Price * Math.Max(1, i.MinQuantity)) ?? 0;
                        var finalPrice = orig - c.DiscountAmount;
                        if (c.DiscountPercent.HasValue && c.DiscountPercent > 0) finalPrice = finalPrice * (1 - c.DiscountPercent.Value / 100m);
                        <div class="col-md-6 col-lg-4">
                            <div class="voucher-card h-100">
                                <div class="voucher-card-banner" style="height:140px;">
                                    <img src="@thumb" alt="@c.Name" style="object-fit:cover;width:100%;height:100%;" onerror="this.src='/images/v17_2035.png'" />
                                    <span class="voucher-badge">COMBO</span>
                                    <div class="voucher-title">@c.Name</div>
                                </div>
                                <div class="voucher-card-body">
                                    <p class="voucher-desc">@(c.Description ?? string.Join(", ", c.Items?.Select(i => i.Product?.Name) ?? Array.Empty<string>()))</p>
                                    <div class="d-flex justify-content-between align-items-center mt-2">
                                        <span class="fw-bold text-danger">@finalPrice.ToString("N0")₫</span>
                                        <button type="button" class="voucher-primary-btn py-2 px-3 small" onclick="cart.add({ id: @c.Id, name: '@c.Name.Replace("'","\\'")', price: @finalPrice, imageUrl: '@thumb', type: 'combo' }); typeof window.showToast === 'function' && window.showToast('Đã thêm combo vào giỏ', 'success');">Thêm vào giỏ</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                @if (Model.CurrentCategory != "Combo")
                {
                    @foreach (var p in Model.Products)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="voucher-card h-100">
                                <div class="voucher-card-banner" style="height:140px;">
                                    <img src="@SanitizeUrl(p.ImageUrl)" alt="@p.Name" style="object-fit:cover;width:100%;height:100%;" onerror="this.src='/images/v17_2002.png'" />
                                    <span class="voucher-badge">@p.Category</span>
                                    <div class="voucher-title">@p.Name</div>
                                </div>
                                <div class="voucher-card-body">
                                    <p class="voucher-desc">@(p.Description ?? "Món ngon từ La Pizzaria.")</p>
                                    <div class="d-flex justify-content-between align-items-center mt-2">
                                        <span class="fw-bold text-danger">@p.Price.ToString("N0")₫</span>
                                        <button type="button" class="voucher-primary-btn py-2 px-3 small" onclick="cart.add({ id: @p.Id, name: '@p.Name.Replace("'","\\'")', price: @p.Price, imageUrl: '@SanitizeUrl(p.ImageUrl)', type: 'product' }); typeof window.showToast === 'function' && window.showToast('Đã thêm vào giỏ', 'success');">Thêm vào giỏ</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                @if (!Model.Products.Any() && (Model.CurrentCategory != "Combo" || !Model.Combos.Any()) && Model.CurrentCategory != "All")
                {
                    <div class="col-12 text-center py-5 text-muted">
                        <i class="bi bi-inbox fs-1"></i>
                        <p class="mt-2">Chưa có món nào thuộc loại này.</p>
                    </div>
                }
                @if (Model.CurrentCategory == "All" && !Model.Products.Any() && !Model.Combos.Any())
                {
                    <div class="col-12 text-center py-5 text-muted">
                        <i class="bi bi-inbox fs-1"></i>
                        <p class="mt-2">Chưa có món nào. Hãy quay lại sau.</p>
                    </div>
                }
            </div>
        </div>
        </div>

        <!-- Tab Vận chuyển: voucher freeship -->
        <div id="panel-vanchuyen" class="voucher-tab-panel" style="@(Model.CurrentTab == "vanchuyen" ? "" : "display:none;")">
        <div class="voucher-grid mt-4">
            @{
                var freeshipVouchers = (Model.Vouchers ?? new List<Voucher>()).Where(v => v.VoucherType == "FreeShipping").ToList();
            }
            @if (freeshipVouchers.Any())
            {
                var imgs = new[] { "v17_2134.png", "v17_2035.png" };
                var i = 0;
                @foreach (var v in freeshipVouchers)
                {
                    var isSavedFreeship = Model.SavedVoucherIds.Contains(v.Id);
                    <div class="voucher-card" data-voucher-id="@v.Id">
                        <div class="voucher-card-banner">
                            <img src="~/images/@imgs[i % 2]" alt="@v.Name" />
                            <span class="voucher-badge">FREESHIP</span>
                            <div class="voucher-title">@v.Name</div>
                        </div>
                        <div class="voucher-card-body">
                            <div class="voucher-expiry"><i class="bi bi-clock"></i> @(v.ExpiresAtUtc.HasValue ? $"Hết hạn: {v.ExpiresAtUtc.Value:dd/MM/yyyy}" : "Không giới hạn")</div>
                            <p class="voucher-desc">@v.Name — Miễn phí vận chuyển.</p>
                            <div class="voucher-code-box @(isSavedFreeship ? "saved" : "")">
                                <span class="voucher-code-label">MÃ ƯU ĐÃI</span>
                                <span class="voucher-code-text">@v.Code</span>
                                <button type="button" class="btn btn-link p-0 text-secondary voucher-copy-btn" onclick="copyVoucher('@v.Code')"><i class="bi bi-clipboard"></i></button>
                            </div>
                            <div class="voucher-btn-row">
                                <button type="button" class="voucher-primary-btn @(isSavedFreeship ? "saved" : "")" data-voucher-id="@v.Id" data-code="@v.Code" @(isSavedFreeship ? "disabled" : "") onclick="saveVoucherCode(this)">@(isSavedFreeship ? "Đã nhận mã" : "Lưu mã")</button>
                                <span class="voucher-saved-check @(isSavedFreeship ? "show" : "")" aria-hidden="true"><i class="bi bi-check-lg"></i></span>
                            </div>
                        </div>
                    </div>
                    i++;
                }
            }
            else
            {
                <div class="voucher-empty-card" style="grid-column: 1 / -1;">
                    <i class="bi bi-truck mb-2" style="font-size:36px;"></i>
                    <h5 class="fw-bold text-dark mb-1">Ưu đãi vận chuyển</h5>
                    <p class="text-muted mb-0 text-center" style="max-width:320px;">Hiện chưa có mã miễn phí ship. Theo dõi trang để nhận thông báo khi có ưu đãi mới.</p>
                </div>
            }
        </div>
        </div>

        <!-- Tab Thành viên -->
        <div id="panel-thanhvien" class="voucher-tab-panel" style="@(Model.CurrentTab == "thanhvien" ? "" : "display:none;")">
        <div class="voucher-empty-card mt-4" style="min-height:200px;">
            <i class="bi bi-person-badge mb-2" style="font-size:36px; color:#F97316;"></i>
            <h5 class="fw-bold text-dark mb-1">Ưu đãi thành viên</h5>
            <p class="text-muted mb-0 text-center" style="max-width:320px;">Đăng nhập để xem ưu đãi dành riêng cho thành viên và tích điểm khi mua hàng.</p>
            <a asp-controller="Account" asp-action="Login" class="btn mt-3 voucher-primary-btn" style="width:auto;padding:10px 24px;">Đăng nhập</a>
        </div>
        </div>

        <div class="voucher-footer-widgets">
            <div class="voucher-widget">
                <div class="voucher-widget-icon">
                    <i class="bi bi-headset"></i>
                </div>
                <div>
                    <p class="voucher-widget-title">Bạn cần hỗ trợ?</p>
                    <p class="voucher-widget-text">Đội ngũ chúng tôi luôn sẵn sàng 24/7.</p>
                    <a href="#" class="voucher-widget-link text-warning">Trò chuyện ngay</a>
                </div>
            </div>

            <div class="voucher-widget">
                <div class="voucher-widget-icon" style="background:#e2e8f0;color:#0f172a;">
                    <i class="bi bi-journal-text"></i>
                </div>
                <div>
                    <p class="voucher-widget-title">Điều khoản áp dụng</p>
                    <p class="voucher-widget-text">Xem quy định sử dụng voucher và giới hạn khuyến mãi.</p>
                    <a href="#" class="voucher-widget-link text-dark">Xem chi tiết</a>
                </div>
            </div>
        </div>

        <div class="voucher-site-footer">
            Đồ án tốt nghiệp LaPizzaria - 2026
        </div>
