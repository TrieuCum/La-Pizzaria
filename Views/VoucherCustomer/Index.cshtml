@Html.AntiForgeryToken()
<script>
    var voucherPageIsAuthenticated = @(Model.IsAuthenticated ? "true" : "false");
    var voucherLoginUrl = '@Url.Action("Login", "Account")';

    function copyVoucher(code) {
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(code).then(function () {
                if (typeof window.showToast === 'function') window.showToast('Đã copy mã: ' + code, 'success');
                else alert('Đã copy mã: ' + code);
            });
        } else {
            var ta = document.createElement('textarea'); ta.value = code; document.body.appendChild(ta); ta.select(); document.execCommand('copy'); document.body.removeChild(ta);
            if (typeof window.showToast === 'function') window.showToast('Đã copy mã: ' + code, 'success');
            else alert('Đã copy mã: ' + code);
        }
    }

    function setVoucherCardSaved(card) {
        if (!card) return;
        var codeBox = card.querySelector('.voucher-code-box');
        var primaryBtn = card.querySelector('.voucher-btn-row .voucher-primary-btn');
        var checkEl = card.querySelector('.voucher-saved-check');
        if (codeBox) codeBox.classList.add('saved');
        if (primaryBtn) {
            primaryBtn.classList.add('saved');
            primaryBtn.textContent = 'Đã nhận mã';
            primaryBtn.disabled = true;
            primaryBtn.onclick = null;
        }
        if (checkEl) checkEl.classList.add('show');
    }

    function saveVoucherCode(btn) {
        var voucherId = parseInt(btn.getAttribute('data-voucher-id'), 10);
        var code = btn.getAttribute('data-code') || '';
        if (!voucherPageIsAuthenticated) {
            if (typeof window.showToast === 'function') window.showToast('Vui lòng đăng nhập để lưu mã vào tài khoản.', 'warning');
            else alert('Vui lòng đăng nhập để lưu mã vào tài khoản.');
            setTimeout(function() { window.location.href = voucherLoginUrl + '?returnUrl=' + encodeURIComponent(window.location.pathname + window.location.search); }, 1500);
            return;
        }
        var token = document.querySelector('input[name="__RequestVerificationToken"]');
        var tokenValue = token ? token.value : '';
        var formData = new FormData();
        formData.append('voucherId', voucherId);
        formData.append('__RequestVerificationToken', tokenValue);
        fetch('@Url.Action("SaveVoucher", "VoucherCustomer")', {
            method: 'POST',
            body: formData
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.success) {
                copyVoucher(code);
                if (typeof window.showToast === 'function') window.showToast(data.message || 'Đã lưu mã vào tài khoản.', 'success');
                var card = btn.closest('.voucher-card');
                setVoucherCardSaved(card);
            } else {
                if (typeof window.showToast === 'function') window.showToast(data.message || 'Không thể lưu mã.', 'error');
                else alert(data.message || 'Không thể lưu mã.');
            }
        })
        .catch(function() {
            if (typeof window.showToast === 'function') window.showToast('Có lỗi xảy ra. Vui lòng thử lại.', 'error');
            else alert('Có lỗi xảy ra. Vui lòng thử lại.');
        });
    }
</script>

