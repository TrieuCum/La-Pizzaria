@{
    ViewData["Title"] = "Ưu đãi & Khuyến mãi";
    Layout = "_Layout";
}

<style>
    .voucher-hero-pill {
        color: #F97316;
        font-weight: 800;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.12em;
    }

    .voucher-hero-title {
        font-weight: 900;
        font-size: clamp(28px, 3vw, 38px);
        margin: 6px 0 4px;
        color: #0f172a;
        animation: voucher-heading-glow 0.9s ease-out forwards;
    }

    .voucher-hero-subtitle {
        color: #64748b;
        font-size: 15px;
        max-width: 520px;
    }

    .voucher-tabs {
        display: flex;
        gap: 24px;
        border-bottom: 1px solid #e2e8f0;
        padding-bottom: 12px;
        margin-bottom: 28px;
        font-weight: 600;
        font-size: 14px;
    }

    .voucher-tab {
        text-decoration: none;
        color: #94a3b8;
        padding-bottom: 10px;
        position: relative;
    }

    .voucher-tab.active {
        color: #F97316;
    }

    .voucher-tab.active::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: -11px;
        height: 3px;
        background: #F97316;
        border-radius: 999px;
    }

    .voucher-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 24px;
    }

    .voucher-card {
        background: #ffffff;
        border-radius: 20px;
        overflow: hidden;
        border: 1px solid #e2e8f0;
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.04);
        transform: translateY(18px) scale(0.98);
        opacity: 0;
        animation: voucher-card-in 0.6s ease-out forwards;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .voucher-card:nth-child(1) { animation-delay: 0.05s; }
    .voucher-card:nth-child(2) { animation-delay: 0.12s; }
    .voucher-card:nth-child(3) { animation-delay: 0.19s; }
    .voucher-card:nth-child(4) { animation-delay: 0.26s; }
    .voucher-card:nth-child(5) { animation-delay: 0.33s; }

    .voucher-card:hover {
        transform: translateY(0) scale(1.015);
        box-shadow: 0 18px 40px rgba(15, 23, 42, 0.18);
    }

    .voucher-card-banner {
        height: 180px;
        position: relative;
        overflow: hidden;
    }

    .voucher-card-banner img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transform: scale(1.02);
        transition: transform 0.4s ease;
    }

    .voucher-card:hover .voucher-card-banner img {
        transform: scale(1.06);
    }

    .voucher-badge {
        position: absolute;
        top: 14px;
        left: 14px;
        background: #F97316;
        color: #ffffff;
        padding: 6px 14px;
        border-radius: 999px;
        font-weight: 800;
        font-size: 13px;
    }

    .voucher-title {
        position: absolute;
        bottom: 14px;
        left: 14px;
        right: 14px;
        color: #ffffff;
        font-weight: 800;
        font-size: 19px;
        text-shadow: 0 4px 16px rgba(15, 23, 42, 0.9);
    }

    .voucher-card-body {
        padding: 22px 22px 20px;
    }

    .voucher-expiry {
        color: #F97316;
        font-weight: 700;
        font-size: 13px;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .voucher-desc {
        color: #64748b;
        font-size: 14px;
        line-height: 1.6;
        min-height: 44px;
    }

    .voucher-code-box {
        background: #f8fafc;
        border: 1px dashed #cbd5e1;
        border-radius: 12px;
        padding: 10px 14px;
        margin-top: 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .voucher-code-text {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
        font-weight: 800;
        font-size: 16px;
        color: #0f172a;
    }

    .voucher-primary-btn,
    .voucher-secondary-btn {
        width: 100%;
        border-radius: 12px;
        border: none;
        padding: 13px 16px;
        font-weight: 800;
        margin-top: 14px;
        font-size: 14px;
        transition: transform 0.12s ease, box-shadow 0.12s ease, background-color 0.12s ease, color 0.12s ease;
    }

    .voucher-primary-btn {
        background: #F97316;
        color: #ffffff;
        box-shadow: 0 8px 18px rgba(248, 113, 22, 0.35);
    }

    .voucher-primary-btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 10px 26px rgba(248, 113, 22, 0.45);
    }

    .voucher-secondary-btn {
        background: #e2e8f0;
        color: #64748b;
    }

    .voucher-secondary-btn:hover {
        background: #cbd5f1;
        color: #475569;
    }

    .voucher-empty-card {
        border-radius: 20px;
        border: 2px dashed #e2e8f0;
        min-height: 240px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        color: #94a3b8;
    }

    .voucher-footer-widgets {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 24px;
        margin-top: 48px;
    }

    .voucher-widget {
        background: #ffffff;
        border-radius: 18px;
        padding: 22px 24px;
        display: flex;
        align-items: center;
        gap: 18px;
        border: 1px solid #e2e8f0;
    }

    .voucher-widget-icon {
        width: 54px;
        height: 54px;
        border-radius: 999px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        background: #fff7ed;
        color: #F97316;
    }

    .voucher-widget-title {
        font-weight: 800;
        margin: 0;
        color: #0f172a;
    }

    .voucher-widget-text {
        color: #94a3b8;
        margin: 4px 0 0;
        font-size: 13px;
    }

    .voucher-widget-link {
        font-weight: 800;
        text-decoration: none;
        font-size: 13px;
    }

    .voucher-site-footer {
        text-align: center;
        padding: 40px 0 10px;
        color: #94a3b8;
        font-weight: 600;
        font-size: 13px;
    }

    /* Animations */
    @@keyframes voucher-card-in {
        from {
            opacity: 0;
            transform: translateY(26px) scale(0.96);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @@keyframes voucher-heading-glow {
        0% { text-shadow: 0 0 0 rgba(248, 113, 22, 0); }
        100% { text-shadow: 0 10px 30px rgba(248, 113, 22, 0.55); }
    }
</style>

<section class="py-5" style="background-color:#f8f7f5;">
    <div class="container">
        <div class="mb-4">
            <span class="voucher-hero-pill">Ưu đãi của bạn</span>
            <h1 class="voucher-hero-title">Ưu đãi &amp; Khuyến mãi</h1>
            <p class="voucher-hero-subtitle">
                Khám phá các ưu đãi độc quyền dành cho bữa tiệc pizza của bạn. Lưu mã để sử dụng nhanh khi thanh toán.
            </p>
        </div>

        <div class="voucher-tabs">
            <a href="#" class="voucher-tab active">Tất cả vouchers</a>
            <a href="#" class="voucher-tab">Món ăn</a>
            <a href="#" class="voucher-tab">Vận chuyển</a>
            <a href="#" class="voucher-tab">Thành viên</a>
        </div>

        <div class="voucher-grid">
            <div class="voucher-card">
                <div class="voucher-card-banner">
                    <img src="~/images/v17_2002.png" alt="Margherita Monday" />
                    <span class="voucher-badge">50% OFF</span>
                    <div class="voucher-title">Margherita Monday</div>
                </div>
                <div class="voucher-card-body">
                    <div class="voucher-expiry">
                        <i class="bi bi-clock"></i>
                        Hết hạn: 15/12/2026
                    </div>
                    <p class="voucher-desc">
                        Giảm ngay 50% cho tất cả các loại bánh Margherita. Áp dụng cho cả ăn tại chỗ và mang về.
                    </p>
                    <div class="voucher-code-box">
                        <span class="voucher-code-text">PIZZA50</span>
                        <i class="bi bi-info-circle text-secondary"></i>
                    </div>
                    <button class="voucher-primary-btn">Lưu mã</button>
                </div>
            </div>

            <div class="voucher-card">
                <div class="voucher-card-banner">
                    <img src="~/images/v17_2035.png" alt="Combo pizza tiệc tùng" />
                    <span class="voucher-badge">$10 OFF</span>
                    <div class="voucher-title">Combo pizza tiệc tùng</div>
                </div>
                <div class="voucher-card-body">
                    <div class="voucher-expiry">
                        <i class="bi bi-clock"></i>
                        Hết hạn: 15/12/2026
                    </div>
                    <p class="voucher-desc">
                        Giảm ngay 10$ cho combo party từ 3 bánh trở lên. Rất hợp cho buổi tụ tập cuối tuần.
                    </p>
                    <div class="voucher-code-box">
                        <span class="voucher-code-text">COMBO10</span>
                        <i class="bi bi-info-circle text-secondary"></i>
                    </div>
                    <button class="voucher-primary-btn">Lưu mã</button>
                </div>
            </div>

            <div class="voucher-card">
                <div class="voucher-card-banner">
                    <img src="~/images/v17_2068.png" alt="Miễn phí bánh mì tỏi" />
                    <span class="voucher-badge">FREE SIDE</span>
                    <div class="voucher-title">Miễn phí bánh mì tỏi</div>
                </div>
                <div class="voucher-card-body">
                    <div class="voucher-expiry">
                        <i class="bi bi-clock"></i>
                        Hết hạn: 15/12/2026
                    </div>
                    <p class="voucher-desc">
                        Tặng kèm một phần bánh mì tỏi cho mọi đơn hàng pizza từ 2 bánh trở lên.
                    </p>
                    <div class="voucher-code-box">
                        <span class="voucher-code-text">GARLICFREE</span>
                        <i class="bi bi-check-circle-fill text-warning"></i>
                    </div>
                    <button class="voucher-secondary-btn">Đã nhận mã</button>
                </div>
            </div>

            <div class="voucher-card">
                <div class="voucher-card-banner">
                    <img src="~/images/v17_2101.png" alt="Student Discount" />
                    <span class="voucher-badge">25% OFF</span>
                    <div class="voucher-title">Ưu đãi sinh viên</div>
                </div>
                <div class="voucher-card-body">
                    <div class="voucher-expiry">
                        <i class="bi bi-clock"></i>
                        Hết hạn: 11/12/2026
                    </div>
                    <p class="voucher-desc">
                        Giảm 25% cho sinh viên khi xuất trình thẻ. Áp dụng tối đa 1 đơn/ngày.
                    </p>
                    <div class="voucher-code-box">
                        <span class="voucher-code-text">STUDY25</span>
                        <i class="bi bi-info-circle text-secondary"></i>
                    </div>
                    <button class="voucher-secondary-btn">Hết lượt</button>
                </div>
            </div>

            <div class="voucher-card">
                <div class="voucher-card-banner">
                    <img src="~/images/v17_2134.png" alt="Freeship Extra" />
                    <span class="voucher-badge">FREESHIP</span>
                    <div class="voucher-title">Freeship Extra</div>
                </div>
                <div class="voucher-card-body">
                    <div class="voucher-expiry">
                        <i class="bi bi-clock"></i>
                        Hết hạn: 15/12/2026
                    </div>
                    <p class="voucher-desc">
                        Miễn phí vận chuyển cho đơn hàng từ 200.000đ, tối đa 30.000đ phí giao hàng.
                    </p>
                    <div class="voucher-code-box">
                        <span class="voucher-code-text">DELIVERY0</span>
                        <i class="bi bi-info-circle text-secondary"></i>
                    </div>
                    <button class="voucher-primary-btn">Lưu mã</button>
                </div>
            </div>

            <div class="voucher-empty-card">
                <i class="bi bi-plus-circle mb-2" style="font-size:36px;"></i>
                <h5 class="fw-bold text-dark mb-1">Đang cập nhật thêm!</h5>
                <p class="text-muted mb-0 text-center" style="max-width:260px;">
                    Chúng tôi bổ sung các ưu đãi mới vào mỗi sáng Thứ Ba hàng tuần.
                </p>
            </div>
        </div>

        <div class="voucher-footer-widgets">
            <div class="voucher-widget">
                <div class="voucher-widget-icon">
                    <i class="bi bi-headset"></i>
                </div>
                <div>
                    <p class="voucher-widget-title">Bạn cần hỗ trợ?</p>
                    <p class="voucher-widget-text">Đội ngũ chúng tôi luôn sẵn sàng 24/7.</p>
                    <a href="#" class="voucher-widget-link text-warning">Trò chuyện ngay</a>
                </div>
            </div>

            <div class="voucher-widget">
                <div class="voucher-widget-icon" style="background:#e2e8f0;color:#0f172a;">
                    <i class="bi bi-journal-text"></i>
                </div>
                <div>
                    <p class="voucher-widget-title">Điều khoản áp dụng</p>
                    <p class="voucher-widget-text">Xem quy định sử dụng voucher và giới hạn khuyến mãi.</p>
                    <a href="#" class="voucher-widget-link text-dark">Xem chi tiết</a>
                </div>
            </div>
        </div>

        <div class="voucher-site-footer">
            Đồ án tốt nghiệp LaPizzaria - 2026
        </div>
    </div>
</section>

