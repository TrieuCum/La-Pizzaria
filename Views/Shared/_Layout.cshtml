<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LaPizzaria</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;600;700;900&family=Inter:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Shipper"))
    {
        <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap" rel="stylesheet" />
        <script src="https://cdn.tailwindcss.com"></script>
    }
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LaPizzaria.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <partial name="_SidebarPartial" />

    <div class="content-wrapper">
        <header>
            @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Shipper"))
            {
                @await Html.PartialAsync("~/Views/Shipper/_ShipperTopNav.cshtml")
            }
            else
            {
                <nav class="navbar navbar-expand-lg brand-navbar sticky-top">
                    <div class="container">
                        <a class="navbar-brand d-flex align-items-center me-4" asp-area="" asp-controller="Home" asp-action="Index">
                            <span class="brand-logo-icon me-2">🍕</span>
                            <span class="brand-logo-text">LaPizzaria</span>
                        </a>
                        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                        <div class="collapse navbar-collapse" id="mainNavbar">
                            <ul class="header-center-nav mx-auto mb-2 mb-lg-0">
                                <li><a class="nav-item-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                                <li><a class="nav-item-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Menu" ? "active" : "")" asp-controller="Menu" asp-action="Index">Món ăn</a></li>
                                <li><a class="nav-item-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "VoucherCustomer" ? "active" : "")" asp-controller="VoucherCustomer" asp-action="Index">Khuyến mãi</a></li>
                                <li><a class="nav-item-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Order" ? "active" : "")" asp-controller="Order" asp-action="Index">Đơn hàng của tôi</a></li>
                                <li><a class="nav-item-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Loyalty" ? "active" : "")" asp-controller="Loyalty" asp-action="Index">Tích điểm</a></li>
                            </ul>
                            <div class="d-flex align-items-center gap-3">
                                <form asp-controller="Menu" asp-action="Index" method="get" class="d-none d-xl-flex search-form-nav" role="search">
                                    <div class="search-container-v position-relative" id="navbar-search-wrapper">
                                        <i class="bi bi-search" style="color: #94a3b8;"></i>
                                        <input type="text" name="search" id="navbar-search-input" class="search-input-v" placeholder="Tìm kiếm pizza, món ăn, combo..." value="@Context.Request.Query["search"]" autocomplete="off" aria-label="Tìm kiếm món ăn">
                                        <div id="navbar-search-dropdown" class="navbar-search-dropdown" style="display: none;"></div>
                                    </div>
                                    <button type="submit" class="btn btn-brand-primary ms-2 py-2 px-3 small d-none">Tìm</button>
                                </form>
                                <partial name="_LoginPartial" />
                                <a href="#" style="position: relative; font-size: 22px; color: #4b5563;" data-bs-toggle="offcanvas" data-bs-target="#cartOffcanvas" id="cart-nav-link">
                                    <i class="bi bi-cart3"></i>
                                    <span id="cart-count" class="badge-cart-v" style="display: none; padding-left: 5px;">0</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </nav>
            }
        </header>

        <div class="flex-grow-1">
            <main role="main">
                @RenderBody()
            </main>
        </div>

        @* Global toast container *@
        <div class="position-fixed top-0 end-0 p-3" style="z-index: 1080">
            <div id="toastContainer" class="toast-container"></div>
        </div>

        @* Cart Offcanvas *@
        <div class="offcanvas offcanvas-end" tabindex="-1" id="cartOffcanvas" aria-labelledby="cartOffcanvasLabel">
            <div class="offcanvas-header bg-brand-orange text-white">
                <h5 class="offcanvas-title fw-black" id="cartOffcanvasLabel">Giỏ hàng của bạn</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body d-flex flex-column">
                <div id="cart-items-container" class="flex-grow-1 overflow-auto mb-3">
                    <!-- Cart items will be rendered here -->
                    <div class="text-center py-5">
                        <i class="bi bi-cart-x fs-1 text-brand-gray-light"></i>
                        <p class="text-brand-gray mt-2">Giỏ hàng trống</p>
                    </div>
                </div>
                <div id="cart-summary" class="border-top pt-3" style="display: none;">
                    <div class="voucher-input-group mb-3 position-relative d-flex gap-2">
                        <i class="bi bi-ticket-perforated voucher-icon-abs" id="openGlobalVoucherModal"></i>
                        <input type="text" id="globalVoucherCode" class="form-control extra-small rounded-3 ps-5" placeholder="Mã giảm giá">
                        <button class="btn btn-brand-bg text-brand-dark fw-bold px-3 extra-small" onclick="cart.applyManualVoucher()">Áp dụng</button>
                    </div>
                    <div id="globalAppliedVouchers" class="mb-3 d-flex flex-wrap gap-2"></div>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="small text-brand-gray">Tạm tính:</span>
                        <span id="cart-subtotal" class="small fw-bold">0₫</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 text-success">
                        <span class="small">Giảm giá:</span>
                        <span id="cart-discount" class="small fw-bold">- 0₫</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 border-top pt-2">
                        <span class="fw-bold">Tổng cộng:</span>
                        <span id="cart-total-price" class="fw-black text-brand-orange fs-5">0₫</span>
                    </div>
                    <div class="d-grid gap-2">
                        <a asp-controller="Card" asp-action="Index" class="btn btn-brand-primary py-2 fw-bold">Đặt món ngay</a>
                        <button onclick="cart.clear()" class="btn btn-link text-brand-gray small text-decoration-none">Xóa tất cả</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Global Voucher Selection Modal -->
        <div class="modal fade modal-glass" id="globalVoucherModal" tabindex="-1" style="z-index: 1090;">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg rounded-4">
                    <div class="modal-header border-0 pb-0">
                        <h6 class="modal-title fw-black">Chọn mã giảm giá</h6>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <ul class="nav nav-pills nav-fill mb-3 bg-light p-1 rounded-3" id="globalVoucherTabs">
                            <li class="nav-item">
                                <a class="nav-link active small py-2 fw-bold" data-bs-toggle="pill" href="#gvAvailable">Khả dụng</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link small py-2 fw-bold" data-bs-toggle="pill" href="#gvIneligible">Chưa đủ điều kiện</a>
                            </li>
                        </ul>
                        <div class="tab-content" style="max-height: 400px; overflow-y: auto;">
                            <div class="tab-pane fade show active" id="gvAvailable">
                                <div id="globalListAvailable"></div>
                            </div>
                            <div class="tab-pane fade" id="gvIneligible">
                                <div id="globalListIneligible"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <footer class="brand-footer">
            <div class="container">
                <div class="row g-4 mb-5">
                    <div class="col-lg-4">
                        <div class="d-flex align-items-center mb-3">
                            <span class="brand-logo-icon me-2">🍕</span>
                            <span class="brand-logo-text">LaPizzaria</span>
                        </div>
                        <p class="text-brand-gray small mb-4">
                            Chế biến những chiếc pizza được yêu thích nhất thành phố bằng tình yêu và nguồn nguyên liệu tươi tốt nhất kể từ năm 2025.
                        </p>
                        <div class="d-flex gap-3">
                            <a href="#" class="text-brand-gray fs-5"><i class="bi bi-globe"></i></a>
                            <a href="#" class="text-brand-gray fs-5"><i class="bi bi-envelope"></i></a>
                        </div>
                    </div>
                    <div class="col-md-4 col-lg-2">
                        <div class="footer-heading">Liên kết nhanh</div>
                        <a asp-controller="Card" asp-action="Index" class="footer-link">Đặt hàng ngay</a>
                        <a asp-controller="Menu" asp-action="Index" class="footer-link">Thực đơn của chúng tôi</a>
                        <a asp-controller="VoucherCustomer" asp-action="Index" class="footer-link">Khuyến mãi</a>
                        <a href="#" class="footer-link">Định vị cửa hàng</a>
                    </div>
                    <div class="col-md-4 col-lg-2">
                        <div class="footer-heading">Hỗ trợ</div>
                        <a href="#" class="footer-link">Liên hệ với chúng tôi</a>
                        <a href="#" class="footer-link">Câu hỏi thường gặp</a>
                        <a href="#" class="footer-link">Điều khoản dịch vụ</a>
                        <a href="#" class="footer-link">Chính sách bảo mật</a>
                    </div>
                    <div class="col-md-4 col-lg-4">
                        <div class="footer-heading">Đăng ký nhận bản tin của chúng tôi</div>
                        <p class="text-brand-gray small mb-3">Nhận các ưu đãi và mã giảm giá mới nhất.</p>
                        <div class="d-flex gap-2">
                            <input type="email" class="newsletter-input" placeholder="Email">
                            <button class="btn btn-brand-primary py-2 px-3">Tham gia</button>
                        </div>
                    </div>
                </div>
                <hr class="opacity-10 mb-4">
                <div class="text-center text-brand-gray small pb-3">
                    &copy; 2025 LaPizzaria. Một quyền được bảo lưu. Dự án Đồ nghiệp 2026.
                </div>
            </div>
        </footer>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script>
        (function(){
            // Render TempData as toasts if present
            const success = '@(TempData["success"] ?? string.Empty)';
            const error = '@(TempData["error"] ?? string.Empty)';
            if (success) window.showToast && window.showToast(success, 'success');
            if (error) window.showToast && window.showToast(error, 'error');
        })();

        // Thanh tìm kiếm: gợi ý + dropdown
        (function(){
            var searchInput = document.getElementById('navbar-search-input');
            var dropdown = document.getElementById('navbar-search-dropdown');
            var wrapper = document.getElementById('navbar-search-wrapper');
            if (!searchInput || !dropdown || !wrapper) return;
            var debounceTimer = null;
            function hideDropdown() { dropdown.style.display = 'none'; }
            function showDropdown(html) {
                dropdown.innerHTML = html;
                dropdown.style.display = 'block';
            }
            searchInput.addEventListener('input', function(){
                var q = (this.value || '').trim();
                clearTimeout(debounceTimer);
                if (q.length < 2) { hideDropdown(); return; }
                debounceTimer = setTimeout(function(){
                    fetch('/Menu/SearchSuggestions?q=' + encodeURIComponent(q) + '&limit=6')
                        .then(function(r){ return r.json(); })
                        .then(function(items){
                            if (!items || items.length === 0) {
                                showDropdown('<a href="/Menu?search=' + encodeURIComponent(q) + '" class="search-sugg-all">Xem tất cả kết quả</a>');
                                return;
                            }
                            var html = '';
                            items.forEach(function(item){
                                var url = item.type === 'product' ? '/Menu/ProductDetails/' + item.id : '/Menu/ComboDetails/' + item.id;
                                var img = (item.imageUrl || '/images/v17_1114.png').replace(/^file:\/\/\//, '/images/');
                                var price = item.price != null ? (item.price / 1).toLocaleString('vi-VN') + '₫' : '';
                                html += '<a href="' + url + '"><img src="' + img + '" alt="" onerror="this.src=\'/images/v17_1114.png\'"><span class="search-sugg-name">' + (item.name || '') + '</span><span class="search-sugg-price">' + price + '</span></a>';
                            });
                            html += '<a href="/Menu?search=' + encodeURIComponent(q) + '" class="search-sugg-all">Xem tất cả kết quả</a>';
                            showDropdown(html);
                        })
                        .catch(function(){ hideDropdown(); });
                }, 250);
            });
            searchInput.addEventListener('blur', function(){ setTimeout(hideDropdown, 180); });
            searchInput.addEventListener('focus', function(){
                var q = (this.value || '').trim();
                if (q.length >= 2 && dropdown.innerHTML) dropdown.style.display = 'block';
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
