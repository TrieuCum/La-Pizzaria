@using Microsoft.AspNetCore.Identity
@using LaPizzaria.Models
@using LaPizzaria.ViewModels
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item d-flex align-items-center gap-2">
        @{
            var user = await UserManager.GetUserAsync(User);
        }
        <div class="d-flex align-items-center gap-2">
            @await Html.PartialAsync("_UserAvatar", new UserAvatarViewModel
            {
                AvatarUrl = user?.AvatarUrl,
                FirstName = user?.FirstName,
                LastName = user?.LastName,
                UserName = user?.UserName,
                ElementClass = "nav-user-avatar"
            })
            <a id="manage" class="btn-profile-v" asp-controller="Account" asp-action="Manage" title="Manage">
                <i class="bi bi-person-fill"></i>
                Hồ sơ
            </a>
        </div>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link" id="register" asp-controller="Account" asp-action="Register">Register</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" id="login" asp-controller="Account" asp-action="Login">Login</a>
    </li>
}
</ul>
