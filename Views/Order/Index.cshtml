@model IEnumerable<LaPizzaria.Models.Order>

@{
    ViewData["Title"] = "Lịch sử đơn hàng";
    var allCount = Model?.Count() ?? 0;
    var deliveringCount = Model?.Count(o => o.OrderStatus != "Completed" && o.OrderStatus != "Cancelled") ?? 0;
    var completedCount = Model?.Count(o => o.OrderStatus == "Completed") ?? 0;
    var cancelledCount = Model?.Count(o => o.OrderStatus == "Cancelled") ?? 0;
}

@section Styles {
    <link rel="stylesheet" href="~/css/order-history.css" asp-append-version="true" />
}

<div class="lp-orders-page">
    <div class="container lp-orders-wrap">
        <div class="lp-orders-head">
            <h1>Lịch sử Đơn hàng</h1>
            <p>Theo dõi và quản lý tất cả đơn hàng pizza của bạn tại đây.</p>
        </div>

        <ul class="lp-tabs">
            <li><a class="is-active" href="#">Tất cả (@allCount)</a></li>
            <li><a href="#">Đang giao (@deliveringCount)</a></li>
            <li><a href="#">Hoàn thành (@completedCount)</a></li>
            <li><a href="#">Đã hủy (@cancelledCount)</a></li>
        </ul>

        <div class="lp-order-list">
            @if (Model != null && Model.Any())
            {
                foreach (var o in Model.OrderByDescending(x => x.OrderDate))
                {
                    var pillClass = o.OrderStatus switch
                    {
                        "Completed" => "completed",
                        "Cancelled" => "cancelled",
                        _ => "pending"
                    };
                    var statusText = o.OrderStatus switch
                    {
                        "Completed" => "Hoàn thành",
                        "Cancelled" => "Đã hủy",
                        _ => "Đang xử lý"
                    };
                    var itemsCount = o.OrderDetails?.Sum(d => d.Quantity) ?? 0;

                    <div class="lp-order-card">
                        <div class="lp-order-inner">
                            <div>
                                <div class="lp-status-row">
                                    <span class="lp-pill @pillClass">@statusText</span>
                                    <span class="lp-order-code">#PZ-@o.Id</span>
                                </div>
                                <div class="lp-order-title">
                                    Đơn hàng (@itemsCount món)
                                </div>
                                <div class="lp-meta">
                                    <span class="item">
                                        <i class="bi bi-clock"></i>
                                        @o.OrderDate.ToLocalTime().ToString("HH:mm - dd/MM/yyyy")
                                    </span>
                                    <span class="item">
                                        <i class="bi bi-currency-dollar"></i>
                                        @o.TotalPrice.ToString("N0")đ
                                    </span>
                                </div>
                            </div>

                            <div class="d-flex gap-3 align-items-center justify-content-end flex-wrap">
                                <div class="lp-thumb" title="Pizza">
                                    <i class="bi bi-pie-chart-fill"></i>
                                </div>
                                <div class="lp-actions-col">
                                    <a class="lp-btn primary" asp-action="SplitForm" asp-route-orderId="@o.Id">
                                        <i class="bi bi-eye"></i>
                                        Xem chi tiết
                                    </a>

                                    @if (o.OrderStatus != "Completed" && o.OrderStatus != "Cancelled")
                                    {
                                        <form asp-action="Pay" method="post" class="d-inline">
                                            <input type="hidden" name="orderId" value="@o.Id" />
                                            <button class="lp-btn secondary" type="submit">
                                                <i class="bi bi-cash-coin"></i>
                                                Thanh toán
                                            </button>
                                        </form>
                                    }

                                    <form asp-action="Recalculate" method="post" class="d-inline">
                                        <input type="hidden" name="orderId" value="@o.Id" />
                                        <button class="lp-btn icon" type="submit" title="Tính lại tổng tiền">
                                            <i class="bi bi-calculator"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="lp-order-card">
                    <div class="lp-order-inner">
                        <div>
                            <div class="lp-order-title">Chưa có đơn hàng</div>
                            <div class="lp-meta">Bạn chưa có đơn nào để hiển thị.</div>
                        </div>
                        <div class="lp-actions-col">
                            <a class="lp-btn primary" asp-controller="Menu" asp-action="Index">
                                <i class="bi bi-bag"></i>
                                Đặt món ngay
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
