@using LaPizzaria.Models
@model List<(ApplicationUser User, string Role)>
@{
    ViewData["Title"] = "Quản lý nhân viên";
}

<div class="employee-management-page">
    <!-- Page Header -->
    <div class="page-header-section">
        <div>
            <h1 class="page-title">Quản lý nhân viên</h1>
            <p class="page-subtitle">Quản lý thông tin và quyền hạn nhân viên</p>
        </div>
        <button class="btn-add-employee" type="button" data-bs-toggle="modal" data-bs-target="#addEmployeeModal">
            <i class="bi bi-plus-circle"></i>
            Thêm nhân viên
        </button>
    </div>

    <!-- Employee Table -->
    <div class="employee-table-container">
        <table class="employee-table">
            <thead>
                <tr>
                    <th>Nhân viên</th>
                    <th>Email</th>
                    <th>Chức vụ</th>
                    <th>Số điện thoại</th>
                    <th>Trạng thái</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="employee-info">
                                @await Html.PartialAsync("_UserAvatar", new LaPizzaria.ViewModels.UserAvatarViewModel
                                {
                                    AvatarUrl = item.User.AvatarUrl,
                                    FirstName = item.User.FirstName,
                                    LastName = item.User.LastName,
                                    UserName = item.User.UserName,
                                    ElementClass = "employee-avatar"
                                })
                                <div>
                                    <div class="employee-name">@item.User.FirstName @item.User.LastName</div>
                                    <div class="employee-id">ID: @item.User.Id.Substring(0, 8)</div>
                                </div>
                            </div>
                        </td>
                        <td class="employee-email">@item.User.Email</td>
                        <td>
                            <span class="role-badge role-@item.Role.ToLower()">@item.Role</span>
                        </td>
                        <td class="employee-phone">@(item.User.PhoneNumber ?? "Chưa cập nhật")</td>
                        <td>
                            @if (item.User.IsActive)
                            {
                                <span class="status-badge status-active">
                                    <span class="status-dot"></span>
                                    Đang làm việc
                                </span>
                            }
                            else
                            {
                                <span class="status-badge status-inactive">
                                    <span class="status-dot"></span>
                                    Nghỉ phép
                                </span>
                            }
                        </td>
                        <td>
                            <div class="action-buttons">
                                <button class="action-btn btn-edit"
                                        title="Chỉnh sửa"
                                        onclick="openEditModal('@item.User.Id')">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <form asp-controller="Employee" asp-action="Deactivate" method="post" style="display:inline"
                                      onsubmit="return confirm('@(item.User.IsActive ? "Vô hiệu hóa tài khoản nhân viên này?" : "Kích hoạt lại tài khoản nhân viên này?")')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.User.Id" />
                                    <button type="submit"
                                            class="action-btn @(item.User.IsActive ? "btn-deactivate" : "btn-activate")"
                                            title="@(item.User.IsActive ? "Vô hiệu hóa" : "Kích hoạt lại")">
                                        <i class="bi @(item.User.IsActive ? "bi-person-dash" : "bi-person-check")"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Thêm nhân viên -->
<div class="modal fade" id="addEmployeeModal" tabindex="-1" aria-labelledby="addEmployeeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <form asp-controller="Employee" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="addEmployeeModalLabel">Thêm nhân viên mới</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Họ và tên</label>
                            <input name="fullName" class="form-control" placeholder="Nguyễn Văn A" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Email</label>
                            <input name="email" type="email" class="form-control" placeholder="email@lapizzaria.com" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Số điện thoại</label>
                            <input name="phoneNumber" class="form-control" placeholder="Số điện thoại" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Ngày sinh</label>
                            <input name="birthday" type="date" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Giới tính</label>
                            <select name="gender" class="form-select">
                                <option value="">Không xác định</option>
                                <option value="Nam">Nam</option>
                                <option value="Nữ">Nữ</option>
                                <option value="Khác">Khác</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Vai trò</label>
                            <select name="role" class="form-select" required>
                                <option value="">-- Chọn vai trò --</option>
                                <option value="Staff">Nhân viên</option>
                                <option value="Shipper">Shipper</option>
                                <option value="Admin">Quản trị viên</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Địa chỉ</label>
                            <textarea name="address" rows="2" class="form-control" placeholder="Địa chỉ nhân viên"></textarea>
                        </div>
                        <div class="col-12">
                            <small class="text-muted">
                                Mật khẩu mặc định cho nhân viên mới là <strong>Employee@123</strong>. Vui lòng hướng dẫn nhân viên đổi mật khẩu sau khi đăng nhập.
                            </small>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary">Lưu nhân viên</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Chỉnh sửa nhân viên -->
<div class="modal fade" id="editEmployeeModal" tabindex="-1" aria-labelledby="editEmployeeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <form asp-controller="Employee" asp-action="Edit" method="post" id="editEmployeeForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="editUserId" />
                <div class="modal-header">
                    <h5 class="modal-title" id="editEmployeeModalLabel">Chỉnh sửa nhân viên</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Họ và tên</label>
                            <input name="fullName" id="editFullName" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Email <small class="text-muted">(không thể đổi)</small></label>
                            <input id="editEmailDisplay" class="form-control" disabled />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Số điện thoại</label>
                            <input name="phoneNumber" id="editPhoneNumber" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Ngày sinh</label>
                            <input name="birthday" id="editBirthday" type="date" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Giới tính</label>
                            <select name="gender" id="editGender" class="form-select">
                                <option value="">Không xác định</option>
                                <option value="Nam">Nam</option>
                                <option value="Nữ">Nữ</option>
                                <option value="Khác">Khác</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Vai trò</label>
                            <select name="role" id="editRole" class="form-select" required>
                                <option value="Staff">Nhân viên</option>
                                <option value="Shipper">Shipper</option>
                                <option value="Admin">Quản trị viên</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Trạng thái</label>
                            <select name="isActive" id="editIsActive" class="form-select">
                                <option value="true">Đang làm việc</option>
                                <option value="false">Vô hiệu hóa</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Địa chỉ</label>
                            <textarea name="address" id="editAddress" rows="2" class="form-control"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    async function openEditModal(userId) {
        try {
            const res = await fetch(`/Employee/GetEditData?id=${userId}`);
            if (!res.ok) { alert('Không tải được thông tin nhân viên.'); return; }
            const d = await res.json();
            document.getElementById('editUserId').value = d.id;
            document.getElementById('editFullName').value = d.fullName || '';
            document.getElementById('editEmailDisplay').value = d.email || '';
            document.getElementById('editPhoneNumber').value = d.phoneNumber || '';
            document.getElementById('editBirthday').value = d.birthday || '';
            document.getElementById('editGender').value = d.gender || '';
            document.getElementById('editRole').value = d.role || 'Staff';
            document.getElementById('editIsActive').value = d.isActive ? 'true' : 'false';
            document.getElementById('editAddress').value = d.address || '';
            new bootstrap.Modal(document.getElementById('editEmployeeModal')).show();
        } catch (e) {
            alert('Lỗi kết nối khi tải thông tin nhân viên.');
        }
    }
</script>

<style>
.employee-management-page {
    padding: 32px;
    max-width: 1400px;
    margin: 0 auto;
}

.page-header-section {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 32px;
}

.page-title {
    font-size: 28px;
    font-weight: 700;
    color: var(--brand-dark);
    margin: 0;
}

.page-subtitle {
    color: var(--brand-gray);
    margin: 4px 0 0;
}

.btn-add-employee {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--brand-orange);
    color: white;
    border: none;
    padding: 12px 24px;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
}

.btn-add-employee:hover {
    background: var(--brand-orange-hover);
    transform: translateY(-2px);
}

.employee-table-container {
    background: white;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    overflow: hidden;
}

.employee-table {
    width: 100%;
    border-collapse: collapse;
}

.employee-table thead {
    background: #F8F7F5;
}

.employee-table th {
    padding: 16px 20px;
    text-align: left;
    font-size: 13px;
    font-weight: 600;
    color: var(--brand-gray);
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.employee-table td {
    padding: 16px 20px;
    border-top: 1px solid #F0F0F0;
}

.employee-info {
    display: flex;
    align-items: center;
    gap: 12px;
}

.employee-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
}

.employee-name {
    font-weight: 600;
    color: var(--brand-dark);
}

.employee-id {
    font-size: 12px;
    color: var(--brand-gray-light);
    margin-top: 2px;
}

.employee-email, .employee-phone {
    color: var(--brand-gray);
    font-size: 14px;
}

.role-badge {
    display: inline-block;
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 500;
}

.role-admin {
    background: #FEE2E2;
    color: #DC2626;
}

.role-khách {
    background: #E0E7FF;
    color: #4F46E5;
}

.status-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 500;
}

.status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
}

.status-active {
    color: #10B981;
}

.status-active .status-dot {
    background: #10B981;
}

.status-inactive {
    color: #9CA3AF;
}

.status-inactive .status-dot {
    background: #9CA3AF;
}

.action-buttons {
    display: flex;
    gap: 8px;
}

.action-btn {
    width: 32px;
    height: 32px;
    border: none;
    background: #F8F7F5;
    color: var(--brand-gray);
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
}

.action-btn:hover {
    background: var(--brand-orange);
    color: white;
}

.btn-deactivate:hover {
    background: #dc2626 !important;
    color: white !important;
}

.btn-activate:hover {
    background: #10b981 !important;
    color: white !important;
}

@@media (max-width: 768px) {
    .employee-management-page {
        padding: 16px;
    }
    
    .page-header-section {
        flex-direction: column;
        align-items: flex-start;
        gap: 16px;
    }
    
    .employee-table-container {
        overflow-x: auto;
    }
}
</style>
