@model LaPizzaria.ViewModels.ShipperWithdrawViewModel
@{
    Layout = null;
    string FormatCurrency(decimal amount) => $"{amount:N0}đ";
    var isSuccess = TempData["WithdrawSuccess"] as string == "1";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Rút tiền shipper</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { font-family: 'Work Sans', sans-serif; }
    </style>
</head>
<body class="bg-[#f8f7f5]">
    @await Html.PartialAsync("_ShipperTopNav")
    <main class="mx-auto max-w-3xl px-4 py-6 md:px-8">
        <div class="mb-5 flex items-center justify-between">
            <div>
                <h1 class="text-3xl font-black text-[#181411]">Rút tiền</h1>
                <p class="text-sm text-[#8a7560]">Xác nhận tài khoản nhận tiền và thực hiện rút tiền.</p>
            </div>
            <a asp-controller="Shipper" asp-action="Income" class="rounded-lg border border-[#e6e0db] bg-white px-4 py-2 text-sm font-semibold text-black hover:border-primary hover:bg-primary hover:text-white">Quay lại</a>
        </div>

        <section class="rounded-xl border border-[#e6e0db] bg-white p-6 shadow-sm">
            <div class="mb-4 rounded-lg bg-[#fff7f1] p-4">
                <p class="text-sm text-[#8a7560]">Số dư khả dụng</p>
                <p class="text-3xl font-bold text-primary">@FormatCurrency(Model.AvailableAmount)</p>
            </div>
            <div class="grid gap-3">
                <div>
                    <p class="text-xs font-semibold uppercase text-[#8a7560]">Chủ tài khoản</p>
                    <p class="text-base font-semibold text-[#181411]">@Model.AccountName</p>
                </div>
                <div>
                    <p class="text-xs font-semibold uppercase text-[#8a7560]">Ngân hàng</p>
                    <p class="text-base font-semibold text-[#181411]">@Model.BankName</p>
                </div>
                <div>
                    <p class="text-xs font-semibold uppercase text-[#8a7560]">Số tài khoản</p>
                    <p class="text-base font-semibold text-[#181411]">@Model.BankAccountNumber</p>
                </div>
            </div>

            <div class="mt-6">
                <button id="confirmButton" type="button" class="rounded-lg bg-primary px-5 py-2.5 text-sm font-bold text-white hover:bg-[#d57414]">
                    Xác nhận rút tiền
                </button>
            </div>
        </section>
    </main>

    <div id="confirmModal" class="fixed inset-0 z-[2000] hidden items-center justify-center bg-black/40 p-4">
        <div class="w-full max-w-md rounded-xl bg-white p-6 shadow-lg">
            <h3 class="text-xl font-bold text-[#181411]">Xác nhận thông tin rút tiền</h3>
            <p class="mt-2 text-sm text-[#8a7560]">Bạn xác nhận rút <strong>@FormatCurrency(Model.AvailableAmount)</strong> về tài khoản <strong>@Model.BankAccountNumber</strong> - <strong>@Model.BankName</strong>?</p>
            <div class="mt-5 flex justify-end gap-2">
                <button id="cancelButton" type="button" class="rounded-lg border border-[#e6e0db] bg-white px-4 py-2 text-sm font-semibold text-black hover:border-primary hover:bg-primary hover:text-white">Hủy</button>
                <form asp-controller="Shipper" asp-action="WithdrawConfirm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-white">Xác nhận</button>
                </form>
            </div>
        </div>
    </div>

    @if (isSuccess)
    {
        <div id="successModal" class="fixed inset-0 z-[2001] flex items-center justify-center bg-black/40 p-4">
            <div class="w-full max-w-sm rounded-xl bg-white p-6 text-center shadow-lg">
                <p class="text-lg font-bold text-[#181411]">Rút tiền thành công</p>
                <p class="mt-2 text-sm text-[#8a7560]">Yêu cầu của bạn đã được ghi nhận.</p>
                <button id="closeSuccessButton" type="button" class="mt-5 rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-white">Đóng</button>
            </div>
        </div>
    }

    <script>
        const confirmButton = document.getElementById("confirmButton");
        const cancelButton = document.getElementById("cancelButton");
        const confirmModal = document.getElementById("confirmModal");
        const successModal = document.getElementById("successModal");
        const closeSuccessButton = document.getElementById("closeSuccessButton");

        if (confirmButton && confirmModal) {
            confirmButton.addEventListener("click", () => confirmModal.classList.remove("hidden"));
            cancelButton?.addEventListener("click", () => confirmModal.classList.add("hidden"));
            confirmModal.addEventListener("click", (e) => {
                if (e.target === confirmModal) confirmModal.classList.add("hidden");
            });
        }

        if (successModal && closeSuccessButton) {
            closeSuccessButton.addEventListener("click", () => successModal.remove());
            successModal.addEventListener("click", (e) => {
                if (e.target === successModal) successModal.remove();
            });
        }
    </script>
</body>
</html>
