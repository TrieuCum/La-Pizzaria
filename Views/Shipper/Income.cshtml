@{
    Layout = "_Layout";
    ViewData["Title"] = "Dashboard Thu nhập";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        primary: "#f48c25",
                        "background-light": "#f8f7f5",
                        "background-dark": "#221910",
                    },
                    fontFamily: {
                        display: ["Work Sans", "sans-serif"],
                    },
                    borderRadius: { DEFAULT: "0.25rem", lg: "0.5rem", xl: "0.75rem", "2xl": "1rem", full: "9999px" },
                },
            },
        };
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: "FILL" 0, "wght" 400, "GRAD" 0, "opsz" 24;
        }
        .income-page ::-webkit-scrollbar { width: 8px; height: 8px; }
        .income-page ::-webkit-scrollbar-track { background: transparent; }
        .income-page ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        .income-page ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
    </style>
}

<div class="income-page bg-background-light font-display text-[#181411] dark:bg-background-dark dark:text-white">
    <div class="mx-auto flex max-w-6xl flex-col gap-8 px-4 py-6 md:px-8">
        <!-- Page heading & actions -->
        <div class="flex flex-col justify-between gap-4 md:flex-row md:items-end">
            <div class="flex flex-col gap-1">
                <h1 class="text-3xl font-black leading-tight tracking-tight text-[#181411] dark:text-white md:text-4xl">Dashboard Thu nhập</h1>
                <p class="text-base font-normal text-[#8a7560] dark:text-[#b09b85]">Quản lý doanh thu và rút tiền nhanh chóng</p>
            </div>
            <div class="flex flex-wrap gap-3">
                <button type="button" class="flex h-10 items-center justify-center rounded-lg border border-[#e6e0db] bg-white px-4 text-sm font-bold text-[#181411] shadow-sm transition-colors hover:bg-gray-50 dark:border-[#3d3126] dark:bg-surface-dark dark:text-white dark:hover:bg-[#362b22]">
                    <span class="material-symbols-outlined mr-2 text-lg">calendar_today</span>
                    Tháng này
                </button>
                <button type="button" class="flex h-10 items-center justify-center rounded-lg bg-primary px-6 text-sm font-bold text-white shadow-md transition-colors hover:bg-[#e07b1a]">
                    <span class="material-symbols-outlined mr-2 text-lg">payments</span>
                    Rút tiền ngay
                </button>
            </div>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4">
            <div class="flex flex-col gap-2 rounded-xl border border-[#e6e0db] bg-white p-5 shadow-sm transition-shadow hover:shadow-md dark:border-[#3d3126] dark:bg-[#2c2219]">
                <div class="flex items-center justify-between">
                    <p class="text-sm font-medium uppercase tracking-wider text-[#8a7560] dark:text-[#b09b85]">Hôm nay</p>
                    <span class="material-symbols-outlined rounded-md bg-primary/10 p-1 text-primary">today</span>
                </div>
                <p class="text-3xl font-bold leading-tight text-[#181411] dark:text-white">550.000đ</p>
                <div class="flex w-fit items-center gap-1 rounded-full bg-green-50 px-2 py-0.5 text-sm font-medium text-[#07880e] dark:bg-green-900/30 dark:text-green-400">
                    <span class="material-symbols-outlined text-base">trending_up</span>
                    <span>+12% vs hôm qua</span>
                </div>
            </div>
            <div class="flex flex-col gap-2 rounded-xl border border-[#e6e0db] bg-white p-5 shadow-sm transition-shadow hover:shadow-md dark:border-[#3d3126] dark:bg-[#2c2219]">
                <div class="flex items-center justify-between">
                    <p class="text-sm font-medium uppercase tracking-wider text-[#8a7560] dark:text-[#b09b85]">Tuần này</p>
                    <span class="material-symbols-outlined rounded-md bg-primary/10 p-1 text-primary">date_range</span>
                </div>
                <p class="text-3xl font-bold leading-tight text-[#181411] dark:text-white">3.200.000đ</p>
                <div class="flex w-fit items-center gap-1 rounded-full bg-green-50 px-2 py-0.5 text-sm font-medium text-[#07880e] dark:bg-green-900/30 dark:text-green-400">
                    <span class="material-symbols-outlined text-base">trending_up</span>
                    <span>+5% vs tuần trước</span>
                </div>
            </div>
            <div class="flex flex-col gap-2 rounded-xl border border-[#e6e0db] bg-white p-5 shadow-sm transition-shadow hover:shadow-md dark:border-[#3d3126] dark:bg-[#2c2219]">
                <div class="flex items-center justify-between">
                    <p class="text-sm font-medium uppercase tracking-wider text-[#8a7560] dark:text-[#b09b85]">Tháng này</p>
                    <span class="material-symbols-outlined rounded-md bg-primary/10 p-1 text-primary">calendar_month</span>
                </div>
                <p class="text-3xl font-bold leading-tight text-primary">12.500.000đ</p>
                <div class="flex w-fit items-center gap-1 rounded-full bg-green-50 px-2 py-0.5 text-sm font-medium text-[#07880e] dark:bg-green-900/30 dark:text-green-400">
                    <span class="material-symbols-outlined text-base">trending_up</span>
                    <span>+8% vs tháng trước</span>
                </div>
            </div>
            <div class="flex flex-col gap-2 rounded-xl border border-[#e6e0db] bg-white p-5 shadow-sm transition-shadow hover:shadow-md dark:border-[#3d3126] dark:bg-[#2c2219]">
                <div class="flex items-center justify-between">
                    <p class="text-sm font-medium uppercase tracking-wider text-[#8a7560] dark:text-[#b09b85]">Đơn hoàn thành</p>
                    <span class="material-symbols-outlined rounded-md bg-primary/10 p-1 text-primary">check_circle</span>
                </div>
                <p class="text-3xl font-bold leading-tight text-[#181411] dark:text-white">142</p>
                <p class="text-sm font-medium text-[#8a7560] dark:text-[#b09b85]">đơn hàng tháng này</p>
            </div>
        </div>

        <!-- Chart + table -->
        <div class="flex flex-col gap-6 lg:gap-8">
            <!-- Chart -->
            <div class="rounded-xl border border-[#e6e0db] bg-white p-6 shadow-sm dark:border-[#3d3126] dark:bg-[#2c2219]">
                <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                    <div>
                        <h3 class="text-lg font-bold text-[#181411] dark:text-white">Xu hướng thu nhập</h3>
                        <p class="text-sm text-[#8a7560] dark:text-[#b09b85]">7 ngày gần nhất</p>
                    </div>
                    <div class="text-left sm:text-right">
                        <p class="text-xs font-semibold uppercase text-[#8a7560] dark:text-[#b09b85]">Tổng</p>
                        <p class="text-xl font-bold text-primary">3.200.000đ</p>
                    </div>
                </div>
                <div class="flex h-[250px] w-full items-end justify-between gap-2 border-b border-dashed border-[#e6e0db] pt-4 dark:border-[#3d3126] sm:gap-4">
                    @{
                        var bars = new (string Label, string H, string Tip, bool Highlight)[]
                        {
                            ("T2", "h-[40%]", "450k", false),
                            ("T3", "h-[55%]", "520k", false),
                            ("T4", "h-[35%]", "380k", false),
                            ("T5", "h-[65%]", "610k", false),
                            ("T6", "h-[45%]", "490k", false),
                            ("T7", "h-[85%]", "850k", true),
                            ("CN", "h-[75%]", "720k", false),
                        };
                    }
                    @foreach (var b in bars)
                    {
                        <div class="group flex h-full w-full cursor-pointer flex-col items-center justify-end gap-2">
                            <div class="relative w-full max-w-[40px] rounded-t-sm @(b.Highlight ? "bg-primary shadow-md shadow-primary/20 hover:bg-primary/90" : "bg-primary/20 group-hover:bg-primary/40") @b.H transition-all duration-300">
                                <div class="absolute -top-8 left-1/2 z-10 -translate-x-1/2 whitespace-nowrap rounded bg-gray-800 px-2 py-1 text-xs text-white opacity-0 transition-opacity group-hover:opacity-100">@b.Tip</div>
                            </div>
                            <span class="text-xs font-bold @(b.Highlight ? "text-primary" : "text-[#8a7560]")">@b.Label</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Table -->
            <div class="overflow-hidden rounded-xl border border-[#e6e0db] bg-white shadow-sm dark:border-[#3d3126] dark:bg-[#2c2219]">
                <div class="flex flex-col gap-3 border-b border-[#e6e0db] p-6 sm:flex-row sm:items-center sm:justify-between dark:border-[#3d3126]">
                    <h2 class="text-lg font-bold text-[#181411] dark:text-white">Chi tiết thu nhập đơn hàng</h2>
                    <button type="button" class="self-start text-sm font-bold text-primary hover:underline sm:self-auto">Xem tất cả</button>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full border-collapse text-left">
                        <thead>
                            <tr class="bg-[#f8f7f5] text-xs uppercase tracking-wider text-[#8a7560] dark:bg-[#362b22] dark:text-[#b09b85]">
                                <th class="px-4 py-4 font-semibold md:px-6">Mã đơn</th>
                                <th class="px-4 py-4 font-semibold md:px-6">Thời gian</th>
                                <th class="px-4 py-4 font-semibold md:px-6">Chi tiết</th>
                                <th class="px-4 py-4 text-right font-semibold md:px-6">Thu nhập</th>
                                <th class="px-4 py-4 text-center font-semibold md:px-6">Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-[#f0efeb] dark:divide-[#3d3126]">
                            <tr class="transition-colors hover:bg-gray-50 dark:hover:bg-[#362b22]/50">
                                <td class="px-4 py-4 md:px-6">
                                    <div class="flex items-center gap-3">
                                        <div class="rounded-lg bg-primary/10 p-2 text-primary">
                                            <span class="material-symbols-outlined text-xl">local_pizza</span>
                                        </div>
                                        <span class="font-bold text-[#181411] dark:text-white">#PZ-8842</span>
                                    </div>
                                </td>
                                <td class="px-4 py-4 md:px-6">
                                    <div class="flex flex-col">
                                        <span class="text-sm font-medium text-[#181411] dark:text-white">Hôm nay</span>
                                        <span class="text-xs text-[#8a7560]">14:30</span>
                                    </div>
                                </td>
                                <td class="px-4 py-4 md:px-6">
                                    <div class="flex max-w-[180px] flex-col gap-1">
                                        <div class="flex items-center justify-between text-xs">
                                            <span class="text-[#8a7560]">Phí ship (3.2km):</span>
                                            <span class="font-medium text-[#181411] dark:text-white">25.000đ</span>
                                        </div>
                                        <div class="flex items-center justify-between text-xs">
                                            <span class="text-[#8a7560]">Tiền Tip:</span>
                                            <span class="font-medium text-green-600">+10.000đ</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-4 py-4 text-right md:px-6">
                                    <span class="text-base font-bold text-primary">35.000đ</span>
                                </td>
                                <td class="px-4 py-4 text-center md:px-6">
                                    <span class="inline-flex items-center gap-1 rounded-full bg-green-100 px-2 py-1 text-xs font-semibold text-green-700 dark:bg-green-900/40 dark:text-green-400">
                                        <span class="material-symbols-outlined text-[14px]">check</span>
                                        Đã nhận
                                    </span>
                                </td>
                            </tr>
                            <tr class="transition-colors hover:bg-gray-50 dark:hover:bg-[#362b22]/50">
                                <td class="px-4 py-4 md:px-6">
                                    <div class="flex items-center gap-3">
                                        <div class="rounded-lg bg-primary/10 p-2 text-primary">
                                            <span class="material-symbols-outlined text-xl">local_pizza</span>
                                        </div>
                                        <span class="font-bold text-[#181411] dark:text-white">#PZ-8841</span>
                                    </div>
                                </td>
                                <td class="px-4 py-4 md:px-6">
                                    <div class="flex flex-col">
                                        <span class="text-sm font-medium text-[#181411] dark:text-white">Hôm nay</span>
                                        <span class="text-xs text-[#8a7560]">13:15</span>
                                    </div>
                                </td>
                                <td class="px-4 py-4 md:px-6">
                                    <div class="flex max-w-[180px] flex-col gap-1">
                                        <div class="flex items-center justify-between text-xs">
                                            <span class="text-[#8a7560]">Phí ship (5.0km):</span>
                                            <span class="font-medium text-[#181411] dark:text-white">35.000đ</span>
                                        </div>
                                        <div class="flex items-center justify-between text-xs">
                                            <span class="text-[#8a7560]">Tiền Tip:</span>
                                            <span class="font-medium text-green-600">0đ</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-4 py-4 text-right md:px-6">
                                    <span class="text-base font-bold text-primary">35.000đ</span>
                                </td>
                                <td class="px-4 py-4 text-center md:px-6">
                                    <span class="inline-flex items-center gap-1 rounded-full bg-green-100 px-2 py-1 text-xs font-semibold text-green-700 dark:bg-green-900/40 dark:text-green-400">
                                        <span class="material-symbols-outlined text-[14px]">check</span>
                                        Đã nhận
                                    </span>
                                </td>
                            </tr>
                            <tr class="transition-colors hover:bg-gray-50 dark:hover:bg-[#362b22]/50">
                                <td class="px-4 py-4 md:px-6">
                                    <div class="flex items-center gap-3">
                                        <div class="rounded-lg bg-primary/10 p-2 text-primary">
                                            <span class="material-symbols-outlined text-xl">local_pizza</span>
                                        </div>
                                        <span class="font-bold text-[#181411] dark:text-white">#PZ-8839</span>
                                    </div>
                                </td>
                                <td class="px-4 py-4 md:px-6">
                                    <div class="flex flex-col">
                                        <span class="text-sm font-medium text-[#181411] dark:text-white">Hôm nay</span>
                                        <span class="text-xs text-[#8a7560]">11:05</span>
                                    </div>
                                </td>
                                <td class="px-4 py-4 md:px-6">
                                    <div class="flex max-w-[180px] flex-col gap-1">
                                        <div class="flex items-center justify-between text-xs">
                                            <span class="text-[#8a7560]">Phí ship (1.5km):</span>
                                            <span class="font-medium text-[#181411] dark:text-white">15.000đ</span>
                                        </div>
                                        <div class="flex items-center justify-between text-xs">
                                            <span class="text-[#8a7560]">Tiền Tip:</span>
                                            <span class="font-medium text-green-600">+5.000đ</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-4 py-4 text-right md:px-6">
                                    <span class="text-base font-bold text-primary">20.000đ</span>
                                </td>
                                <td class="px-4 py-4 text-center md:px-6">
                                    <span class="inline-flex items-center gap-1 rounded-full bg-green-100 px-2 py-1 text-xs font-semibold text-green-700 dark:bg-green-900/40 dark:text-green-400">
                                        <span class="material-symbols-outlined text-[14px]">check</span>
                                        Đã nhận
                                    </span>
                                </td>
                            </tr>
                            <tr class="transition-colors hover:bg-gray-50 dark:hover:bg-[#362b22]/50">
                                <td class="px-4 py-4 md:px-6">
                                    <div class="flex items-center gap-3">
                                        <div class="rounded-lg bg-gray-100 p-2 text-gray-400 dark:bg-[#3d3126]">
                                            <span class="material-symbols-outlined text-xl">local_pizza</span>
                                        </div>
                                        <span class="font-bold text-[#181411] dark:text-white">#PZ-8835</span>
                                    </div>
                                </td>
                                <td class="px-4 py-4 md:px-6">
                                    <div class="flex flex-col">
                                        <span class="text-sm font-medium text-[#181411] dark:text-white">Hôm qua</span>
                                        <span class="text-xs text-[#8a7560]">20:45</span>
                                    </div>
                                </td>
                                <td class="px-4 py-4 md:px-6">
                                    <div class="flex max-w-[180px] flex-col gap-1">
                                        <div class="flex items-center justify-between text-xs">
                                            <span class="text-[#8a7560]">Phí ship (6.2km):</span>
                                            <span class="font-medium text-[#181411] dark:text-white">42.000đ</span>
                                        </div>
                                        <div class="flex items-center justify-between text-xs">
                                            <span class="text-[#8a7560]">Tiền Tip:</span>
                                            <span class="font-medium text-green-600">+15.000đ</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-4 py-4 text-right md:px-6">
                                    <span class="text-base font-bold text-primary">57.000đ</span>
                                </td>
                                <td class="px-4 py-4 text-center md:px-6">
                                    <span class="inline-flex items-center gap-1 rounded-full bg-orange-100 px-2 py-1 text-xs font-semibold text-orange-700 dark:bg-orange-900/40 dark:text-orange-300">
                                        <span class="material-symbols-outlined text-[14px]">schedule</span>
                                        Chờ duyệt
                                    </span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
