@model LaPizzaria.ViewModels.ShipperMonthlySummaryViewModel
@{
    Layout = null;
    string FormatCurrency(decimal amount) => $"{amount:N0}đ";
    var marks = new[] { 500000m, 1000000m, 2000000m, 3000000m, 5000000m }
        .Where(x => x <= Model.MaxChartValue)
        .DefaultIfEmpty(500000m)
        .OrderByDescending(x => x)
        .ToList();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tổng kết tiền tháng @Model.Month/@Model.Year</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { font-family: 'Work Sans', sans-serif; }
        .material-symbols-outlined { font-variation-settings: "FILL" 0, "wght" 400, "GRAD" 0, "opsz" 24; }
    </style>
</head>
<body class="bg-[#f8f7f5]">
    @await Html.PartialAsync("_ShipperTopNav")
    <main class="mx-auto max-w-6xl px-4 py-6 md:px-8">
        <div class="mb-5 flex items-center justify-between">
            <div>
                <h1 class="text-3xl font-black text-[#181411]">Tổng kết tiền tháng @Model.Month/@Model.Year</h1>
                <p class="text-sm text-[#8a7560]">Thống kê các đơn hoàn thành và tổng thu nhập theo tháng.</p>
            </div>
            <a asp-controller="Shipper" asp-action="Income" class="rounded-lg border border-[#e6e0db] bg-white px-4 py-2 text-sm font-semibold text-black hover:border-primary hover:bg-primary hover:text-white">Quay lại</a>
        </div>

        <section class="mb-5 grid gap-4 md:grid-cols-2">
            <div class="rounded-xl border border-[#e6e0db] bg-white p-5 shadow-sm">
                <p class="text-sm text-[#8a7560]">Tổng đơn hoàn thành</p>
                <p class="mt-1 text-3xl font-bold text-[#181411]">@Model.TotalOrders</p>
            </div>
            <div class="rounded-xl border border-[#e6e0db] bg-white p-5 shadow-sm">
                <p class="text-sm text-[#8a7560]">Tổng tiền tháng này</p>
                <p class="mt-1 text-3xl font-bold text-primary">@FormatCurrency(Model.TotalIncome)</p>
            </div>
        </section>

        <section class="mb-5 rounded-xl border border-[#e6e0db] bg-white p-6 shadow-sm">
            <h2 class="mb-4 text-lg font-bold text-[#181411]">Sơ đồ thu nhập theo ngày</h2>
            <div class="flex gap-3">
                <div class="flex h-[250px] w-16 flex-col justify-between text-right text-xs font-semibold text-[#8a7560]">
                    @foreach (var mark in marks)
                    {
                        <span>@FormatCurrency(mark)</span>
                    }
                    <span>0đ</span>
                </div>
                <div class="relative flex h-[250px] w-full items-end gap-1 overflow-x-auto border-b border-dashed border-[#e6e0db] pt-4">
                    @foreach (var mark in marks)
                    {
                        var percent = (int)Math.Round((mark / Model.MaxChartValue) * 100m);
                        <div class="pointer-events-none absolute inset-x-0 border-t border-dashed border-[#eee8e3]" style="bottom:@percent%;"></div>
                    }
                    @foreach (var item in Model.DailyChart)
                    {
                        <div class="group relative z-10 flex h-full min-w-6 flex-col items-center justify-end gap-1">
                            <div class="w-5 rounded-t-sm bg-primary/25 transition-all group-hover:bg-primary/55" style="height:@item.HeightPercent%;"></div>
                            <span class="text-[10px] text-[#8a7560]">@item.Label</span>
                        </div>
                    }
                </div>
            </div>
        </section>

        <section class="overflow-hidden rounded-xl border border-[#e6e0db] bg-white shadow-sm">
            <div class="border-b border-[#e6e0db] px-6 py-4">
                <h2 class="text-lg font-bold text-[#181411]">Danh sách đơn đã hoàn thành</h2>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead>
                        <tr class="bg-[#f8f7f5] text-xs uppercase tracking-wide text-[#8a7560]">
                            <th class="px-6 py-3">Mã đơn</th>
                            <th class="px-6 py-3">Thời gian</th>
                            <th class="px-6 py-3 text-right">Thu nhập</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-[#f0efeb]">
                        @foreach (var order in Model.Orders)
                        {
                            <tr class="hover:bg-[#fff7f1]">
                                <td class="px-6 py-3 font-semibold text-[#181411]">#PZ-@order.OrderId</td>
                                <td class="px-6 py-3 text-sm text-[#8a7560]">@order.CompletedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="px-6 py-3 text-right font-bold text-primary">@FormatCurrency(order.TotalIncome)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </main>
</body>
</html>
