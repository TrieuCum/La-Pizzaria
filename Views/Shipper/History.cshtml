@model LaPizzaria.ViewModels.ShipperHistoryViewModel
@{
    Layout = null;
    string StatusClass(string s) => Model.Status == s ? "bg-[#E67E22] text-white" : "bg-white text-gray-700 border border-gray-200";
    string StatusLabel(string s) => s switch
    {
        "All" => "Tất cả",
        "delivered" => "Giao thành công",
        "failed" => "Giao thất bại",
        _ => s
    };
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Shipper - Lịch sử giao hàng</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { font-family: 'Work Sans', sans-serif; }
        .material-symbols-outlined { font-variation-settings: "FILL" 0, "wght" 400, "GRAD" 0, "opsz" 24; }
    </style>
</head>
<body class="bg-[#f8f7f5]">
    @await Html.PartialAsync("_ShipperTopNav")

    <main class="mx-auto max-w-6xl px-4 py-6 md:px-8">
        <div class="mb-5 flex flex-col gap-2">
            <h1 class="text-3xl font-black text-[#181411]">Lịch sử giao hàng</h1>
            <p class="text-gray-500">Lọc theo ngày/trạng thái, xem phân trang và tổng thu nhập theo bộ lọc hiện tại.</p>
        </div>

        <section class="mb-5 grid gap-4 md:grid-cols-3">
            <div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-gray-100">
                <p class="text-sm font-semibold text-gray-500">Tổng đơn theo bộ lọc</p>
                <p class="mt-2 text-3xl font-extrabold text-[#2C3E50]">@Model.TotalCount</p>
            </div>
            <div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-gray-100 md:col-span-2">
                <p class="text-sm font-semibold text-gray-500">Tổng thu nhập (chỉ đơn Completed)</p>
                <p class="mt-2 text-3xl font-extrabold text-[#E67E22]">@Model.TotalIncome.ToString("N0")đ</p>
            </div>
        </section>

        <section class="mb-5 rounded-2xl bg-white p-4 shadow-sm ring-1 ring-gray-100">
            <form method="get" asp-controller="Shipper" asp-action="History" class="grid gap-3 md:grid-cols-4">
                <div>
                    <label class="mb-1 block text-sm font-semibold text-gray-600">Từ ngày</label>
                    <input type="text" name="fromDate" value="@(Model.FromDate?.ToString("dd/MM/yyyy"))" placeholder="dd/MM/yyyy" class="w-full rounded-xl border border-gray-200 px-3 py-2" />
                </div>
                <div>
                    <label class="mb-1 block text-sm font-semibold text-gray-600">Đến ngày</label>
                    <input type="text" name="toDate" value="@(Model.ToDate?.ToString("dd/MM/yyyy"))" placeholder="dd/MM/yyyy" class="w-full rounded-xl border border-gray-200 px-3 py-2" />
                </div>
                <div class="md:col-span-2">
                    <label class="mb-1 block text-sm font-semibold text-gray-600">Trạng thái</label>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var s in new[] { "All", "delivered", "failed" })
                        {
                            <button type="submit" name="status" value="@s" class="rounded-xl px-3 py-2 text-sm font-semibold @StatusClass(s)">@StatusLabel(s)</button>
                        }
                    </div>
                </div>
                <input type="hidden" name="page" value="1" />
            </form>
            @if (ViewData["DateFilterError"] is string dateFilterError && !string.IsNullOrWhiteSpace(dateFilterError))
            {
                <p class="mt-3 text-sm font-semibold text-red-600">@dateFilterError</p>
            }
        </section>

        <section class="space-y-3">
            @if (Model.Orders.Any())
            {
                @foreach (var o in Model.Orders)
                {
                    var isCompleted = o.DeliveryStatus == "delivered";
                    <div class="rounded-2xl bg-white p-4 shadow-sm ring-1 ring-gray-100">
                        <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
                            <div>
                                <p class="text-lg font-bold text-[#2C3E50]">#@o.OrderId - @o.ItemCount x @o.ItemTitle</p>
                                <p class="text-sm text-gray-600">@o.DeliveryAddress</p>
                                <p class="text-xs text-gray-500">Khách: @o.CustomerName @(!string.IsNullOrWhiteSpace(o.CustomerPhone) ? $"| {o.CustomerPhone}" : "")</p>
                            </div>
                            <div class="text-right">
                                <p class="text-xs text-gray-500">@o.OrderDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                                <p class="font-bold @(isCompleted ? "text-[#E67E22]" : "text-gray-500")">@o.TotalPrice.ToString("N0")đ</p>
                                <span class="inline-block rounded-full px-2 py-1 text-xs font-bold @(isCompleted ? "bg-green-100 text-green-700" : "bg-red-100 text-red-700")">@StatusLabel(o.DeliveryStatus)</span>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="rounded-2xl bg-white p-8 text-center text-gray-500 shadow-sm ring-1 ring-gray-100">
                    Không có dữ liệu theo bộ lọc hiện tại.
                </div>
            }
        </section>

        @if (Model.TotalPages > 1)
        {
            <nav class="mt-6 flex items-center justify-center gap-2">
                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <a asp-controller="Shipper" asp-action="History"
                       asp-route-page="@i"
                       asp-route-status="@Model.Status"
                       asp-route-fromDate="@(Model.FromDate?.ToString("dd/MM/yyyy"))"
                       asp-route-toDate="@(Model.ToDate?.ToString("dd/MM/yyyy"))"
                       class="rounded-xl px-3 py-2 text-sm font-semibold @(i == Model.Page ? "bg-[#E67E22] text-white" : "bg-white text-gray-700 ring-1 ring-gray-200")">
                        @i
                    </a>
                }
            </nav>
        }
    </main>
</body>
</html>
