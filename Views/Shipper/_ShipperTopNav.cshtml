@using System.Security.Claims
@{
    var nav = ViewData["ShipperNav"] as string ?? "Index";
    var currentShipperId = User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";
}
<header class="sticky top-0 z-[1000] w-full border-b border-[#ece6e1] bg-white/95 shadow-sm backdrop-blur-md dark:border-[#3d3126] dark:bg-surface-dark/95">
    <div class="mx-auto flex h-[82px] max-w-6xl items-center justify-between gap-3 px-4 md:px-8 lg:px-10">
        <div class="flex min-w-0 items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#fff2e8] text-lg">🍕</div>
            <div class="flex flex-col leading-tight">
                <span class="text-lg font-extrabold tracking-tight text-[#181411] dark:text-black md:text-xl">Lapizzaria</span>
                <span class="text-xs font-semibold uppercase tracking-wide text-primary">Giao hàng</span>
            </div>
        </div>
        <nav class="flex flex-wrap items-center justify-end gap-1.5 sm:gap-2 md:gap-3">
            <a asp-controller="Shipper" asp-action="Index"
               class="group flex items-center gap-2 rounded-xl px-3 py-2 text-sm font-semibold transition-colors md:px-4 md:py-2.5 @(nav == "Index" ? "bg-[#E67E22] text-white ring-1 ring-[#E67E22]/20" : "text-black hover:bg-[#E67E22] hover:text-white")">
                <span class="material-symbols-outlined text-[20px] @(nav == "Index" ? "fill text-white" : "text-black transition-colors group-hover:text-white")">two_wheeler</span>
                <span class="hidden sm:inline">Đơn hiện tại</span>
            </a>
            <a asp-controller="Shipper" asp-action="History"
               class="group flex items-center gap-2 rounded-xl px-3 py-2 text-sm font-semibold transition-colors md:px-4 md:py-2.5 @(nav == "History" ? "bg-[#E67E22] text-white ring-1 ring-[#E67E22]/20" : "text-black hover:bg-[#E67E22] hover:text-white")">
                <span class="material-symbols-outlined text-[20px] @(nav == "History" ? "fill text-white" : "text-black transition-colors group-hover:text-white")">history</span>
                <span class="hidden sm:inline">Lịch sử</span>
            </a>
            <a asp-controller="Shipper" asp-action="Income"
               class="group hidden items-center gap-2 rounded-xl px-3 py-2 text-sm font-semibold transition-colors md:flex md:px-4 md:py-2.5 @(nav == "Income" ? "bg-[#E67E22] text-white ring-1 ring-[#E67E22]/20" : "text-black hover:bg-[#E67E22] hover:text-white")">
                <span class="material-symbols-outlined text-[20px] @(nav == "Income" ? "fill text-white" : "text-black transition-colors group-hover:text-white")">payments</span>
                <span>Thu nhập</span>
            </a>
            <button type="button" class="ml-1 hidden items-center gap-2 rounded-lg bg-[#22b162] px-3 py-2 text-xs font-semibold text-white shadow-sm md:flex md:text-[13px]">
                <span class="h-2 w-2 animate-pulse rounded-full bg-white"></span>
                <span class="hidden sm:inline">Đang làm việc</span>
            </button>
            <div class="ml-1 flex items-center gap-2 border-l border-[#e6e2de] pl-3 dark:border-[#3d3126] md:ml-2 md:pl-4">
                <!-- Notification bell with red badge -->
                <button id="btn-shipper-notif" type="button"
                        class="relative flex h-9 w-9 items-center justify-center rounded-full text-xl text-[#95A5A6] transition hover:bg-[#E67E22] hover:text-white"
                        aria-label="Thông báo">
                    🔔
                    <span id="shipper-notif-badge"
                          class="absolute -right-1 -top-1 hidden min-w-[20px] items-center justify-center rounded-full bg-red-500 px-1 py-0.5 text-[10px] font-extrabold leading-none text-white shadow">
                        0
                    </span>
                </button>
                <a asp-controller="Account" asp-action="Manage" class="group flex items-center gap-2 rounded-xl py-1.5 pl-1 pr-2 text-sm font-semibold transition @(nav == "Profile" ? "bg-[#E67E22] text-white ring-1 ring-[#E67E22]/20" : "text-[#2C3E50] hover:bg-[#E67E22] hover:text-white")">
                    <img src="https://ui-avatars.com/api/?name=Shipper&background=E67E22&color=fff" alt="" class="h-9 w-9 rounded-full border-2 border-[#E67E22] object-cover" width="36" height="36" />
                    <span class="hidden lg:inline">Hồ sơ</span>
                </a>
            </div>
        </nav>
    </div>
</header>

<!-- SignalR client -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<style>
    @@keyframes shipperSlideIn {
        from { transform: translateX(110%); opacity: 0; }
        to   { transform: translateX(0);   opacity: 1; }
    }
    .shipper-toast-enter { animation: shipperSlideIn 0.35s cubic-bezier(.21,1.02,.73,1) forwards; }
    @@keyframes shipperSlideOut {
        to { transform: translateX(110%); opacity: 0; }
    }
    .shipper-toast-exit { animation: shipperSlideOut 0.25s ease-in forwards; }
</style>
<script>
(function () {
    var BADGE_KEY = '_shipperBadge';
    var TOAST_KEY = '_shipperPendingToast';
    var shipperId = '@Html.Raw(currentShipperId)';
    var badge = document.getElementById('shipper-notif-badge');

    // ── Badge (persisted across page reloads via sessionStorage) ──────────
    var notifCount = 0;
    try { notifCount = parseInt(sessionStorage.getItem(BADGE_KEY) || '0', 10) || 0; } catch (e) {}

    function renderBadge() {
        if (!badge) return;
        if (notifCount <= 0) {
            badge.classList.add('hidden'); badge.classList.remove('flex');
        } else {
            badge.classList.remove('hidden'); badge.classList.add('flex');
            badge.textContent = notifCount > 9 ? '9+' : String(notifCount);
        }
    }
    renderBadge(); // restore badge after page reload

    function bumpBadge() {
        notifCount++;
        try { sessionStorage.setItem(BADGE_KEY, String(notifCount)); } catch (e) {}
        renderBadge();
    }

    var bellBtn = document.getElementById('btn-shipper-notif');
    if (bellBtn) {
        bellBtn.addEventListener('click', function () {
            notifCount = 0;
            try { sessionStorage.removeItem(BADGE_KEY); } catch (e) {}
            renderBadge();
        });
    }

    // ── Toast ──────────────────────────────────────────────────────────────
    function showShipperToast(orderId, address, totalPrice) {
        var container = document.getElementById('shipper-toast-container');
        if (!container) {
            container = document.createElement('div');
            container.id = 'shipper-toast-container';
            container.style.cssText = 'position:fixed;bottom:20px;right:20px;z-index:9999;display:flex;flex-direction:column;gap:10px;max-width:340px;pointer-events:none;';
            document.body.appendChild(container);
        }
        var toast = document.createElement('div');
        toast.className = 'shipper-toast-enter';
        toast.style.cssText = 'background:linear-gradient(135deg,#E67E22,#d35400);color:#fff;padding:14px 18px;border-radius:18px;box-shadow:0 8px 32px rgba(214,84,0,.35);cursor:pointer;font-family:inherit;pointer-events:all;';
        toast.innerHTML =
            '<div style="display:flex;align-items:center;gap:10px;">' +
            '  <span style="font-size:26px;line-height:1;">🍕</span>' +
            '  <div style="flex:1;min-width:0;">' +
            '    <div style="font-size:13px;font-weight:800;letter-spacing:.3px;">Đơn mới #' + orderId + ' được gán cho bạn!</div>' +
            '    <div style="font-size:11.5px;opacity:.88;margin-top:3px;word-break:break-word;">' + address + '</div>' +
            '    <div style="font-size:12px;font-weight:700;margin-top:5px;">' + Number(totalPrice).toLocaleString('vi-VN') + 'đ</div>' +
            '    <div style="font-size:10.5px;opacity:.7;margin-top:6px;">Nhấn để đóng</div>' +
            '  </div>' +
            '</div>';
        container.appendChild(toast);
        toast.addEventListener('click', function () { dismissToast(toast); });
        // Auto-dismiss after 12 s so there's plenty of time to read
        setTimeout(function () { if (toast.parentNode) dismissToast(toast); }, 12000);
    }

    function dismissToast(el) {
        el.classList.remove('shipper-toast-enter');
        el.classList.add('shipper-toast-exit');
        setTimeout(function () { if (el.parentNode) el.remove(); }, 260);
    }

    // ── On page load: check for a toast queued before the last reload ──────
    document.addEventListener('DOMContentLoaded', function () {
        try {
            var raw = sessionStorage.getItem(TOAST_KEY);
            if (raw) {
                sessionStorage.removeItem(TOAST_KEY);
                var data = JSON.parse(raw);
                // Small delay so the page finishes rendering before the toast appears
                setTimeout(function () {
                    showShipperToast(data.orderId, data.deliveryAddress, data.totalPrice);
                }, 500);
            }
        } catch (e) {}
    });

    if (!shipperId) return; // don't start SignalR for unauthenticated views

    // ── SignalR ────────────────────────────────────────────────────────────
    var connection = new signalR.HubConnectionBuilder()
        .withUrl('/hub/ordering')
        .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
        .build();

    connection.on('newOrderAssigned', function (data) {
        bumpBadge();
        // Save toast data to sessionStorage BEFORE reloading so it survives the page reload
        try { sessionStorage.setItem(TOAST_KEY, JSON.stringify(data)); } catch (e) {}
        // Reload immediately so the new order appears in the active order panel
        setTimeout(function () { window.location.reload(); }, 300);
    });

    connection.start()
        .then(function () { return connection.invoke('JoinShipperGroup', shipperId); })
        .catch(function (err) { console.warn('[SignalR] Shipper connection failed:', err); });
}());
</script>
