@model LaPizzaria.ViewModels.ShipperOrderDetailViewModel
@{
    Layout = null;
    var mapQuery = Uri.EscapeDataString(Model.DeliveryAddress);
    var mapUrl = $"https://www.google.com/maps?q={mapQuery}&output=embed";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Shipper - Chi tiết đơn #@Model.OrderId</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { font-family: 'Work Sans', sans-serif; }
        .material-symbols-outlined { font-variation-settings: "FILL" 0, "wght" 400, "GRAD" 0, "opsz" 24; }
    </style>
</head>
<body class="bg-[#f8f7f5]">
    @await Html.PartialAsync("_ShipperTopNav")
    <main class="mx-auto grid max-w-6xl gap-4 px-4 py-6 md:grid-cols-5 md:px-8">
        <section class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-gray-100 md:col-span-3">
            <div class="mb-4 flex items-start justify-between">
                <div>
                    <p class="text-xs font-bold text-orange-700">MÃ ĐƠN #@Model.OrderId</p>
                    <h1 class="text-2xl font-extrabold text-[#2C3E50]">Chi tiết đơn hàng</h1>
                    <p class="text-sm text-gray-500">@Model.OrderDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                </div>
                <span class="rounded-full bg-orange-100 px-3 py-1 text-xs font-bold text-orange-700">@Model.OrderStatus</span>
            </div>

            <div class="mb-4 grid gap-3 rounded-xl bg-gray-50 p-4 md:grid-cols-2">
                <div>
                    <p class="text-xs font-bold uppercase text-gray-400">Khách hàng</p>
                    <p class="font-semibold text-[#2C3E50]">@Model.CustomerName</p>
                    <p class="text-sm text-gray-600">@Model.CustomerPhone</p>
                </div>
                <div>
                    <p class="text-xs font-bold uppercase text-gray-400">Địa chỉ giao</p>
                    <p class="font-semibold text-[#2C3E50]">@Model.DeliveryAddress</p>
                </div>
                <div>
                    <p class="text-xs font-bold uppercase text-gray-400">Thanh toán</p>
                    <p class="font-semibold text-[#2C3E50]">@(string.IsNullOrWhiteSpace(Model.PaymentMethod) ? "Chưa cập nhật" : Model.PaymentMethod)</p>
                </div>
                <div>
                    <p class="text-xs font-bold uppercase text-gray-400">Ghi chú</p>
                    <p class="font-semibold text-[#2C3E50]">@(string.IsNullOrWhiteSpace(Model.Note) ? "Không có" : Model.Note)</p>
                </div>
            </div>

            <h2 class="mb-2 text-lg font-extrabold text-[#2C3E50]">Danh sách món</h2>
            <div class="space-y-2">
                @foreach (var item in Model.Items)
                {
                    <div class="flex items-center justify-between rounded-xl border border-gray-100 p-3">
                        <div>
                            <p class="font-semibold text-[#2C3E50]">@item.Quantity x @item.ProductName @(string.IsNullOrWhiteSpace(item.Size) ? "" : $"(Size {item.Size})")</p>
                            <p class="text-xs text-gray-500">Đơn giá: @item.UnitPrice.ToString("N0")đ</p>
                        </div>
                        <p class="font-bold text-[#E67E22]">@item.Subtotal.ToString("N0")đ</p>
                    </div>
                }
            </div>

            <div class="mt-4 flex items-center justify-between border-t pt-3">
                <p class="font-semibold text-gray-500">Tổng tiền</p>
                <p class="text-2xl font-extrabold text-[#E67E22]">@Model.TotalPrice.ToString("N0")đ</p>
            </div>
        </section>

        <section class="space-y-4 md:col-span-2">
            <div class="overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-gray-100">
                <iframe src="@mapUrl" width="100%" height="260" style="border:0;" loading="lazy"></iframe>
            </div>

            <div class="rounded-2xl bg-white p-4 shadow-sm ring-1 ring-gray-100">
                @if (TempData["error"] != null)
                {
                    <div class="mb-3 rounded-xl border border-red-200 bg-red-50 px-3 py-2 text-sm font-semibold text-red-700">@TempData["error"]</div>
                }
                @if (TempData["success"] != null)
                {
                    <div class="mb-3 rounded-xl border border-green-200 bg-green-50 px-3 py-2 text-sm font-semibold text-green-700">@TempData["success"]</div>
                }
                <a asp-controller="Shipper" asp-action="Index" class="mb-3 inline-flex w-full items-center justify-center rounded-xl border border-gray-200 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50">Quay về trang chủ</a>

                @if (Model.OrderStatus is "Preparing" or "Ready" or "Đang chế biến" or "Sẵn sàng")
                {
                    <form asp-controller="Shipper" asp-action="Accept" asp-route-id="@Model.OrderId" method="post" class="mb-2">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="w-full rounded-xl bg-[#E67E22] px-4 py-3 text-sm font-semibold text-white hover:opacity-90">Nhận đơn và bắt đầu giao</button>
                    </form>
                }

                @if (Model.OrderStatus == "Delivering")
                {
                    <form asp-controller="Shipper" asp-action="Complete" asp-route-id="@Model.OrderId" method="post" class="mb-2">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="w-full rounded-xl bg-[#27AE60] px-4 py-3 text-sm font-semibold text-white hover:opacity-90">Xác nhận đã giao thành công</button>
                    </form>
                }

                @if (Model.OrderStatus != "Completed" && Model.OrderStatus != "Cancelled")
                {
                    <form asp-controller="Shipper" asp-action="ReturnOrder" asp-route-id="@Model.OrderId" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="w-full rounded-xl bg-red-50 px-4 py-3 text-sm font-semibold text-red-600 ring-1 ring-red-100 hover:bg-red-100">Hoàn trả / Hủy đơn</button>
                    </form>
                }
            </div>
        </section>
    </main>
</body>
</html>
