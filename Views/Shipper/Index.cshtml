@{
    Layout = null; // Tắt hoàn toàn layout chung để dùng giao diện Shipper riêng
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://fonts.googleapis.com/css?family=Work+Sans:400,500,600,700,800&display=swap" rel="stylesheet" />
    <title>Lapizzaria Shipper - Dashboard</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: 'Work Sans', sans-serif;
            background-color: #FFFFFF;
        }

        /* --- NAVBAR TRÊN --- */
        .v419_2 {
            width: 100%;
            height: 80px;
            background: #FFFFFF;
            border-bottom: 1px solid #F0F0F0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 50px;
            box-sizing: border-box;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .v419_4 {
            display: flex;
            align-items: baseline;
            gap: 8px;
        }

        .v419_5 {
            font-size: 22px;
            font-weight: 800;
            color: #000000;
        }

        .v419_6 {
            font-size: 14px;
            font-weight: 600;
            color: #E67E22;
        }

        .v419_8 {
            display: flex;
            gap: 25px;
            align-items: center;
        }

        .v419_9, .v419_10, .v419_11 {
            font-size: 14px;
            font-weight: 500;
            color: #2C3E50;
            text-decoration: none;
            cursor: pointer;
        }

        .v419_9 {
            font-weight: 700;
            color: #000;
        }

        .v419_13 {
            background: #27AE60;
            color: white;
            padding: 8px 16px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
            border: none;
        }

        /* --- CONTAINER --- */
        .container {
            max-width: 1100px;
            margin: 40px auto;
            padding: 0 20px;
        }

        .stats-row {
            display: flex;
            gap: 20px;
            margin-bottom: 40px;
        }

        .stat-card {
            flex: 1;
            background: #FFFFFF;
            border: 1px solid #F5F5F5;
            padding: 24px;
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.03);
        }

        .stat-title {
            color: #95A5A6;
            font-size: 13px;
            font-weight: 500;
            margin-bottom: 12px;
            display: block;
        }

        .stat-value {
            font-size: 28px;
            font-weight: 800;
            color: #2C3E50;
            margin-bottom: 8px;
            display: block;
        }

        .stat-sub {
            font-size: 12px;
            color: #27AE60;
            font-weight: 600;
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            margin-top: 30px;
        }

        .section-title {
            font-size: 20px;
            font-weight: 800;
            color: #2C3E50;
        }

        .status-badge {
            background: #FDF2E9;
            color: #E67E22;
            font-size: 11px;
            padding: 6px 14px;
            border-radius: 20px;
            font-weight: 800;
            text-transform: uppercase;
        }

        /* --- ĐANG GIAO (MAP) --- */
        .active-order-card {
            border: 1px solid #F0F0F0;
            border-radius: 20px;
            display: flex;
            overflow: hidden;
            margin-bottom: 50px;
            background: #fff;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        }

        .map-box {
            width: 42%;
            background: #F8F9FA;
            min-height: 350px;
        }

        .order-detail {
            width: 58%;
            padding: 30px;
        }

        .order-meta {
            display: flex;
            justify-content: space-between;
            margin-bottom: 25px;
        }

        .order-id {
            color: #E67E22;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 0.5px;
        }

        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 25px;
            margin-bottom: 30px;
        }

        .info-label {
            color: #BDC3C7;
            font-size: 11px;
            text-transform: uppercase;
            font-weight: 700;
            margin-bottom: 8px;
            display: block;
        }

        .info-text {
            font-size: 14px;
            font-weight: 600;
            color: #2C3E50;
            line-height: 1.5;
        }

        .btn-group {
            display: flex;
            gap: 12px;
        }

        .btn {
            border: none;
            padding: 14px;
            border-radius: 10px;
            font-weight: 700;
            cursor: pointer;
            flex: 1;
            font-size: 13px;
            transition: 0.2s;
        }

        .btn-red {
            background: #FFF0F0;
            color: #E74C3C;
        }

        .btn-orange {
            background: #E67E22;
            color: white;
        }

        .btn-blue {
            background: #3498DB;
            color: white;
            width: 100%;
            margin-top: 12px;
        }

        .btn:hover {
            opacity: 0.9;
            transform: translateY(-1px);
        }

        /* --- ĐƠN HÀNG MỚI --- */
        .new-order-item {
            background: #fff;
            border: 1px solid #F0F0F0;
            border-radius: 14px;
            padding: 20px 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
            transition: 0.3s;
        }

            .new-order-item:hover {
                border-color: #E67E22;
                box-shadow: 0 5px 15px rgba(0,0,0,0.05);
            }

        .btn-accept {
            background: #E67E22;
            color: white;
            border: none;
            padding: 12px 28px;
            border-radius: 10px;
            font-weight: 700;
            cursor: pointer;
        }
    </style>
</head>
<body>

    <div class="v419_2">
        <div class="v419_4">
            <span class="v419_5">Lapizzaria</span>
            <span class="v419_6">Giao hàng</span>
        </div>

        <div class="v419_8">
            <a class="v419_9">Trang chủ</a>
            <a class="v419_10">Lịch sử giao hàng</a>
            <a class="v419_11">Thu nhập</a>

            <button class="v419_13">
                <div style="width: 8px; height: 8px; background: #fff; border-radius: 50%;"></div>
                <span>Đang làm việc</span>
            </button>

            <div style="display: flex; gap: 15px; align-items: center; border-left: 1px solid #EEE; padding-left: 20px;">
                <span style="font-size: 20px; color: #95A5A6; cursor: pointer;">🔔</span>
                <div style="width: 38px; height: 38px; border-radius: 50%; overflow: hidden; border: 2px solid #E67E22;">
                    <img src="https://ui-avatars.com/api/?name=Shipper&background=E67E22&color=fff" style="width: 100%; height: 100%; object-fit: cover;">
                </div>
            </div>
        </div>
    </div>

    <div class="container">
        <div class="stats-row">
            <div class="stat-card">
                <span class="stat-title">Đơn hôm nay 🚚</span>
                <span class="stat-value">12</span>
                <span class="stat-sub">↗ +15% so với hôm qua</span>
            </div>
            <div class="stat-card">
                <span class="stat-title">Tổng thu nhập hôm nay 💵</span>
                <span class="stat-value">2.150.000đ</span>
                <span class="stat-sub">↗ +10% so với hôm qua</span>
            </div>
        </div>

        <div class="section-header">
            <span class="section-title">Đang giao</span>
            <span class="status-badge">Đang vận chuyển</span>
        </div>

        <div class="active-order-card">
            <div class="map-box">
                <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3919.460232428398!2d106.691775775838!3d10.771415559199393!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31752f3f1e98399f%3A0x7bc6686008ef7d8b!2zMTIzIMSQxrDhu51uZyBMw6ogTOG7o2ksIELhuruIE5naMOpLCBRdeG6rW4gMSwgSOG7kyBDaMOtIE1pbmgsIFZp4buHdCBOYW0!5e0!3m2!1svi!2s!4v1710000000000!5m2!1svi!2s"
                        width="100%"
                        height="100%"
                        style="border:0;"
                        allowfullscreen=""
                        loading="lazy">
                </iframe>
            </div>
            <div class="order-detail">
                <div class="order-meta">
                    <div>
                        <span class="order-id">MÃ ĐƠN #7829</span>
                        <div style="font-size: 20px; font-weight: 800; margin-top: 5px; color: #2C3E50;">2x Pizza Pepperoni Lớn</div>
                    </div>
                    <div style="text-align: right;">
                        <span class="info-label">Lấy hàng tại</span>
                        <div style="font-weight: 800; color: #2C3E50;">Lapizzaria</div>
                    </div>
                </div>

                <div class="info-grid">
                    <div>
                        <span class="info-label">Địa chỉ giao hàng</span>
                        <div class="info-text">123 Đường Lê Lợi,<br>Quận 1, TP. Hồ Chí Minh</div>
                    </div>
                    <div>
                        <span class="info-label">Khách hàng</span>
                        <div class="info-text">Nguyễn Văn A</div>
                        <div style="color: #E67E22; font-weight: 800; font-size: 15px;">090 123 4567</div>
                    </div>
                </div>

                <div class="btn-group">
                    <button class="btn btn-red">↩ Hoàn trả đơn hàng</button>
                    <button class="btn btn-orange">✓ Đã giao thành công</button>
                </div>
                <button class="btn btn-blue">📦 Đã lấy hàng (Đang tới nhà khách)</button>
            </div>
        </div>

        <div class="section-header">
            <span class="section-title">Đơn hàng mới</span>
            <span style="color: #E67E22; font-size: 12px; font-weight: 700; cursor: pointer;">🔄 Cập nhật</span>
        </div>

        <div class="new-order-item">
            <div>
                <div style="font-weight: 800; font-size: 16px; color: #2C3E50;">#7832 - Pizza Phô mai & Rau củ</div>
                <div style="font-size: 13px; color: #7F8C8D; margin-top: 6px;">
                    📍 456 Võ Văn Kiệt, Q.1 | 📏 1.2 km | 🕒 12 phút chuẩn bị | <span style="color: #E67E22; font-weight: 700;">Ship: 25.000đ</span>
                </div>
            </div>
            <button class="btn-accept">Chấp nhận</button>
        </div>

        <div class="new-order-item">
            <div>
                <div style="font-weight: 800; font-size: 16px; color: #2C3E50;">#7835 - Pizza Gà BBQ</div>
                <div style="font-size: 13px; color: #7F8C8D; margin-top: 6px;">
                    📍 789 Trần Hưng Đạo, Q.5 | 📏 3.5 km | ✨ Sẵn sàng | <span style="color: #E67E22; font-weight: 700;">Ship: 35.000đ</span>
                </div>
            </div>
            <button class="btn-accept">Chấp nhận</button>
        </div>

        <div style="text-align: center; margin-top: 40px; padding-bottom: 40px;">
            <a href="#" style="color: #BDC3C7; text-decoration: none; font-size: 13px; font-weight: 600;">Xem tất cả đơn cần giao hàng ></a>
        </div>
    </div>

</body>
</html>