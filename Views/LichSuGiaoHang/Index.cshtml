@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://fonts.googleapis.com/css?family=Work+Sans:300,400,500,600,700,800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <title>Lapizzaria - Lịch sử giao hàng</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: 'Work Sans', sans-serif;
            background-color: #f8f9fa;
            color: #000;
        }

        /* --- NAVBAR CHUẨN --- */
        .v419_2 {
            width: 100%;
            height: 80px;
            background: #FFFFFF;
            border-bottom: 1px solid #F0F0F0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 50px;
            box-sizing: border-box;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .v419_4 {
            display: flex;
            align-items: baseline;
            gap: 8px;
        }

        .v419_5 {
            font-size: 22px;
            font-weight: 800;
            color: #000000;
            text-decoration: none;
        }

        .v419_6 {
            font-size: 14px;
            font-weight: 600;
            color: #E67E22;
        }

        .v419_8 {
            display: flex;
            gap: 25px;
            align-items: center;
        }

        .v419_9, .v419_10, .v419_11 {
            font-size: 14px;
            font-weight: 500;
            color: #2C3E50;
            text-decoration: none;
        }

        .v419_10 {
            font-weight: 700;
            color: #000;
        }

        .v419_13 {
            background: #27AE60;
            color: white;
            padding: 8px 16px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
            border: none;
        }

        .status-dot {
            width: 8px;
            height: 8px;
            background: #fff;
            border-radius: 50%;
        }

        /* --- CONTAINER --- */
        .container {
            max-width: 1100px;
            margin: 40px auto;
            padding: 0 20px;
        }

        /* --- STATS CARDS --- */
        .stats-row {
            display: flex;
            gap: 20px;
            margin-bottom: 50px;
        }

        .stat-card {
            flex: 1;
            background: #FFFFFF;
            border: 1px solid #F0F0F0;
            padding: 30px;
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.02);
        }

        .stat-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }

        .stat-title {
            color: #95A5A6;
            font-size: 14px;
            font-weight: 500;
        }

        .stat-icon {
            color: #E67E22;
            font-size: 20px;
        }

        .stat-value {
            font-size: 32px;
            font-weight: 800;
            color: #2C3E50;
            display: block;
            margin-bottom: 10px;
        }

        .stat-sub {
            font-size: 12px;
            color: #27AE60;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        /* --- SECTIONS --- */
        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            margin-top: 40px;
        }

        .section-title {
            font-size: 18px;
            font-weight: 800;
            color: #2C3E50;
        }

        .refresh-link {
            color: #E67E22;
            font-size: 12px;
            font-weight: 700;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 5px;
        }

            .refresh-link .material-symbols-outlined {
                font-size: 16px;
            }

        /* --- ITEM CARDS --- */
        .history-card {
            background: #FFFFFF;
            border: 1px solid #F0F0F0;
            border-radius: 14px;
            padding: 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }

        .item-info {
            display: flex;
            gap: 20px;
            align-items: center;
        }

        .item-icon-box {
            width: 50px;
            height: 50px;
            background: #FFF7F0;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #E67E22;
        }

        .item-name {
            font-size: 16px;
            font-weight: 800;
            color: #2C3E50;
            margin-bottom: 8px;
        }

        .item-meta {
            font-size: 13px;
            color: #95A5A6;
            display: flex;
            gap: 15px;
            align-items: center;
        }

            .item-meta span {
                display: flex;
                align-items: center;
                gap: 4px;
            }

            .item-meta .material-symbols-outlined {
                font-size: 14px;
            }

        .item-address {
            display: block;
            margin-top: 8px;
            font-size: 13px;
            font-weight: 500;
            color: #7F8C8D;
        }

        .item-price {
            color: #E67E22;
            font-weight: 700;
        }

        /* --- STATUS BUTTONS --- */
        .status-btn {
            width: 140px;
            padding: 12px 0;
            border-radius: 10px;
            font-weight: 800;
            font-size: 13px;
            border: none;
            cursor: pointer;
            text-align: center;
        }

        .btn-delivered {
            background: #2ecc71;
            color: white;
        }

        .btn-returned {
            background: #e67e22;
            color: white;
        }

        .view-all {
            text-align: center;
            margin-top: 50px;
            padding-bottom: 50px;
        }

        .view-all-link {
            color: #BDC3C7;
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
        }
    </style>
</head>
<body>

    <div class="v419_2">
        <div class="v419_4">
            <a href="/" class="v419_5">Lapizzaria</a>
            <span class="v419_6">Giao hàng</span>
        </div>
        <div class="v419_8">
            <a class="v419_9" href="#">Trang chủ</a>
            <a class="v419_10" href="#">Lịch sử giao hàng</a>
            <a class="v419_11" href="#">Thu nhập</a>
            <button class="v419_13">
                <div class="status-dot"></div>
                <span>Đang làm việc</span>
            </button>
            <div style="display: flex; gap: 15px; align-items: center; border-left: 1px solid #EEE; padding-left: 20px;">
                <span class="material-symbols-outlined" style="color: #95A5A6;">notifications</span>
                <div style="width: 38px; height: 38px; border-radius: 50%; overflow: hidden; border: 2px solid #E67E22;">
                    <img src="https://i.pravatar.cc/150?u=shipper1" style="width: 100%; height: 100%; object-fit: cover;">
                </div>
            </div>
        </div>
    </div>

    <div class="container">
        <div class="stats-row">
            <div class="stat-card">
                <div class="stat-header">
                    <span class="stat-title">Đơn hôm nay</span>
                    <span class="material-symbols-outlined stat-icon">local_shipping</span>
                </div>
                <span class="stat-value">12</span>
                <span class="stat-sub">
                    <span class="material-symbols-outlined" style="font-size: 14px;">trending_up</span> +15% so với hôm qua
                </span>
            </div>
            <div class="stat-card">
                <div class="stat-header">
                    <span class="stat-title">Tổng thu nhập ngày hôm nay</span>
                    <span class="material-symbols-outlined stat-icon">payments</span>
                </div>
                <span class="stat-value">2.150.000đ</span>
                <span class="stat-sub">
                    <span class="material-symbols-outlined" style="font-size: 14px;">trending_up</span> +10% so với hôm qua
                </span>
            </div>
        </div>

        <div class="section-header">
            <span class="section-title">Lịch sử giao hàng ngày hôm nay</span>
            <a href="#" class="refresh-link">
                <span class="material-symbols-outlined">refresh</span> Cập nhật
            </a>
        </div>

        <div class="history-card">
            <div class="item-info">
                <div class="item-icon-box">
                    <span class="material-symbols-outlined">local_pizza</span>
                </div>
                <div>
                    <div class="item-name">#7832 - Pizza Phô mai & Rau củ</div>
                    <div class="item-meta">
                        <span><span class="material-symbols-outlined">near_me</span> 1.2 km</span>
                        <span><span class="material-symbols-outlined">check_circle</span> Đã giao trong 20 phút</span>
                        <span class="item-price">Phí ship: 25.000đ</span>
                    </div>
                    <span class="item-address">📍 456 Võ Văn Kiệt, Quận 1</span>
                </div>
            </div>
            <button class="status-btn btn-delivered">Đã giao</button>
        </div>

        <div class="history-card">
            <div class="item-info">
                <div class="item-icon-box">
                    <span class="material-symbols-outlined">local_pizza</span>
                </div>
                <div>
                    <div class="item-name">#7835 - Pizza Gà BBQ</div>
                    <div class="item-meta">
                        <span><span class="material-symbols-outlined">near_me</span> 3.5 km</span>
                        <span><span class="material-symbols-outlined">schedule</span> Sẵn sàng</span>
                        <span class="item-price">Phí ship: 35.000đ</span>
                    </div>
                    <span class="item-address">📍 789 Trần Hưng Đạo, Quận 5</span>
                </div>
            </div>
            <button class="status-btn btn-returned">Đã hoàn</button>
        </div>

        <div class="section-header">
            <span class="section-title">Lịch sử giao hàng ngày hôm qua</span>
            <a href="#" class="refresh-link">
                <span class="material-symbols-outlined">refresh</span> Cập nhật
            </a>
        </div>

        <div class="history-card">
            <div class="item-info">
                <div class="item-icon-box">
                    <span class="material-symbols-outlined">local_pizza</span>
                </div>
                <div>
                    <div class="item-name">#7832 - Pizza Phô mai & Rau củ</div>
                    <div class="item-meta">
                        <span><span class="material-symbols-outlined">near_me</span> 1.2 km</span>
                        <span><span class="material-symbols-outlined">check_circle</span> Đã giao trong 20 phút</span>
                        <span class="item-price">Phí ship: 25.000đ</span>
                    </div>
                    <span class="item-address">📍 456 Võ Văn Kiệt, Quận 1</span>
                </div>
            </div>
            <button class="status-btn btn-delivered">Đã giao</button>
        </div>

        <div class="view-all">
            <a href="#" class="view-all-link">
                Xem tất cả lịch sử giao hàng <span class="material-symbols-outlined">chevron_right</span>
            </a>
        </div>
    </div>
</body>
</html>