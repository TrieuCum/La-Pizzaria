@model LaPizzaria.Models.Ingredient
@using System.Linq
@{
	var cats = ViewBag.Categories as List<LaPizzaria.Models.IngredientCategory> ?? new List<LaPizzaria.Models.IngredientCategory>();
}

<h2>@(Model.Id == 0 ? "Thêm nguyên liệu" : "Cập nhật nguyên liệu")</h2>

<form asp-action="Upsert" method="post">
	<input type="hidden" asp-for="Id" />
	<div class="mb-3">
		<label class="form-label">Nhóm nguyên liệu</label>
		<select asp-for="CategoryId" class="form-control">
			<option value="">— Khác / chưa phân loại —</option>
			@foreach (var c in cats.OrderBy(x => x.SortOrder).ThenBy(x => x.Name))
			{
				var indent = c.ParentId.HasValue ? "　" : "";
				<option value="@c.Id">@indent@c.Name</option>
			}
		</select>
	</div>
	<div class="mb-3">
		<label asp-for="Name" class="form-label"></label>
		<input asp-for="Name" class="form-control" />
	</div>
	<div class="mb-3">
		<label asp-for="Unit" class="form-label"></label>
		<input asp-for="Unit" class="form-control" />
	</div>
	<div class="mb-3">
		<label asp-for="UnitPrice" class="form-label">Giá / đơn vị</label>
		<input asp-for="UnitPrice" class="form-control" type="number" min="0" step="0.01" />
	</div>
	<div class="mb-3">
		<label asp-for="StockQuantity" class="form-label"></label>
		<input asp-for="StockQuantity" class="form-control" />
	</div>
	<div class="mb-3">
		<label asp-for="ReorderLevel" class="form-label"></label>
		<input asp-for="ReorderLevel" class="form-control" />
	</div>
	<div class="form-check mb-3">
		<input class="form-check-input" type="checkbox" asp-for="IsActive" />
		<label class="form-check-label" asp-for="IsActive"></label>
	</div>
	<div class="form-check mb-3">
		<input class="form-check-input" type="checkbox" asp-for="IsDoughBase" />
		<label class="form-check-label" asp-for="IsDoughBase">Nguyên liệu bánh (đế) - luôn dùng 1 phần cho mọi size</label>
	</div>
	<button type="submit" class="btn btn-success">Lưu</button>
	<a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>


