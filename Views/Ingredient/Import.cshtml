@model List<LaPizzaria.Models.IngredientImport>
@using LaPizzaria.Models
@{
    ViewData["Title"] = "Nhập hàng nguyên liệu";
    var ingredients = ViewBag.Ingredients as List<Ingredient> ?? new List<Ingredient>();
    var page = (int)ViewBag.Page;
    var totalPages = (int)ViewBag.TotalPages;
    var culture = new System.Globalization.CultureInfo("vi-VN");
}

<div style="padding:32px;max-width:1300px;margin:0 auto;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 style="font-size:26px;font-weight:700;color:var(--brand-dark);margin:0;">Nhập hàng nguyên liệu</h1>
            <p style="color:var(--brand-gray);font-size:13px;margin:4px 0 0;">Ghi nhận phiếu nhập và cập nhật tồn kho tự động</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Export" class="btn btn-outline-danger btn-sm"><i class="bi bi-box-arrow-right me-1"></i>Xuất hàng</a>
            <a asp-action="Stock" class="btn btn-outline-secondary btn-sm"><i class="bi bi-boxes me-1"></i>Tồn kho</a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Form nhập hàng -->
        <div class="col-lg-4">
            <div class="bg-white rounded-3 p-4" style="border:1px solid #f0f0f0;">
                <h6 class="fw-bold mb-3"><i class="bi bi-plus-circle me-2 text-success"></i>Tạo phiếu nhập mới</h6>
                <form asp-action="Import" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Nguyên liệu</label>
                        <select name="ingredientId" class="form-select form-select-sm" required>
                            <option value="">-- Chọn nguyên liệu --</option>
                            @foreach (var ing in ingredients)
                            {
                                <option value="@ing.Id">@ing.Name (@ing.Unit) — Tồn: @ing.StockQuantity.ToString("N0", culture)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Ngày nhập</label>
                        <input type="date" name="importDate" class="form-control form-control-sm"
                               value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col">
                            <label class="form-label fw-semibold small">Số lượng</label>
                            <input type="number" name="quantity" class="form-control form-control-sm" step="0.01" min="0.01" placeholder="VD: 10" required />
                        </div>
                        <div class="col">
                            <label class="form-label fw-semibold small">Đơn giá (đ)</label>
                            <input type="number" name="unitPrice" class="form-control form-control-sm" step="1" min="0" placeholder="VD: 5000" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Nhà cung cấp</label>
                        <input type="text" name="supplier" class="form-control form-control-sm" placeholder="Tên NCC" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Ghi chú</label>
                        <textarea name="note" class="form-control form-control-sm" rows="2" placeholder="Ghi chú thêm..."></textarea>
                    </div>
                    <button type="submit" class="btn btn-success w-100 fw-bold">
                        <i class="bi bi-check-lg me-1"></i> Xác nhận nhập hàng
                    </button>
                </form>
            </div>
        </div>

        <!-- Lịch sử nhập -->
        <div class="col-lg-8">
            <div class="bg-white rounded-3" style="border:1px solid #f0f0f0;overflow:hidden;">
                <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0">Lịch sử nhập hàng (@ViewBag.TotalRecords phiếu)</h6>
                    <form method="get" class="d-flex gap-2">
                        <input type="text" name="q" value="@ViewBag.Q" class="form-control form-control-sm" placeholder="Tìm nguyên liệu..." style="width:200px;" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-search"></i></button>
                    </form>
                </div>
                <div style="overflow-x:auto;">
                    <table style="width:100%;border-collapse:collapse;">
                        <thead style="background:#f8f7f5;">
                            <tr>
                                <th style="padding:12px 16px;font-size:12px;font-weight:700;color:var(--brand-gray);text-transform:uppercase;">Ngày</th>
                                <th style="padding:12px 16px;font-size:12px;font-weight:700;color:var(--brand-gray);text-transform:uppercase;">Nguyên liệu</th>
                                <th style="padding:12px 16px;font-size:12px;font-weight:700;color:var(--brand-gray);text-transform:uppercase;text-align:right;">Số lượng</th>
                                <th style="padding:12px 16px;font-size:12px;font-weight:700;color:var(--brand-gray);text-transform:uppercase;text-align:right;">Đơn giá</th>
                                <th style="padding:12px 16px;font-size:12px;font-weight:700;color:var(--brand-gray);text-transform:uppercase;text-align:right;">Tổng tiền</th>
                                <th style="padding:12px 16px;font-size:12px;font-weight:700;color:var(--brand-gray);text-transform:uppercase;">NCC</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var rec in Model)
                            {
                                <tr style="border-top:1px solid #f0f0f0;">
                                    <td style="padding:12px 16px;font-size:13px;color:var(--brand-gray);">@rec.ImportDate.ToString("dd/MM/yyyy")</td>
                                    <td style="padding:12px 16px;font-weight:600;font-size:13px;">@(rec.Ingredient?.Name ?? "—")</td>
                                    <td style="padding:12px 16px;text-align:right;font-size:13px;color:#16a34a;font-weight:700;">+@rec.Quantity.ToString("N0", culture) @rec.Ingredient?.Unit</td>
                                    <td style="padding:12px 16px;text-align:right;font-size:13px;color:var(--brand-gray);">@(rec.UnitPrice > 0 ? rec.UnitPrice.ToString("N0", culture) + "đ" : "—")</td>
                                    <td style="padding:12px 16px;text-align:right;font-size:13px;font-weight:600;">@((rec.Quantity * rec.UnitPrice).ToString("N0", culture))đ</td>
                                    <td style="padding:12px 16px;font-size:13px;color:var(--brand-gray);">@(rec.Supplier ?? "—")</td>
                                </tr>
                            }
                            @if (!Model.Any())
                            {
                                <tr><td colspan="6" style="padding:40px;text-align:center;color:var(--brand-gray);">Chưa có phiếu nhập nào.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (totalPages > 1)
                {
                    <div class="d-flex gap-2 p-3">
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <a asp-action="Import" asp-route-page="@i" asp-route-q="@ViewBag.Q"
                               style="padding:5px 12px;border-radius:6px;text-decoration:none;font-size:12px;font-weight:600;background:@(i==page?"var(--brand-orange)":"#f0f0f0");color:@(i==page?"white":"var(--brand-dark)");">@i</a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
