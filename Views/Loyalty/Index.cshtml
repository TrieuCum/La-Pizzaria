@model LaPizzaria.ViewModels.LoyaltyIndexViewModel
@{
    ViewData["Title"] = "Tích điểm & Ưu đãi";
}

@section Styles {
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" />
    <link rel="stylesheet" href="~/css/loyalty.css" asp-append-version="true" />
}

<div class="lp-loyalty-page">
    <div class="lp-loyalty-wrap">
        <div class="lp-loyalty-header mb-3">
            <h1>Tích điểm &amp; Ưu đãi</h1>
            <p>Tích lũy điểm thưởng qua mỗi đơn hàng và đổi lấy những phần quà hấp dẫn.</p>
        </div>

        @if (TempData["error"] != null)
        {
            <div class="alert alert-danger py-2 px-3 mb-3">@TempData["error"]</div>
        }
        @if (TempData["success"] != null)
        {
            <div class="alert alert-success py-2 px-3 mb-3">@TempData["success"]</div>
        }

        <div class="lp-loyalty-summary mb-4" style="--lp-progress:@Model.ProgressPercent%">
            <div class="lp-loyalty-points">
                <div class="lp-loyalty-points-label">Tổng điểm tích lũy</div>
                <div class="lp-loyalty-points-value">
                    <strong>@Model.Points.ToString("N0")</strong>
                    <span class="fw-semibold">điểm</span>
                </div>
                <div class="lp-loyalty-tier">
                    <span class="material-symbols-outlined lp-icon">stars</span>
                    <span>Thành viên @Model.Tier</span>
                </div>
            </div>
            <div class="lp-loyalty-progress">
                <div class="lp-loyalty-progress-title">Tiến độ thăng hạng @Model.NextTierName</div>
                <div class="lp-loyalty-progress-sub">
                    Bạn cần thêm <span class="fw-bold text-brand-orange">@Model.RemainingToNextTier.ToString("N0") điểm</span> nữa để thăng hạng.
                </div>
                <div class="lp-loyalty-bar">
                    <div class="lp-loyalty-bar-fill"></div>
                </div>
                <div class="lp-loyalty-bar-steps">
                    <span>Đồng (0)</span>
                    <span>@Model.NextTierName (@Model.NextTierTarget.ToString("N0"))</span>
                </div>
            </div>
            <div class="lp-loyalty-progress-right">
                <div class="lp-loyalty-progress-main">@Model.Points.ToString("N0")</div>
                <div class="lp-loyalty-progress-subnum">/@Model.NextTierTarget.ToString("N0")</div>
            </div>
        </div>

        <div class="lp-loyalty-grid">
            <div>
                <div class="lp-card mb-3">
                    <div class="lp-card-header">
                        <div class="lp-card-title">
                            <span class="material-symbols-outlined lp-icon">workspace_premium</span>
                            <span>Hạng thành viên</span>
                        </div>
                    </div>
                    <div class="lp-tier-grid">
                        <div class="lp-tier-card @(Model.Tier == "Đồng" ? "current" : "")">
                            @if (Model.Tier == "Đồng") { <div class="lp-tier-current-badge">Hiện tại</div> }
                            <div class="lp-tier-name">Đồng</div>
                            <div class="lp-tier-range">0 - 500 điểm</div>
                            <div class="lp-tier-desc">Ưu đãi cơ bản cho khách mới.</div>
                        </div>
                        <div class="lp-tier-card @(Model.Tier == "Bạc" ? "current" : "")">
                            @if (Model.Tier == "Bạc") { <div class="lp-tier-current-badge">Hiện tại</div> }
                            <div class="lp-tier-name">Bạc</div>
                            <div class="lp-tier-range">501 - 1.500 điểm</div>
                            <div class="lp-tier-desc">Tích điểm x1.2, quà sinh nhật.</div>
                        </div>
                        <div class="lp-tier-card @(Model.Tier == "Vàng" ? "current" : "")">
                            @if (Model.Tier == "Vàng") { <div class="lp-tier-current-badge">Hiện tại</div> }
                            <div class="lp-tier-name">Vàng</div>
                            <div class="lp-tier-range">1.501 - 3.000 điểm</div>
                            <div class="lp-tier-desc">Tích điểm x1.5, freeship dưới 5km.</div>
                        </div>
                        <div class="lp-tier-card @(Model.Tier == "Kim Cương" ? "current" : "")">
                            @if (Model.Tier == "Kim Cương") { <div class="lp-tier-current-badge">Hiện tại</div> }
                            <div class="lp-tier-name">Kim Cương</div>
                            <div class="lp-tier-range">3.000+ điểm</div>
                            <div class="lp-tier-desc">Tích điểm x2, ưu đãi VIP.</div>
                        </div>
                    </div>
                </div>

                <div class="lp-card">
                    <div class="lp-card-header">
                        <div class="lp-card-title">
                            <span class="material-symbols-outlined lp-icon">redeem</span>
                            <span>Đổi ưu đãi</span>
                        </div>
                    </div>
                    <div class="lp-redeem-grid">
                        @foreach (var reward in Model.Rewards)
                        {
                            <div class="lp-redeem-card">
                                <div class="lp-redeem-body">
                                    <div class="lp-redeem-title">@reward.Title</div>
                                    <div class="lp-redeem-desc">@reward.Description</div>
                                </div>
                                <div class="lp-redeem-footer">
                                    <span class="lp-pill-points @(reward.CanRedeem ? "" : "text-muted")">@reward.CostPoints.ToString("N0") điểm</span>
                                    <form asp-controller="Loyalty" asp-action="Redeem" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="code" value="@reward.Code" />
                                        <button type="submit" class="lp-btn-small" @(reward.CanRedeem ? null : "disabled")>
                                            @(reward.CanRedeem ? "Đổi ngay" : "Thiếu điểm")
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="lp-card lp-voucher-card mt-3">
                    <div class="lp-card-header">
                        <div class="lp-card-title">
                            <span class="material-symbols-outlined lp-icon">confirmation_number</span>
                            <span>Voucher của tôi</span>
                        </div>
                    </div>
                    <div class="lp-voucher-list">
                        @if (Model.Vouchers.Any())
                        {
                            @foreach (var v in Model.Vouchers)
                            {
                                var badgeClass = v.Status == "unused" ? "lp-voucher-badge-green" : v.Status == "used" ? "lp-voucher-badge-gray" : "lp-voucher-badge-red";
                                var badgeText = v.Status == "unused" ? "Chưa dùng" : v.Status == "used" ? "Đã dùng" : "Hết hạn";
                                var itemMuted = v.Status == "unused" ? "" : "lp-voucher-item-muted";
                                <div class="lp-voucher-item @itemMuted">
                                    <div class="lp-voucher-icon @(v.Status == "unused" ? "lp-voucher-icon-green" : v.Status == "used" ? "lp-voucher-icon-gray" : "lp-voucher-icon-red")">
                                        <span class="material-symbols-outlined">@((v.Status == "unused") ? "percent" : (v.Status == "used" ? "check_circle" : "event_busy"))</span>
                                    </div>
                                    <div class="lp-voucher-body">
                                        <div class="lp-voucher-title">@v.Title</div>
                                        <div class="lp-voucher-meta">@v.Meta</div>
                                    </div>
                                    <div class="lp-voucher-right">
                                        <span class="lp-voucher-badge @badgeClass">@badgeText</span>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-muted small">Bạn chưa có voucher từ tích điểm. Hãy đổi ưu đãi để nhận voucher mới.</div>
                        }
                    </div>
                </div>
            </div>

            <div>
                <div class="lp-card">
                    <div class="lp-card-header">
                        <div class="lp-card-title">
                            <span class="material-symbols-outlined lp-icon">history</span>
                            <span>Lịch sử điểm</span>
                        </div>
                    </div>
                    <table class="lp-history-table">
                        <tbody>
                            @if (Model.Transactions.Any())
                            {
                                @foreach (var t in Model.Transactions)
                                {
                                    var css = t.PointsChange > 0 ? "earn" : "spend";
                                    var sign = t.PointsChange > 0 ? "+" : "";
                                    <tr>
                                        <td>
                                            <div class="lp-history-title">@t.Description</div>
                                            <div class="lp-history-date">@t.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                                        </td>
                                        <td class="text-end">
                                            <div class="lp-history-change @css">@sign@t.PointsChange.ToString("N0")</div>
                                            <div class="lp-history-balance">@t.BalanceAfter.ToString("N0")</div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="2" class="text-muted small py-3">Chưa có lịch sử điểm.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
