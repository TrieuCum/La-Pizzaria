@model LaPizzaria.Models.Combo
@{
    var comboPrice = (Model.Items.Select(i => ((i.Product?.Price) ?? 0m) * Math.Max(1, i.MinQuantity)).Sum() - (Model.DiscountAmount > 0 ? Model.DiscountAmount : 0m)) * (1 - (Model.DiscountPercent ?? 0m) / 100m);
    if (comboPrice < 0) comboPrice = 0;
}

<div class="col-md-6 col-lg-4">
    <div class="menu-card h-100 bg-white shadow-sm border-0 position-relative transition-all hover-up">
        <span class="card-badge badge-red">COMBO TIẾT KIỆM</span>
        <div class="card-img-wrap ratio ratio-1x1">
            <a asp-controller="Menu" asp-action="ComboDetails" asp-route-id="@Model.Id" class="d-block w-100 h-100">
                <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/placeholder.png" : Model.ImageUrl)" 
                     class="object-fit-cover w-100 h-100" alt="@Model.Name"
                     onerror="this.src='/images/v17_1114.png'">
            </a>
        </div>
        
        <div class="card-body p-4 d-flex flex-column">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <a asp-controller="Menu" asp-action="ComboDetails" asp-route-id="@Model.Id" class="text-decoration-none flex-grow-1 pe-2">
                    <h5 class="fw-bold text-brand-dark mb-0 hover-orange">@Model.Name</h5>
                </a>
                <span class="fw-black text-brand-orange fs-5">@comboPrice.ToString("N0")₫</span>
            </div>
            <p class="text-brand-gray extra-small mb-3 flex-grow-1">
                @string.Join(", ", Model.Items.Select(i => i.Product?.Name))
            </p>
            <a asp-controller="Menu" asp-action="ComboDetails" asp-route-id="@Model.Id" class="btn btn-outline-brand w-100 py-2 rounded-3 fw-bold small mb-2 text-center text-decoration-none">
                Xem chi tiết
            </a>
            <button class="btn btn-brand-primary w-100 py-3 rounded-3 fw-bold d-flex align-items-center justify-content-center gap-2"
                    onclick="cart.add({ id: @Model.Id, name: '@Model.Name', price: @comboPrice, imageUrl: '@Model.ImageUrl', type: 'combo' }); window.showToast('Đã thêm combo vào giỏ', 'success');">
                <i class="bi bi-cart-plus fs-5"></i> Thêm vào giỏ
            </button>
        </div>
    </div>
</div>
