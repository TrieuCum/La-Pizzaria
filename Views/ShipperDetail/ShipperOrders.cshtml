@model List<LaPizzaria.Models.Order>
@using LaPizzaria.Models
@{
    ViewData["Title"] = "Đơn hàng của shipper";
    var shipper = ViewBag.Shipper as LaPizzaria.Models.ApplicationUser;
    var page = (int)ViewBag.Page;
    var totalPages = (int)ViewBag.TotalPages;
    var totalOrders = (int)ViewBag.TotalOrders;
    var name = shipper != null ? $"{shipper.FirstName} {shipper.LastName}".Trim() : "Shipper";
    if (string.IsNullOrWhiteSpace(name)) name = shipper?.UserName ?? "Shipper";
}

<div style="padding:32px;max-width:1100px;margin:0 auto;">
    <nav style="font-size:13px;color:var(--brand-gray);margin-bottom:16px;">
        <a asp-controller="ShipperDetail" asp-action="Index" style="color:var(--brand-orange);text-decoration:none;">Quản lý Shipper</a>
        <span class="mx-2">/</span>
        <span>@name</span>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 style="font-size:22px;font-weight:700;color:var(--brand-dark);margin:0;">Đơn hàng của @name</h1>
            <p style="color:var(--brand-gray);font-size:13px;margin:4px 0 0;">
                @(shipper?.Email) — Tổng @totalOrders đơn
            </p>
        </div>
        <a asp-controller="ShipperDetail" asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    <div class="bg-white rounded-3" style="border:1px solid #f0f0f0;overflow:hidden;">
        <table style="width:100%;border-collapse:collapse;">
            <thead style="background:#f8f7f5;">
                <tr>
                    <th style="padding:14px 20px;font-size:12px;font-weight:700;color:var(--brand-gray);text-transform:uppercase;text-align:left;">#Đơn</th>
                    <th style="padding:14px 20px;font-size:12px;font-weight:700;color:var(--brand-gray);text-transform:uppercase;text-align:left;">Ngày</th>
                    <th style="padding:14px 20px;font-size:12px;font-weight:700;color:var(--brand-gray);text-transform:uppercase;text-align:left;">Địa chỉ giao</th>
                    <th style="padding:14px 20px;font-size:12px;font-weight:700;color:var(--brand-gray);text-transform:uppercase;text-align:right;">Giá trị</th>
                    <th style="padding:14px 20px;font-size:12px;font-weight:700;color:var(--brand-gray);text-transform:uppercase;text-align:left;">Trạng thái</th>
                    <th style="padding:14px 20px;font-size:12px;font-weight:700;color:var(--brand-gray);text-transform:uppercase;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model)
                {
                    var statusColor = o.OrderStatus == "Completed" ? "#16a34a" : o.OrderStatus == "Cancelled" ? "#dc2626" : "#f97316";
                    var statusBg = o.OrderStatus == "Completed" ? "#dcfce7" : o.OrderStatus == "Cancelled" ? "#fee2e2" : "#fff7ed";
                    <tr style="border-top:1px solid #f0f0f0;">
                        <td style="padding:14px 20px;font-weight:700;color:var(--brand-dark);">#@o.Id</td>
                        <td style="padding:14px 20px;font-size:13px;color:var(--brand-gray);">@o.OrderDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td style="padding:14px 20px;font-size:13px;color:var(--brand-gray);max-width:200px;">
                            <div style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@(o.DeliveryAddress ?? "—")</div>
                        </td>
                        <td style="padding:14px 20px;font-weight:700;text-align:right;color:var(--brand-orange);">@o.TotalPrice.ToString("N0")đ</td>
                        <td style="padding:14px 20px;">
                            <span style="padding:4px 10px;border-radius:6px;font-size:12px;font-weight:600;background:@statusBg;color:@statusColor;">
                                @o.OrderStatus
                            </span>
                        </td>
                        <td style="padding:14px 20px;">
                            <a asp-controller="OrderManagement" asp-action="Details" asp-route-id="@o.Id"
                               style="color:var(--brand-orange);font-size:13px;font-weight:600;text-decoration:none;">
                                Chi tiết
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" style="padding:48px;text-align:center;color:var(--brand-gray);">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                            Chưa có đơn hàng nào được giao bởi shipper này.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (totalPages > 1)
    {
        <div class="d-flex justify-content-center gap-2 mt-4">
            @for (int i = 1; i <= totalPages; i++)
            {
                <a asp-controller="ShipperDetail" asp-action="ShipperOrders"
                   asp-route-shipperId="@shipper!.Id"
                   asp-route-page="@i"
                   style="padding:6px 14px;border-radius:8px;text-decoration:none;font-size:13px;font-weight:600;
                          background:@(i == page ? "var(--brand-orange)" : "#f0f0f0");
                          color:@(i == page ? "white" : "var(--brand-dark)");">
                    @i
                </a>
            }
        </div>
    }
</div>
