@model List<LaPizzaria.Controllers.ShipperStatViewModel>
@{
    ViewData["Title"] = "Quản lý Shipper";
}

<div style="padding:32px;max-width:1400px;margin:0 auto;">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 style="font-size:26px;font-weight:700;color:var(--brand-dark);margin:0;">Quản lý Shipper</h1>
            <p style="color:var(--brand-gray);margin:4px 0 0;font-size:14px;">Theo dõi vị trí và hiệu suất giao hàng theo thời gian thực</p>
        </div>
        <div class="d-flex gap-2">
            <span class="badge bg-success px-3 py-2">
                <i class="bi bi-circle-fill me-1" style="font-size:8px;"></i>
                @Model.Count(s => s.ActiveOrder != null) đang giao
            </span>
            <span class="badge bg-secondary px-3 py-2">
                @Model.Count tổng shipper
            </span>
        </div>
    </div>

    <div class="row g-4">
        <!-- Map panel -->
        <div class="col-lg-7">
            <div class="bg-white rounded-3 overflow-hidden" style="border:1px solid #f0f0f0;">
                <div class="p-3 border-bottom d-flex align-items-center justify-content-between">
                    <h6 class="fw-bold mb-0"><i class="bi bi-map me-2 text-warning"></i>Bản đồ vị trí shipper</h6>
                    <button class="btn btn-sm btn-light" onclick="refreshMap()">
                        <i class="bi bi-arrow-clockwise"></i> Làm mới
                    </button>
                </div>
                <div id="adminShipperMap" style="height:450px;"></div>
            </div>
        </div>

        <!-- Shipper list -->
        <div class="col-lg-5">
            <div class="bg-white rounded-3" style="border:1px solid #f0f0f0;">
                <div class="p-3 border-bottom">
                    <h6 class="fw-bold mb-0"><i class="bi bi-people me-2 text-primary"></i>Danh sách shipper (@Model.Count)</h6>
                </div>
                <div style="max-height:450px;overflow-y:auto;">
                    @foreach (var s in Model)
                    {
                        <div class="p-3 border-bottom d-flex align-items-center gap-3 shipper-row"
                             style="cursor:pointer;"
                             onclick="focusShipper('@s.ShipperId', @(s.CurrentLatitude?.ToString("F6", System.Globalization.CultureInfo.InvariantCulture) ?? "null"), @(s.CurrentLongitude?.ToString("F6", System.Globalization.CultureInfo.InvariantCulture) ?? "null"))">
                            <div style="position:relative;">
                                @if (!string.IsNullOrWhiteSpace(s.AvatarUrl))
                                {
                                    <img src="@s.AvatarUrl" style="width:44px;height:44px;border-radius:50%;object-fit:cover;border:2px solid @(s.ActiveOrder != null ? "#16a34a" : "#e5e7eb");" />
                                }
                                else
                                {
                                    <div style="width:44px;height:44px;border-radius:50%;background:var(--brand-orange);color:white;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:16px;border:2px solid @(s.ActiveOrder != null ? "#16a34a" : "#e5e7eb");">
                                        @(s.FullName.Length > 0 ? s.FullName[0].ToString().ToUpper() : "S")
                                    </div>
                                }
                                @if (s.ActiveOrder != null)
                                {
                                    <div style="position:absolute;bottom:-2px;right:-2px;width:14px;height:14px;background:#16a34a;border-radius:50%;border:2px solid white;"></div>
                                }
                            </div>
                            <div class="flex-grow-1 min-w-0">
                                <div class="fw-bold text-truncate" style="font-size:14px;">@s.FullName</div>
                                <div style="font-size:12px;color:var(--brand-gray);">@s.Phone</div>
                                <div class="d-flex gap-2 mt-1">
                                    @if (s.ActiveOrder != null)
                                    {
                                        <span class="badge" style="background:#dcfce7;color:#16a34a;font-size:10px;">
                                            <i class="bi bi-truck"></i> Đang giao #@s.ActiveOrder.Id
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted" style="font-size:10px;">Rảnh</span>
                                    }
                                </div>
                            </div>
                            <div class="text-end">
                                <div class="fw-bold" style="font-size:16px;color:var(--brand-orange);">@s.TodayCompleted</div>
                                <div style="font-size:10px;color:var(--brand-gray);">hôm nay</div>
                                <a href="@Url.Action("ShipperOrders", "ShipperDetail", new { shipperId = s.ShipperId })"
                                   class="btn btn-sm mt-1"
                                   style="background:#f0f0f0;color:var(--brand-dark);font-size:11px;padding:3px 8px;border-radius:6px;"
                                   onclick="event.stopPropagation();">
                                    Xem đơn
                                </a>
                            </div>
                        </div>
                    }
                    @if (!Model.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-people fs-2 mb-2 d-block"></i>
                            Chưa có shipper nào.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Stats row -->
    <div class="row g-3 mt-2">
        @foreach (var s in Model.Take(4))
        {
            <div class="col-md-3">
                <div class="bg-white rounded-3 p-3" style="border:1px solid #f0f0f0;">
                    <div style="font-size:12px;color:var(--brand-gray);font-weight:600;text-transform:uppercase;letter-spacing:.5px;">@s.FullName</div>
                    <div class="d-flex justify-content-between align-items-end mt-2">
                        <div>
                            <div style="font-size:22px;font-weight:900;color:var(--brand-orange);">@s.TodayCompleted</div>
                            <div style="font-size:11px;color:var(--brand-gray);">đơn hôm nay</div>
                        </div>
                        <div class="text-end">
                            <div style="font-size:16px;font-weight:700;color:var(--brand-dark);">@s.TotalCompleted</div>
                            <div style="font-size:11px;color:var(--brand-gray);">tổng đơn</div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
}

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        const map = L.map('adminShipperMap').setView([10.9416, 106.8407], 12);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; OpenStreetMap'
        }).addTo(map);

        const markers = {};

        const shipperIcon = L.divIcon({
            className: '',
            html: `<div style="background:#f97316;color:white;width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;border:3px solid white;font-size:16px;box-shadow:0 2px 8px rgba(0,0,0,0.3);">&#128666;</div>`,
            iconSize: [32, 32],
            iconAnchor: [16, 16]
        });

        async function refreshMap() {
            try {
                const res = await fetch('/api/admin/shippers/locations');
                if (!res.ok) return;
                const data = await res.json();

                // Remove old markers
                Object.values(markers).forEach(m => map.removeLayer(m));
                Object.keys(markers).forEach(k => delete markers[k]);

                data.forEach(s => {
                    if (s.lat == null || s.lng == null) return;
                    const m = L.marker([s.lat, s.lng], { icon: shipperIcon })
                        .addTo(map)
                        .bindPopup(`<strong>${s.shipperName}</strong><br>Đơn #${s.orderId}<br><small>${s.address || ''}</small>`);
                    markers[s.shipperId] = m;
                });

                if (data.length > 0) {
                    const bounds = L.latLngBounds(data.filter(s => s.lat).map(s => [s.lat, s.lng]));
                    map.fitBounds(bounds, { padding: [50, 50] });
                }
            } catch (e) {
                console.error('Refresh map failed', e);
            }
        }

        function focusShipper(shipperId, lat, lng) {
            if (lat == null || lng == null) return;
            map.setView([lat, lng], 15);
            if (markers[shipperId]) markers[shipperId].openPopup();
        }

        refreshMap();
        setInterval(refreshMap, 10000);

        // Hover effect for shipper rows
        document.querySelectorAll('.shipper-row').forEach(row => {
            row.addEventListener('mouseenter', () => row.style.background = '#fafafa');
            row.addEventListener('mouseleave', () => row.style.background = '');
        });
    </script>
}
