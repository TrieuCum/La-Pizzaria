@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://fonts.googleapis.com/css?family=Work+Sans:300,400,500,600,700,800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <title>PizzaHub Shipper - Chi tiết đơn hàng</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body {
            margin: 0;
            font-family: 'Work Sans', sans-serif;
            background-color: #f3f4f6;
        }

        /* --- NAVBAR ĐỒNG BỘ --- */
        .v419_2 {
            width: 100%;
            height: 80px;
            background: #FFFFFF;
            border-bottom: 1px solid #F0F0F0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 50px;
            box-sizing: border-box;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .v419_4 {
            display: flex;
            align-items: baseline;
            gap: 8px;
        }

        .v419_5 {
            font-size: 22px;
            font-weight: 800;
            color: #000000;
        }

        .v419_6 {
            font-size: 14px;
            font-weight: 600;
            color: #E67E22;
        }

        .v419_8 {
            display: flex;
            gap: 25px;
            align-items: center;
        }

        .v419_9, .v419_10, .v419_11 {
            font-size: 14px;
            font-weight: 500;
            color: #2C3E50;
            text-decoration: none;
        }

        .v419_13 {
            background: #27AE60;
            color: white;
            padding: 8px 16px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
            border: none;
        }

        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 3px;
        }
    </style>
</head>
<body class="h-screen flex flex-col overflow-hidden">

    <div class="v419_2">
        <div class="v419_4">
            <span class="v419_5">Lapizzaria</span>
            <span class="v419_6">Giao hàng</span>
        </div>
        <div class="v419_8">
            <a class="v419_9" href="#">Trang chủ</a>
            <a class="v419_10" href="#">Lịch sử giao hàng</a>
            <a class="v419_11" href="#">Thu nhập</a>
            <button class="v419_13">
                <div style="width: 8px; height: 8px; background: #fff; border-radius: 50%;"></div>
                <span>Đang làm việc</span>
            </button>
            <div style="display: flex; gap: 15px; align-items: center; border-left: 1px solid #EEE; padding-left: 20px;">
                <span class="material-symbols-outlined text-gray-400">notifications</span>
                <div class="w-10 h-10 rounded-full overflow-hidden border-2 border-orange-500">
                    <img src="https://i.pravatar.cc/150?u=shipper1" class="w-full h-full object-cover">
                </div>
            </div>
        </div>
    </div>

    <div class="flex-1 flex flex-col lg:flex-row overflow-hidden">

        <div class="w-full lg:w-[450px] bg-white border-r border-gray-200 shadow-xl overflow-y-auto z-10 flex flex-col">
            <div class="p-6 border-b border-gray-100">
                <div class="flex justify-between items-center mb-2">
                    <h1 class="text-2xl font-bold text-gray-900">Đơn #ORD-2024</h1>
                    <span class="px-3 py-1 bg-orange-100 text-orange-600 rounded-full text-xs font-bold border border-orange-200 flex items-center gap-1">
                        <span class="material-symbols-outlined text-sm">local_shipping</span> Đang giao
                    </span>
                </div>
                <p class="text-gray-500 text-sm">Thời gian đặt: 10:30 - 24/05/2026</p>
            </div>

            <div class="p-6 space-y-6 flex-1">
                <div class="bg-gray-50 rounded-2xl p-4 flex items-center gap-4">
                    <img src="https://i.pravatar.cc/150?u=customer99" class="w-12 h-12 rounded-full border border-gray-200">
                    <div class="flex-1">
                        <p class="text-gray-400 text-[10px] font-bold uppercase">Khách hàng</p>
                        <p class="font-bold text-gray-900">Nguyễn Văn A</p>
                    </div>
                    <button class="w-10 h-10 bg-green-500 text-white rounded-full flex items-center justify-center shadow-lg">
                        <span class="material-symbols-outlined">call</span>
                    </button>
                </div>

                <div class="relative pl-2">
                    <div class="absolute left-6 top-10 bottom-10 w-0.5 bg-gray-200"></div>
                    <div class="flex gap-4 mb-8 relative">
                        <div class="z-10 bg-gray-200 w-8 h-8 rounded-full flex items-center justify-center text-gray-500 mt-1">
                            <span class="material-symbols-outlined text-sm">storefront</span>
                        </div>
                        <div>
                            <p class="text-xs text-gray-400 font-bold uppercase">Điểm lấy hàng</p>
                            <p class="font-bold">Lapizzaria Center Point</p>
                            <p class="text-sm text-gray-500">45 Lê Lợi, Quận 1, TP.HCM</p>
                            <span class="mt-1 inline-block px-2 py-0.5 bg-green-100 text-green-700 text-[10px] font-bold rounded">Đã lấy xong</span>
                        </div>
                    </div>
                    <div class="flex gap-4 relative">
                        <div class="z-10 bg-orange-500 w-8 h-8 rounded-full flex items-center justify-center text-white mt-1 shadow-lg">
                            <span class="material-symbols-outlined text-sm">location_on</span>
                        </div>
                        <div class="bg-orange-50 p-4 rounded-xl flex-1 border border-orange-100">
                            <p class="text-xs text-orange-600 font-bold uppercase">Điểm giao hàng</p>
                            <p class="font-bold text-lg">Nhà riêng</p>
                            <p class="text-sm text-gray-600">123 Nguyễn Huệ, Quận 1, TP.HCM</p>
                            <div class="mt-2 text-[11px] bg-white p-2 rounded border border-orange-100 italic text-orange-700">"Gọi khi đến cổng số 2"</div>
                        </div>
                    </div>
                </div>

                <div>
                    <h3 class="font-bold text-gray-900 mb-4">Danh sách món ăn</h3>
                    <div class="space-y-4">
                        <div class="flex justify-between items-center text-sm">
                            <div class="flex gap-3">
                                <span class="w-8 h-8 bg-gray-100 rounded flex items-center justify-center font-bold">1x</span>
                                <div><p class="font-bold">Pizza Hải Sản Pesto</p><p class="text-xs text-gray-400">Cỡ L, Đế dày</p></div>
                            </div>
                            <span class="font-bold">250.000đ</span>
                        </div>
                        <div class="flex justify-between items-center text-sm">
                            <div class="flex gap-3">
                                <span class="w-8 h-8 bg-gray-100 rounded flex items-center justify-center font-bold">2x</span>
                                <div><p class="font-bold">Coca Cola (Lon)</p><p class="text-xs text-gray-400">Ướp lạnh</p></div>
                            </div>
                            <span class="font-bold">40.000đ</span>
                        </div>
                    </div>
                    <div class="mt-6 pt-4 border-t border-dashed flex justify-between items-center">
                        <p class="text-gray-400 font-bold">Tổng thu (COD)</p>
                        <p class="text-2xl font-black text-orange-600">290.000đ</p>
                    </div>
                </div>
            </div>

            <div class="p-4 border-t bg-white">
                <div class="grid grid-cols-2 gap-3 mb-3">
                    <button class="py-3 bg-gray-100 text-gray-400 rounded-xl font-bold text-sm" disabled>Đã lấy hàng</button>
                    <button class="py-3 bg-red-50 text-red-500 border border-red-100 rounded-xl font-bold text-sm">Hoàn trả đơn</button>
                </div>
                <button class="w-full py-4 bg-orange-500 text-white rounded-xl font-bold text-lg shadow-lg">Xác nhận Đã Giao Hàng</button>
            </div>
        </div>

        <div class="flex-1 relative bg-gray-200">
            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3919.458215161474!2d106.7011046759052!3d10.7761001591963!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31752f468494f1cb%3A0xa1993f3503b0c399!2zMTIzIE5ndXnhu4VuIEh14buHLCBC4bq_biBOZ2jDqSwgUXXhuq1uIDEsIEjhu5MgQ2jDrSBNaW5oLCBWaeG7h3QgTmFt!5e0!3m2!1svi!2s!4v1716518400000!5m2!1svi!2s"
                    width="100%"
                    height="100%"
                    style="border:0;"
                    allowfullscreen=""
                    loading="lazy">
            </iframe>

            <div class="absolute bottom-8 right-8 flex flex-col gap-2">
                <button class="w-12 h-12 bg-white rounded-xl shadow-lg flex items-center justify-center text-gray-700">
                    <span class="material-symbols-outlined">my_location</span>
                </button>
                <div class="bg-white rounded-xl shadow-lg flex flex-col">
                    <button class="w-12 h-12 flex items-center justify-center border-b border-gray-100"><span class="material-symbols-outlined">add</span></button>
                    <button class="w-12 h-12 flex items-center justify-center"><span class="material-symbols-outlined">remove</span></button>
                </div>
            </div>

            <div class="absolute bottom-8 left-8">
                <div class="bg-white/90 backdrop-blur-sm p-4 rounded-xl shadow-lg border border-orange-100 flex gap-3 max-w-xs">
                    <span class="material-symbols-outlined text-orange-500">info</span>
                    <div>
                        <p class="font-bold text-xs text-gray-900">Lưu ý giao thông</p>
                        <p class="text-[10px] text-gray-500 mt-1">Đường Nguyễn Huệ mật độ cao. Dự kiến trễ 5 phút.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>