@model LaPizzaria.ViewModels.ManageAccountViewModel
@using Microsoft.AspNetCore.Identity
@using LaPizzaria.ViewModels
@inject UserManager<LaPizzaria.Models.ApplicationUser> UserManager

@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    var user = await UserManager.GetUserAsync(User);
    var isShipper = user != null && await UserManager.IsInRoleAsync(user, "Shipper");
}

<div class="profile-container">
    <div class="container">
        <!-- Breadcrumb -->
        <nav class="profile-breadcrumb">
            <a asp-controller="Home" asp-action="Index">Trang chủ</a> / <span>Hồ sơ cá nhân</span>
        </nav>

        <div class="row g-4">
            <!-- Left Column: Sidebar -->
            <div class="col-lg-3">
                <div class="profile-card profile-sidebar">
                    <div class="profile-avatar-wrapper">
                        @await Html.PartialAsync("_UserAvatar", new UserAvatarViewModel
                        {
                            AvatarUrl = Model.AvatarUrl,
                            FirstName = Model.FirstName,
                            LastName = Model.LastName,
                            UserName = Model.UserName,
                            ElementClass = "profile-avatar",
                            ImgElementId = "avatarPreviewImg",
                            InitialElementId = "avatarPreviewInitial"
                        })
                        <div class="profile-rank-badge">
                            <i class="bi bi-star-fill" style="font-size: 10px;"></i>
                        </div>
                    </div>
                    <div class="profile-name">@Model.FirstName @Model.LastName</div>
                    <div class="profile-rank-text">Thành viên Vàng</div>

                    <ul class="profile-nav">
                        <li class="profile-nav-item">
                            <a href="#" class="profile-nav-link active">
                                Thông tin tài khoản
                            </a>
                        </li>
                        @if (isShipper)
                        {
                            <li class="profile-nav-item">
                                <a asp-controller="Shipper" asp-action="History" class="profile-nav-link">
                                    Lịch sử giao hàng
                                </a>
                            </li>
                            <li class="profile-nav-item">
                                <a href="#" class="profile-nav-link">
                                    Đánh giá đơn giao của khách hàng
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="profile-nav-item">
                                <a asp-controller="Order" asp-action="Index" class="profile-nav-link">
                                    Lịch sử đơn hàng
                                </a>
                            </li>
                            <li class="profile-nav-item">
                                <a href="#" class="profile-nav-link">
                                    Đánh giá của tôi
                                </a>
                            </li>
                            <li class="profile-nav-item">
                                <a href="#" class="profile-nav-link">
                                    Món yêu thích
                                </a>
                            </li>
                        }
                        <li class="profile-nav-item mt-4">
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="profile-nav-link logout border-0 bg-transparent w-100 text-start">
                                    Đăng xuất
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Right Column: Main Content -->
            <div class="col-lg-9">
                <div class="profile-card profile-main-content">
                    <div class="profile-header">
                        <h1 class="profile-title">Hồ sơ cá nhân</h1>
                        <p class="profile-subtitle">Quản lý thông tin hồ sơ của bạn để bảo mật tài khoản</p>
                    </div>

                    <form asp-action="Manage" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>
                        
                        <div class="row g-4">
                            <!-- Name Fields -->
                            <div class="col-md-6">
                                <label asp-for="FirstName" class="profile-form-label">Họ và tên đệm</label>
                                <input asp-for="FirstName" class="form-control profile-form-input" placeholder="Nhập họ và tên đệm" />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="LastName" class="profile-form-label">Tên</label>
                                <input asp-for="LastName" class="form-control profile-form-input" placeholder="Nhập tên" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>

                            <!-- Email and UserName -->
                            <div class="col-md-6">
                                <label asp-for="Email" class="profile-form-label">Email</label>
                                <input asp-for="Email" class="form-control profile-form-input" readonly />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="UserName" class="profile-form-label">Tên đăng nhập</label>
                                <input asp-for="UserName" class="form-control profile-form-input" placeholder="Nhập tên đăng nhập" />
                                <span asp-validation-for="UserName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PhoneNumber" class="profile-form-label">Số điện thoại</label>
                                <input asp-for="PhoneNumber" class="form-control profile-form-input" placeholder="Nhập số điện thoại" />
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>

                            <!-- Birthday and Gender -->
                            <div class="col-md-6">
                                <label asp-for="Birthday" class="profile-form-label">Ngày sinh</label>
                                <input asp-for="Birthday" type="date" class="form-control profile-form-input" />
                                <span asp-validation-for="Birthday" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="profile-form-label">Giới tính</label>
                                <div class="gender-radio-group">
                                    <label class="gender-radio-item">
                                        <input type="radio" asp-for="Gender" value="Nam" /> Nam
                                    </label>
                                    <label class="gender-radio-item">
                                        <input type="radio" asp-for="Gender" value="Nữ" /> Nữ
                                    </label>
                                    <label class="gender-radio-item">
                                        <input type="radio" asp-for="Gender" value="Khác" /> Khác
                                    </label>
                                </div>
                            </div>

                            <!-- Address -->
                            <div class="col-12">
                                <label asp-for="Address" class="profile-form-label">Địa chỉ nhận hàng mặc định</label>
                                <textarea asp-for="Address" class="form-control profile-form-input" rows="3" placeholder="Nhập địa chỉ của bạn"></textarea>
                                <span asp-validation-for="Address" class="text-danger small"></span>
                            </div>

                            <!-- Avatar upload -->
                            <div class="col-12">
                                <label class="profile-form-label" for="avatarFile">Ảnh đại diện</label>
                                <input type="hidden" asp-for="AvatarUrl" />
                                <input type="file" name="avatarFile" id="avatarFile" class="form-control profile-form-input" accept="image/jpeg,image/png,image/gif,image/webp,.jpg,.jpeg,.png,.gif,.webp" />
                                <small class="text-muted">Chọn ảnh từ máy (JPG, PNG, GIF, WebP), tối đa 2 MB. Ảnh xem trước bên trái khi chọn file.</small>
                            </div>

                            <hr class="my-4 opacity-5">

                            <!-- Password Section (Quick access) -->
                            <div class="col-12">
                                <h5 class="fw-bold mb-3" style="font-size: 1rem;">Thay đổi mật khẩu</h5>
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label asp-for="CurrentPassword" class="profile-form-label"></label>
                                        <input asp-for="CurrentPassword" class="form-control profile-form-input" type="password" />
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="NewPassword" class="profile-form-label"></label>
                                        <input asp-for="NewPassword" class="form-control profile-form-input" type="password" />
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="ConfirmNewPassword" class="profile-form-label"></label>
                                        <input asp-for="ConfirmNewPassword" class="form-control profile-form-input" type="password" />
                                    </div>
                                </div>
                            </div>

                            <!-- Action Buttons -->
                            <div class="col-12 mt-5 d-flex gap-3">
                                <button type="submit" class="btn-profile-save">Lưu thay đổi</button>
                                <a asp-controller="Home" asp-action="Index" class="btn-profile-cancel">Hủy bỏ</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var maxBytes = 2 * 1024 * 1024;
            var input = document.getElementById('avatarFile');
            var previewImg = document.getElementById('avatarPreviewImg');
            var previewInitial = document.getElementById('avatarPreviewInitial');
            if (!input || !previewImg) return;
            input.addEventListener('change', function () {
                var f = input.files && input.files[0];
                if (!f) return;
                if (f.size > maxBytes) {
                    alert('Ảnh tối đa 2 MB.');
                    input.value = '';
                    return;
                }
                var reader = new FileReader();
                reader.onload = function (ev) {
                    if (previewInitial) previewInitial.classList.add('d-none');
                    previewImg.classList.remove('d-none');
                    previewImg.src = ev.target.result;
                };
                reader.readAsDataURL(f);
            });
        })();
    </script>
}


