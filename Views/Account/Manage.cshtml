@model LaPizzaria.ViewModels.ManageAccountViewModel

@{
    ViewData["Title"] = "Quản lý tài khoản";
}

@section Styles {
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
}

<div class="lp-page-bg">
    <div class="container">
        <div class="lp-breadcrumb">
            <a asp-controller="Home" asp-action="Index">Trang chủ</a>
            <span class="sep">/</span>
            <span>Hồ sơ cá nhân</span>
        </div>
    </div>

    <div class="lp-profile-shell">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="lp-card lp-side-card">
                        <div class="lp-side-header">
                            <img id="avatarPreview" class="lp-avatar" src="@(string.IsNullOrWhiteSpace(Model.AvatarUrl) ? "/images/default-avatar.png" : Model.AvatarUrl)" alt="avatar" />
                            <div class="lp-member-tier">Thành viên</div>
                            <div class="lp-member-name">@Model.UserName</div>
                        </div>

                        <div class="lp-side-nav">
                            <a class="lp-side-link is-active" asp-controller="Account" asp-action="Manage">
                                <i class="bi bi-person"></i>
                                Thông tin tài khoản
                            </a>
                            <a class="lp-side-link" asp-controller="Order" asp-action="Index">
                                <i class="bi bi-receipt"></i>
                                Lịch sử đơn hàng
                            </a>
                            <a class="lp-side-link" href="#">
                                <i class="bi bi-star"></i>
                                Đánh giá của tôi
                            </a>
                            <a class="lp-side-link" href="#">
                                <i class="bi bi-heart"></i>
                                Món yêu thích
                            </a>
                        </div>

                        <div class="lp-side-footer">
                            <form id="logoutForm" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                                <button id="logout" type="submit" class="lp-danger-btn">
                                    <i class="bi bi-box-arrow-right"></i>
                                    Đăng xuất
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="col-lg-8">
                    <div class="lp-card lp-main-card">
                        <h1 class="lp-title">Hồ sơ cá nhân</h1>
                        <div class="lp-subtitle">Quản lý thông tin hồ sơ của bạn để bảo mật tài khoản</div>
                        <div class="lp-divider"></div>

                        <form asp-action="Manage" method="post">
                            <div class="lp-form-grid">
                                <div class="lp-field">
                                    <label asp-for="UserName"></label>
                                    <input asp-for="UserName" class="form-control" />
                                    <span asp-validation-for="UserName" class="text-danger"></span>
                                </div>

                                <div class="lp-field">
                                    <label>Tên hiển thị</label>
                                    <div class="d-flex gap-2">
                                        <input asp-for="FirstName" class="form-control" placeholder="Họ" />
                                        <input asp-for="LastName" class="form-control" placeholder="Tên" />
                                    </div>
                                </div>

                                <div class="lp-field" style="grid-column: 1 / -1;">
                                    <label asp-for="AvatarUrl"></label>
                                    <input asp-for="AvatarUrl" class="form-control" />
                                    <div class="lp-help">Dán URL ảnh (PNG/JPG). Ảnh sẽ hiển thị ở avatar.</div>
                                </div>
                            </div>

                            <div class="lp-divider"></div>

                            <div class="lp-form-grid">
                                <div class="lp-field">
                                    <label asp-for="CurrentPassword"></label>
                                    <input asp-for="CurrentPassword" class="form-control" />
                                </div>
                                <div></div>
                                <div class="lp-field">
                                    <label asp-for="NewPassword"></label>
                                    <input asp-for="NewPassword" class="form-control" />
                                </div>
                                <div class="lp-field">
                                    <label asp-for="ConfirmNewPassword"></label>
                                    <input asp-for="ConfirmNewPassword" class="form-control" />
                                </div>
                            </div>

                            <div class="lp-actions">
                                <button type="submit" class="lp-btn-primary">Lưu thay đổi</button>
                                <a asp-controller="Home" asp-action="Index" class="lp-btn-ghost">Hủy bỏ</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
const urlInput = document.getElementById('AvatarUrl');
const preview = document.getElementById('avatarPreview');
urlInput?.addEventListener('input', () => {
    const v = urlInput.value?.trim();
    preview.src = v || '/images/default-avatar.png';
});
</script>


