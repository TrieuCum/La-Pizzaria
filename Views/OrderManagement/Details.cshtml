@model LaPizzaria.Models.Order
@{
    ViewData["Title"] = "Chi tiết đơn hàng";
    var user = Model.User;
    var customerName = "—";
    var customerPhone = "—";
    var deliveryAddress = Model.DeliveryAddress;
    if (user != null)
    {
        customerName = $"{user.FirstName} {user.LastName}".Trim();
        if (string.IsNullOrWhiteSpace(customerName)) customerName = user.UserName ?? user.Email ?? "Khách hàng";
        customerPhone = !string.IsNullOrWhiteSpace(user.PhoneNumber) ? user.PhoneNumber : "—";
        if (string.IsNullOrWhiteSpace(deliveryAddress) && !string.IsNullOrWhiteSpace(user.Address)) deliveryAddress = user.Address;
    }
    if (string.IsNullOrWhiteSpace(deliveryAddress)) deliveryAddress = "—";
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
        .shipper-map {
            width: 100%;
            height: 400px;
            border-radius: 8px;
            border: 1px solid #dee2e6;
        }
    </style>
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
        <div>
            <h1 class="h4 fw-bold">Chi tiết đơn #ORD-@Model.Id</h1>
            <p class="text-secondary small mb-0">@customerName · @customerPhone</p>
        </div>
        <a asp-controller="OrderManagement" asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Quay lại</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6"><strong>Địa chỉ giao:</strong> @deliveryAddress</div>
                <div class="col-md-6"><strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</div>
                <div class="col-md-6"><strong>Trạng thái:</strong> <span class="badge bg-secondary">@Model.OrderStatus</span></div>
                <div class="col-md-6"><strong>Thanh toán:</strong> @(Model.PaymentMethod ?? "—")</div>
                <div class="col-12"><strong>Tổng tiền:</strong> <span class="text-danger fw-bold">@Model.TotalPrice.ToString("N0")₫</span></div>
                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <div class="col-12"><strong>Ghi chú:</strong> @Model.Notes</div>
                }
            </div>

            <h6 class="mt-4 mb-2">Chi tiết món</h6>
            <table class="table table-sm">
                <thead><tr><th>Món</th><th>SL</th><th>Đơn giá</th><th>Thành tiền</th></tr></thead>
                <tbody>
                    @if (Model.OrderDetails != null)
                    {
                        @foreach (var od in Model.OrderDetails)
                        {
                            <tr>
                                <td>@(od.Product?.Name ?? $"Món #${od.ProductId}")</td>
                                <td>@od.Quantity</td>
                                <td>@od.UnitPrice.ToString("N0")₫</td>
                                <td>@od.Subtotal.ToString("N0")₫</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

            <hr />
            <h6 class="mt-2 mb-2">Vị trí shipper</h6>
            <div id="shipperMapStatus" class="text-muted mb-2">Đang tải vị trí shipper...</div>
            <div id="shipperMap" class="shipper-map"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        (function () {
            const initialOrderStatus = '@(Model.OrderStatus ?? string.Empty)'.toLowerCase();
            const initialDeliveryStatus = '@(Model.DeliveryStatus ?? string.Empty)'.toLowerCase();
            const orderId = @Model.Id;
            const destinationLat = @(Model.Latitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "null");
            const destinationLng = @(Model.Longitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "null");
            const mapStatusEl = document.getElementById('shipperMapStatus');
            const mapEl = document.getElementById('shipperMap');
            if (!mapEl || !mapStatusEl) return;

            const destination = [destinationLat, destinationLng];
            const defaultCenter = Number.isFinite(destinationLat) && Number.isFinite(destinationLng)
                ? destination
                : [10.7769, 106.7009];
            const map = L.map('shipperMap').setView(defaultCenter, 13);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; OpenStreetMap'
            }).addTo(map);

            let shipperMarker = null;
            let customerMarker = null;
            let routeLine = null;
            let pollingTimer = null;
            const stopStatuses = ['completed', 'cancelled'];
            const stopDeliveryStatuses = ['delivered', 'failed'];

            const shouldStop = (orderStatus, deliveryStatus) => {
                return stopStatuses.includes((orderStatus || '').toLowerCase())
                    || stopDeliveryStatuses.includes((deliveryStatus || '').toLowerCase());
            };

            const haversineMeters = (a, b) => {
                const toRad = (v) => (v * Math.PI) / 180;
                const R = 6371000;
                const dLat = toRad(b[0] - a[0]);
                const dLng = toRad(b[1] - a[1]);
                const lat1 = toRad(a[0]);
                const lat2 = toRad(b[0]);
                const h = Math.sin(dLat / 2) ** 2
                    + Math.cos(lat1) * Math.cos(lat2) * Math.sin(dLng / 2) ** 2;
                return 2 * R * Math.asin(Math.sqrt(h));
            };

            const renderRoute = (currentPos, routePoints) => {
                const path = routePoints && routePoints.length > 1 ? routePoints : [currentPos, destination];
                if (!routeLine) {
                    routeLine = L.polyline(path, {
                        color: '#2563eb',
                        weight: 4,
                        opacity: 0.9
                    }).addTo(map);
                } else {
                    routeLine.setLatLngs(path);
                }

                if (!shipperMarker) {
                    shipperMarker = L.marker(currentPos).addTo(map).bindPopup('Shipper (giả lập)');
                } else {
                    shipperMarker.setLatLng(currentPos);
                }

                if (!customerMarker) {
                    customerMarker = L.marker(destination).addTo(map).bindPopup('Địa chỉ khách hàng');
                }

                map.fitBounds(L.latLngBounds(path), { padding: [30, 30] });
            };

            const decodePolyline = (encoded) => {
                const points = [];
                let index = 0;
                let lat = 0;
                let lng = 0;
                while (index < encoded.length) {
                    let shift = 0;
                    let result = 0;
                    let byte;
                    do {
                        byte = encoded.charCodeAt(index++) - 63;
                        result |= (byte & 0x1f) << shift;
                        shift += 5;
                    } while (byte >= 0x20);
                    const deltaLat = (result & 1) ? ~(result >> 1) : (result >> 1);
                    lat += deltaLat;

                    shift = 0;
                    result = 0;
                    do {
                        byte = encoded.charCodeAt(index++) - 63;
                        result |= (byte & 0x1f) << shift;
                        shift += 5;
                    } while (byte >= 0x20);
                    const deltaLng = (result & 1) ? ~(result >> 1) : (result >> 1);
                    lng += deltaLng;

                    points.push([lat / 1e5, lng / 1e5]);
                }
                return points;
            };

            const fetchOsrmRoute = async (fromPos) => {
                const url = `https://router.project-osrm.org/route/v1/driving/${fromPos[1]},${fromPos[0]};${destination[1]},${destination[0]}?overview=full&geometries=polyline`;
                const response = await fetch(url, { method: 'GET' });
                if (!response.ok) return null;
                const data = await response.json();
                if (!data || !data.routes || !data.routes.length || !data.routes[0].geometry) return null;
                return decodePolyline(data.routes[0].geometry);
            };

            const isDelivering = initialOrderStatus === 'delivering' || initialDeliveryStatus === 'delivering';
            const hasDestination = Number.isFinite(destinationLat) && Number.isFinite(destinationLng);
            if (!hasDestination) {
                mapStatusEl.textContent = 'Đơn chưa có tọa độ địa chỉ khách hàng nên chưa thể vẽ tuyến đường.';
                mapStatusEl.className = 'text-warning mb-2';
                return;
            }

            if (shouldStop(initialOrderStatus, initialDeliveryStatus)) {
                mapStatusEl.textContent = 'Đơn đã hoàn tất, không cần theo dõi vị trí.';
                mapStatusEl.className = 'text-muted mb-2';
                if (Number.isFinite(destinationLat) && Number.isFinite(destinationLng)) {
                    renderRoute(destination, [destination, destination]);
                }
                return;
            }

            if (!isDelivering) {
                mapStatusEl.textContent = 'Đơn chưa ở trạng thái đang giao.';
                mapStatusEl.className = 'text-warning mb-2';
                return;
            }

            const pollLocation = async () => {
                const response = await fetch(`/api/shipper/location?orderId=${orderId}`, { method: 'GET' });
                if (!response.ok) {
                    mapStatusEl.textContent = 'Không lấy được vị trí shipper.';
                    mapStatusEl.className = 'text-warning mb-2';
                    return;
                }
                const data = await response.json();
                if (!data || !Number.isFinite(data.latitude) || !Number.isFinite(data.longitude)) {
                    mapStatusEl.textContent = 'Shipper chưa bắt đầu chia sẻ vị trí.';
                    mapStatusEl.className = 'text-muted mb-2';
                    return;
                }

                const currentPos = [data.latitude, data.longitude];
                let routePoints = await fetchOsrmRoute(currentPos);
                if (!routePoints || routePoints.length < 2) {
                    routePoints = [currentPos, destination];
                }
                renderRoute(currentPos, routePoints);
                const leftKm = (haversineMeters(currentPos, destination) / 1000).toFixed(2);
                mapStatusEl.textContent = `Vị trí shipper cập nhật realtime, còn khoảng ${leftKm} km.`;
                mapStatusEl.className = 'text-success mb-2';
            };

            pollLocation();
            pollingTimer = setInterval(pollLocation, 5000);
            window.addEventListener('beforeunload', () => {
                if (pollingTimer) clearInterval(pollingTimer);
            });
        })();
    </script>
}
