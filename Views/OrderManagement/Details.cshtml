@model LaPizzaria.Models.Order
@{
    ViewData["Title"] = "Chi tiết đơn hàng";
    var user = Model.User;
    var customerName = "—";
    var customerPhone = "—";
    var deliveryAddress = Model.DeliveryAddress;
    if (user != null)
    {
        customerName = $"{user.FirstName} {user.LastName}".Trim();
        if (string.IsNullOrWhiteSpace(customerName)) customerName = user.UserName ?? user.Email ?? "Khách hàng";
        customerPhone = !string.IsNullOrWhiteSpace(user.PhoneNumber) ? user.PhoneNumber : "—";
        if (string.IsNullOrWhiteSpace(deliveryAddress) && !string.IsNullOrWhiteSpace(user.Address)) deliveryAddress = user.Address;
    }
    if (string.IsNullOrWhiteSpace(deliveryAddress)) deliveryAddress = "—";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
        <div>
            <h1 class="h4 fw-bold">Chi tiết đơn #ORD-@Model.Id</h1>
            <p class="text-secondary small mb-0">@customerName · @customerPhone</p>
        </div>
        <a asp-controller="OrderManagement" asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Quay lại</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6"><strong>Địa chỉ giao:</strong> @deliveryAddress</div>
                <div class="col-md-6"><strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</div>
                <div class="col-md-6"><strong>Trạng thái:</strong> <span class="badge bg-secondary">@Model.OrderStatus</span></div>
                <div class="col-md-6"><strong>Thanh toán:</strong> @(Model.PaymentMethod ?? "—")</div>
                <div class="col-12"><strong>Tổng tiền:</strong> <span class="text-danger fw-bold">@Model.TotalPrice.ToString("N0")₫</span></div>
                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <div class="col-12"><strong>Ghi chú:</strong> @Model.Notes</div>
                }
            </div>

            <h6 class="mt-4 mb-2">Chi tiết món</h6>
            <table class="table table-sm">
                <thead><tr><th>Món</th><th>SL</th><th>Đơn giá</th><th>Thành tiền</th></tr></thead>
                <tbody>
                    @if (Model.OrderDetails != null)
                    {
                        @foreach (var od in Model.OrderDetails)
                        {
                            <tr>
                                <td>@(od.Product?.Name ?? $"Món #${od.ProductId}")</td>
                                <td>@od.Quantity</td>
                                <td>@od.UnitPrice.ToString("N0")₫</td>
                                <td>@od.Subtotal.ToString("N0")₫</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

            <hr class="my-4" />
            <h6 class="mb-2">Theo dõi shipper</h6>
            <div id="shipperMap" style="height:400px;border-radius:12px;"></div>
            <p id="shipperMapStatus" class="text-muted small mt-2 mb-0">Đang tải vị trí shipper...</p>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
}

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        (function () {
            const orderId = @Model.Id;
            const statusEl = document.getElementById('shipperMapStatus');
            const map = L.map('shipperMap').setView([10.7769, 106.7009], 12);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; OpenStreetMap'
            }).addTo(map);

            let shipperMarker = null;
            let customerMarker = null;
            let routeLine = null;
            let timer = null;
            let routeLatLngs = null;
            let routeCumDistances = null;

            function buildRouteDistances(latlngs) {
                const d = [0];
                for (let i = 1; i < latlngs.length; i++) d.push(d[i - 1] + map.distance(latlngs[i - 1], latlngs[i]));
                return d;
            }
            function pointAtProgress(latlngs, cum, progress) {
                if (!latlngs || !cum || !latlngs.length) return null;
                if (progress <= 0) return latlngs[0];
                if (progress >= 1) return latlngs[latlngs.length - 1];
                const total = cum[cum.length - 1];
                const target = total * progress;
                let i = 1;
                while (i < cum.length && cum[i] < target) i++;
                if (i >= cum.length) return latlngs[latlngs.length - 1];
                const a = latlngs[i - 1], b = latlngs[i];
                const seg = cum[i] - cum[i - 1] || 1;
                const t = (target - cum[i - 1]) / seg;
                return [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t];
            }

            async function drawRoute(fromLat, fromLng, toLat, toLng) {
                try {
                    const res = await fetch(`https://router.project-osrm.org/route/v1/driving/${fromLng},${fromLat};${toLng},${toLat}?overview=full&geometries=geojson`);
                    const data = await res.json();
                    const coords = data?.routes?.[0]?.geometry?.coordinates;
                    if (!coords || !coords.length) return;
                    const line = coords.map(c => [c[1], c[0]]);
                    if (routeLine) map.removeLayer(routeLine);
                    routeLine = L.polyline(line, { color: '#f97316', weight: 5 }).addTo(map);
                } catch { }
            }

            async function tick() {
                try {
                    const res = await fetch(`/api/shipper/location?orderId=${orderId}`, { credentials: 'same-origin' });
                    if (!res.ok) {
                        statusEl.textContent = 'Không tải được vị trí shipper.';
                        return;
                    }
                    const data = await res.json();
                    if (!data.hasShipper) {
                        statusEl.textContent = 'Đơn hàng chưa có shipper.';
                        return;
                    }
                    if (data.latitude == null || data.longitude == null) {
                        statusEl.textContent = 'Shipper chưa bắt đầu giao.';
                        return;
                    }

                    const shipPos = [data.latitude, data.longitude];
                    let displayPos = shipPos;
                    if (!shipperMarker) shipperMarker = L.marker(shipPos).addTo(map).bindPopup('Shipper đang giao hàng');
                    else shipperMarker.setLatLng(displayPos);

                    if (data.destinationLatitude != null && data.destinationLongitude != null) {
                        const destPos = [data.destinationLatitude, data.destinationLongitude];
                        if (!customerMarker) customerMarker = L.marker(destPos).addTo(map).bindPopup('Khách hàng');
                        else customerMarker.setLatLng(destPos);
                        if (!routeLatLngs) {
                            await drawRoute(data.originLatitude ?? data.latitude, data.originLongitude ?? data.longitude, data.destinationLatitude, data.destinationLongitude);
                            if (routeLine) {
                                routeLatLngs = routeLine.getLatLngs().map(x => [x.lat, x.lng]);
                                routeCumDistances = buildRouteDistances(routeLatLngs);
                            }
                        }
                        if (routeLatLngs && data.simulationProgress != null) {
                            const p = pointAtProgress(routeLatLngs, routeCumDistances, data.simulationProgress);
                            if (p) {
                                displayPos = p;
                                shipperMarker.setLatLng(displayPos);
                            }
                        }
                        map.fitBounds(L.latLngBounds([displayPos, destPos]), { padding: [40, 40] });
                    } else {
                        map.setView(displayPos, 15);
                    }

                    statusEl.textContent = data.isDelivering ? 'Đang giao hàng - cập nhật mỗi 5 giây.' : 'Đơn chưa ở trạng thái giao.';
                    if (!data.isDelivering && timer) {
                        clearInterval(timer);
                        timer = null;
                    }
                } catch {
                    statusEl.textContent = 'Lỗi kết nối khi tải vị trí.';
                }
            }

            tick();
            timer = setInterval(tick, 5000);
            window.addEventListener('beforeunload', function () {
                if (timer) clearInterval(timer);
            });
        })();
    </script>
}
