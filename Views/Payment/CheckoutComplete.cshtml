@{
    ViewData["Title"] = "Đặt hàng thành công";
    var orderId = ViewBag.OrderId as int? ?? 0;
}

<div class="container py-5" style="max-width: 640px;">
    <div class="text-center mb-4">
        <div class="rounded-circle bg-success bg-opacity-10 text-success d-inline-flex align-items-center justify-content-center mb-3" style="width: 72px; height: 72px;">
            <i class="bi bi-check-lg fs-1"></i>
        </div>
        <h1 class="h4 mb-2">Thanh toán MoMo thành công</h1>
        <p class="text-muted small mb-0">Đơn hàng của bạn đã được ghi nhận.</p>
    </div>

    <div class="brand-card p-4 bg-white shadow-sm rounded-4 mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <span class="text-muted">Mã đơn</span>
            <span class="fw-bold fs-5 text-brand-orange">#@orderId</span>
        </div>
    </div>

    <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center">
        <a asp-controller="Order" asp-action="Details" asp-route-id="@orderId" class="btn btn-brand-primary rounded-pill px-4">Xem chi tiết đơn</a>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Về trang chủ</a>
    </div>
</div>
