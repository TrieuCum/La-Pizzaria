@model IEnumerable<LaPizzaria.Models.Ingredient>
@{
    var product = ViewBag.Product as LaPizzaria.Models.Product;
    var mapping = ViewBag.Mapping as List<LaPizzaria.Models.ProductIngredient> ?? new List<LaPizzaria.Models.ProductIngredient>();
    ViewData["Title"] = $"Nguyên liệu cho: {product?.Name}";
    Layout = "_Layout";
}

<style>
    .ingredient-header {
        background: white;
        border-radius: 16px;
        padding: 32px 40px;
        margin-bottom: 30px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.02);
    }
    .ingredient-title {
        font-weight: 900;
        font-size: 28px;
        color: rgba(24,20,17,1);
        margin: 0 0 8px 0;
    }
    .ingredient-subtitle {
        font-size: 14px;
        color: rgba(107,114,128,1);
        margin: 0;
    }
    .ingredient-card {
        background: white;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.02);
        margin-bottom: 30px;
    }
    .ingredient-table {
        width: 100%;
        border-collapse: collapse;
    }
    .ingredient-table thead {
        background: rgba(249,250,251,1);
        border-bottom: 1px solid #f1f5f9;
    }
    .ingredient-table th {
        padding: 16px 24px;
        text-align: left;
        color: rgba(107,114,128,1);
        font-weight: 700;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .ingredient-table td {
        padding: 20px 24px;
        border-bottom: 1px solid #f1f5f9;
        vertical-align: middle;
    }
    .ingredient-table tbody tr:last-child td {
        border-bottom: none;
    }
    .ingredient-name {
        font-weight: 600;
        font-size: 14px;
        color: rgba(24,20,17,1);
        margin-bottom: 4px;
    }
    .ingredient-meta {
        font-size: 12px;
        color: rgba(107,114,128,1);
    }
    .stock-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(240,253,244,1);
        color: rgba(22,163,74,1);
        padding: 4px 12px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: 600;
    }
    .stock-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: rgba(34,197,94,1);
    }
    .quantity-input {
        border: 2px solid #e5e7eb;
        border-radius: 10px;
        padding: 10px 16px;
        font-size: 14px;
        font-weight: 600;
        color: rgba(24,20,17,1);
        width: 100%;
        max-width: 200px;
        transition: all 0.2s;
    }
    .quantity-input:focus {
        outline: none;
        border-color: rgba(244,140,37,1);
        box-shadow: 0 0 0 3px rgba(244,140,37,0.1);
    }
    .action-buttons {
        display: flex;
        gap: 12px;
        padding: 0 40px 32px 40px;
    }
    .btn-save {
        background: rgba(244,140,37,1);
        color: white;
        border: none;
        border-radius: 12px;
        padding: 12px 32px;
        font-weight: 700;
        font-size: 15px;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .btn-save:hover {
        background: #e67a15;
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(244,140,37,0.3);
    }
    .btn-cancel {
        background: white;
        color: rgba(107,114,128,1);
        border: 2px solid #e5e7eb;
        border-radius: 12px;
        padding: 10px 32px;
        font-weight: 700;
        font-size: 15px;
        text-decoration: none;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .btn-cancel:hover {
        background: rgba(249,250,251,1);
        border-color: rgba(107,114,128,1);
        color: rgba(75,85,99,1);
    }
</style>

<div class="container" style="padding: 40px 0;">
    <div class="ingredient-header">
        <h1 class="ingredient-title">
            <i class="bi bi-clipboard-check" style="color: rgba(244,140,37,1);"></i>
            Quản lý nguyên liệu
        </h1>
        <p class="ingredient-subtitle">
            Cấu hình nguyên liệu cần thiết cho món: <strong>@product?.Name</strong>
        </p>
    </div>

    <form asp-action="SaveIngredients" method="post">
        <input type="hidden" name="productId" value="@product?.Id" />
        
        <div class="ingredient-card">
            <table class="ingredient-table">
                <thead>
                    <tr>
                        <th style="width: 45%;">Tên nguyên liệu</th>
                        <th style="width: 25%;">Tồn kho</th>
                        <th style="width: 30%;">Số lượng / 1 món</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var ing in Model)
                {
                    var row = mapping.FirstOrDefault(m => m.IngredientId == ing.Id);
                    <tr>
                        <td>
                            <input type="hidden" name="ingredientId" value="@ing.Id" />
                            <div class="ingredient-name">@ing.Name</div>
                            <div class="ingredient-meta">Đơn vị: @ing.Unit</div>
                        </td>
                        <td>
                            <span class="stock-badge">
                                <span class="stock-dot"></span>
                                @ing.StockQuantity @ing.Unit
                            </span>
                        </td>
                        <td>
                            <input type="number" 
                                   class="quantity-input" 
                                   name="quantityPerUnit" 
                                   value="@(row?.QuantityPerUnit ?? 0)" 
                                   min="0" 
                                   step="0.01"
                                   placeholder="0.00" />
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="action-buttons">
            <button type="submit" class="btn-save">
                <i class="bi bi-check-circle-fill"></i>
                Lưu thay đổi
            </button>
            <a asp-action="Index" class="btn-cancel">
                <i class="bi bi-x-circle"></i>
                Hủy bỏ
            </a>
        </div>
    </form>
</div>
