@model LaPizzaria.ViewModels.ProductViewModel
@using LaPizzaria.Models
@{
    ViewData["Title"] = Model.Id == 0 ? "Thêm Món ăn Mới" : "Sửa Món ăn";
    var ingredientPageSize = (int?)(ViewBag.IngredientPageSize) ?? 20;
    var ingCats = ViewBag.IngredientCategoryTabs as List<IngredientCategory> ?? new List<IngredientCategory>();
}

<div class="product-upsert-wrapper">
    <div class="container-fluid px-4 py-4">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="fw-black h3 m-0 text-brand-dark">@(Model.Id == 0 ? "Thêm Món ăn Mới" : "Sửa Món ăn")</h1>
                <p class="text-brand-gray small m-0">Quản lý thông tin chi tiết và định lượng nguyên liệu món ăn.</p>
            </div>
            <a asp-action="Index" class="btn btn-light-glass border-0 rounded-pill px-4 py-2 small fw-bold">
                <i class="bi bi-arrow-left me-2"></i> Quay lại danh sách
            </a>
        </div>

        <form asp-action="Upsert" method="post" id="upsertForm">
            <input type="hidden" asp-for="Id" />
            
            <div class="row g-4">
                <!-- Left Column: Product Details -->
                <div class="col-lg-5">
                    <div class="upsert-card h-100">
                        <div class="card-header-v">
                            <i class="bi bi-info-circle-fill"></i> Thông tin cơ bản
                        </div>
                        <div class="card-body-v">
                            <!-- Image Preview Area -->
                            <div class="image-preview-container mb-4">
                                <div class="preview-box" id="imagePreviewBox">
                                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                    {
                                        <img src="@Model.ImageUrl" id="previewImg" class="img-fluid rounded-3 shadow-sm" onerror="this.src='/images/placeholder-pizza.png'; this.classList.add('opacity-50')">
                                    }
                                    else
                                    {
                                        <div class="preview-placeholder">
                                            <i class="bi bi-image fs-1 opacity-25"></i>
                                            <p class="small text-muted mt-2">Chưa có hình ảnh</p>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="form-group-v mb-3">
                                <label asp-for="Name" class="form-label-v">Tên món ăn <span class="text-danger">*</span></label>
                                <input asp-for="Name" class="form-control-v" placeholder="VD: Pizza Hải Sản">
                                <span asp-validation-for="Name" class="text-danger extra-small"></span>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <div class="form-group-v">
                                        <label asp-for="ProfitMarginPercent" class="form-label-v">% Tiền lời (trên giá vốn)</label>
                                        <input asp-for="ProfitMarginPercent" type="number" step="0.1" min="0" max="500" class="form-control-v" id="profitMarginInput">
                                        <small class="text-muted extra-small d-block mt-1">Giá bán = Giá vốn × (1 + %/100)</small>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group-v">
                                        <label class="form-label-v">Giá vốn (ước tính)</label>
                                        <input type="text" class="form-control-v" readonly id="costPreview" value="0₫">
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group-v">
                                        <label asp-for="Price" class="form-label-v">Giá bán (₫)</label>
                                        <input asp-for="Price" type="number" class="form-control-v" placeholder="0" readonly id="priceInput">
                                        <span asp-validation-for="Price" class="text-danger extra-small"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <div class="form-group-v">
                                        <label asp-for="Category" class="form-label-v">Danh mục món <span class="text-danger">*</span></label>
                                        <select asp-for="Category" class="form-select-v">
                                            <option value="">-- Chọn danh mục --</option>
                                            <option value="Pizza">Pizza</option>
                                            <option value="Drink">Đồ uống</option>
                                            <option value="Side Dish">Món phụ</option>
                                            <option value="Combo">Combo</option>
                                        </select>
                                        <span asp-validation-for="Category" class="text-danger extra-small"></span>
                                    </div>
                                </div>
                                <div class="col-md-6 d-flex align-items-end">
                                    <div class="form-check-v mb-2">
                                        <input asp-for="IsSlowSeller" class="check-input-v" type="checkbox" id="slowSellerCheck">
                                        <label class="check-label-v" for="slowSellerCheck">Món bán chậm (dùng khuyến mãi upsale)</label>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group-v mb-3">
                                <label asp-for="ImageUrl" class="form-label-v">URL Hình ảnh</label>
                                <div class="input-group-v">
                                    <span class="input-icon"><i class="bi bi-link-45deg"></i></span>
                                    <input asp-for="ImageUrl" class="form-control-v with-icon" placeholder="https://..." id="imageUrlInput">
                                </div>
                                <span asp-validation-for="ImageUrl" class="text-danger extra-small"></span>
                            </div>

                            <div class="form-group-v mb-4">
                                <label asp-for="Description" class="form-label-v">Mô tả món ăn</label>
                                <textarea asp-for="Description" class="form-control-v" rows="4" placeholder="Nhập mô tả ngắn về món ăn..."></textarea>
                                <span asp-validation-for="Description" class="text-danger extra-small"></span>
                            </div>

                            <div class="d-flex gap-4">
                                <div class="form-check-v">
                                    <input asp-for="IsActive" class="check-input-v" type="checkbox" id="isActiveCheck">
                                    <label class="check-label-v" for="isActiveCheck">Đang kinh doanh</label>
                                </div>
                                <div class="form-check-v">
                                    <input asp-for="IsCustomizable" class="check-input-v" type="checkbox" id="isCustCheck">
                                    <label class="check-label-v" for="isCustCheck">Cho phép thêm Topping</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Ingredient Selection -->
                <div class="col-lg-7">
                    <div class="upsert-card h-100 d-flex flex-column">
                        <div class="card-header-v d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-basket3-fill"></i> Định lượng nguyên liệu</span>
                            <div class="search-box-v">
                                <i class="bi bi-search"></i>
                                <input type="text" id="ingSearch" placeholder="Tìm nguyên liệu...">
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <label for="ingPageSize" class="extra-small text-brand-gray fw-bold m-0">Hiển thị:</label>
                                <select id="ingPageSize" class="form-select-v py-1 px-2" style="width: 90px;">
                                    <option value="10" selected="@(ingredientPageSize == 10)">10</option>
                                    <option value="20" selected="@(ingredientPageSize == 20)">20</option>
                                    <option value="50" selected="@(ingredientPageSize == 50)">50</option>
                                    <option value="100" selected="@(ingredientPageSize == 100)">100</option>
                                </select>
                            </div>
                        </div>
                        <div class="card-body-v flex-grow-1 overflow-hidden d-flex flex-column">
                            <p class="text-brand-gray extra-small mb-2">Định lượng cho <strong>1 phần (size M)</strong>. Giá nguyên liệu × số lượng = thành tiền dòng.</p>
                            <div class="mb-3 d-flex flex-wrap gap-2 align-items-center" id="ingCategoryTabs">
                                <button type="button" class="btn btn-sm rounded-pill ing-cat-tab active" data-cat="all" style="border:1px solid #e5e7eb;background:#fff;">Tất cả</button>
                                <button type="button" class="btn btn-sm rounded-pill ing-cat-tab" data-cat="0" style="border:1px solid #e5e7eb;background:#fff;">Khác</button>
                                @foreach (var c in ingCats)
                                {
                                    <button type="button" class="btn btn-sm rounded-pill ing-cat-tab" data-cat="@c.Id" style="border:1px solid #e5e7eb;background:#fff;">@c.Name</button>
                                }
                            </div>
                            <div class="ingredients-list-container flex-grow-1 overflow-auto pe-2">
                                <table class="table-v">
                                    <thead>
                                        <tr>
                                            <th>Nguyên liệu</th>
                                            <th class="text-center">Nhóm</th>
                                            <th class="text-center">Đơn vị</th>
                                            <th class="text-end">Giá / đơn vị</th>
                                            <th class="text-center">Tồn kho</th>
                                            <th class="text-end" style="width: 110px;">SL / phần</th>
                                            <th class="text-end">Thành tiền</th>
                                        </tr>
                                    </thead>
                                    <tbody id="ingTableBody">
                                        @for (int i = 0; i < Model.Ingredients.Count; i++)
                                        {
                                            <tr class="ing-row"
                                                data-name="@Model.Ingredients[i].Name.ToLower()"
                                                data-cat="@(Model.Ingredients[i].CategoryId?.ToString() ?? "0")"
                                                data-unit-price="@Model.Ingredients[i].UnitPrice"
                                                data-is-dough="@(Model.Ingredients[i].IsDoughBase ? "1" : "0")">
                                                <td>
                                                    <input type="hidden" asp-for="@Model.Ingredients[i].IngredientId" />
                                                    <input type="hidden" asp-for="@Model.Ingredients[i].Name" />
                                                    <input type="hidden" asp-for="@Model.Ingredients[i].Unit" />
                                                    <input type="hidden" asp-for="@Model.Ingredients[i].UnitPrice" />
                                                    <input type="hidden" asp-for="@Model.Ingredients[i].IsDoughBase" />
                                                    <div class="fw-bold text-brand-dark small">@Model.Ingredients[i].Name</div>
                                                    <div class="extra-small text-brand-gray">ID: ING-@Model.Ingredients[i].IngredientId.ToString("D3")</div>
                                                </td>
                                                <td class="text-center">
                                                    <span class="extra-small text-brand-gray">@Model.Ingredients[i].CategoryDisplayPath</span>
                                                </td>
                                                <td class="text-center">
                                                    <span class="badge bg-light text-brand-gray border py-1 px-2 fw-bold extra-small">@Model.Ingredients[i].Unit</span>
                                                </td>
                                                <td class="text-end">
                                                    <span class="small fw-bold text-brand-orange">@Model.Ingredients[i].UnitPrice.ToString("N0")₫</span>
                                                </td>
                                                <td class="text-center">
                                                    <span class="small fw-bold @(Model.Ingredients[i].StockQuantity < 10 ? "text-danger" : "text-brand-dark")">
                                                        @Model.Ingredients[i].StockQuantity.ToString("N1")
                                                    </span>
                                                </td>
                                                <td class="text-end">
                                                    <input type="number" asp-for="@Model.Ingredients[i].QuantityPerUnit" 
                                                           class="form-control-v form-control-sm text-end fw-bold ing-qty-input @(Model.Ingredients[i].QuantityPerUnit > 0 ? "active" : "")" 
                                                           step="0.01" min="0" placeholder="0.00" />
                                                </td>
                                                <td class="text-end">
                                                    <span class="small fw-bold ing-line-total text-brand-dark">0₫</span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="px-4 pb-3 d-flex justify-content-end">
                            <div id="ingredientPagination" class="d-flex gap-2"></div>
                        </div>
                        <div class="card-footer-v bg-light border-top p-4 d-flex justify-content-between align-items-center">
                            <div class="selected-count extra-small fw-bold text-brand-orange" id="selectedCount">
                                0 nguyên liệu được chọn
                            </div>
                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-brand-orange rounded-pill px-5 py-2 fw-black shadow-sm transition-all hover-scale">
                                    <i class="bi bi-check2-circle me-2"></i> Lưu dữ liệu
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<style>
    :root {
        --brand-orange: #f48c25;
        --brand-bg: #f8f7f5;
        --brand-dark: #181411;
        --brand-gray: #6b7280;
        --brand-light: #f3f4f6;
    }

    .product-upsert-wrapper {
        background-color: var(--brand-bg);
        min-height: 100vh;
        font-family: 'Work Sans', sans-serif;
    }

    .fw-black { font-weight: 900; }

    .upsert-card {
        background: white;
        border-radius: 24px;
        border: 1px solid rgba(0,0,0,0.05);
        box-shadow: 0 10px 30px rgba(0,0,0,0.02);
        overflow: hidden;
    }

    .card-header-v {
        padding: 20px 24px;
        background: #fafafb;
        border-bottom: 1px solid #f1f5f9;
        font-weight: 900;
        color: var(--brand-dark);
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .card-body-v { padding: 24px; }

    .form-label-v {
        display: block;
        font-size: 0.75rem;
        font-weight: 800;
        color: var(--brand-gray);
        margin-bottom: 6px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .form-control-v, .form-select-v {
        width: 100%;
        padding: 12px 16px;
        background: var(--brand-light);
        border: 2px solid transparent;
        border-radius: 12px;
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--brand-dark);
        transition: all 0.2s;
    }

    .form-control-v:focus, .form-select-v:focus {
        background: white;
        border-color: var(--brand-orange);
        box-shadow: 0 0 0 4px rgba(244, 140, 37, 0.1);
        outline: none;
    }

    .input-group-v { position: relative; }
    .input-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--brand-gray);
        font-size: 1.1rem;
        z-index: 5;
    }
    .form-control-v.with-icon { padding-left: 42px; }

    .form-check-v {
        display: flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
    }

    .check-input-v {
        width: 20px;
        height: 20px;
        border-radius: 6px;
        border: 2px solid #d1d5db;
        cursor: pointer;
        appearance: none;
        transition: all 0.2s;
        position: relative;
    }

    .check-input-v:checked {
        background-color: var(--brand-orange);
        border-color: var(--brand-orange);
    }

    .check-input-v:checked::after {
        content: "\F26E";
        font-family: "bootstrap-icons";
        position: absolute;
        color: white;
        font-size: 12px;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
    }

    .check-label-v {
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--brand-dark);
        cursor: pointer;
    }

    /* Image Preview */
    .image-preview-container {
        width: 100%;
        aspect-ratio: 16/9;
    }
    .preview-box {
        width: 100%;
        height: 100%;
        background: var(--brand-light);
        border-radius: 16px;
        border: 2px dashed #d1d5db;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }
    .preview-placeholder { text-align: center; }
    #previewImg { width: 100%; height: 100%; object-fit: cover; }

    /* Ingredients Table */
    .search-box-v {
        position: relative;
        width: 220px;
    }
    .search-box-v i {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--brand-gray);
        font-size: 0.8rem;
    }
    .search-box-v input {
        width: 100%;
        padding: 6px 12px 6px 32px;
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .table-v { width: 100%; }
    .table-v th {
        padding: 12px 16px;
        font-size: 0.65rem;
        font-weight: 900;
        color: var(--brand-gray);
        text-transform: uppercase;
        border-bottom: 1px solid #f1f5f9;
        background: white;
        position: sticky;
        top: 0;
        z-index: 10;
    }
    .table-v td {
        padding: 14px 16px;
        border-bottom: 1px solid #f8fafc;
        vertical-align: middle;
    }
    .ing-row:hover { background: #fafafb; }

    .ing-qty-input.active {
        background: #fff8f1;
        border-color: var(--brand-orange);
    }

    .btn-brand-orange {
        background-color: var(--brand-orange);
        color: white;
        border: none;
    }
    .btn-brand-orange:hover {
        background-color: #e67a15;
        color: white;
        transform: translateY(-2px);
    }

    .btn-light-glass {
        background: rgba(255,255,255,0.8);
        backdrop-filter: blur(4px);
        color: var(--brand-gray);
    }
    .btn-light-glass:hover {
        background: white;
        color: var(--brand-dark);
    }

    .hover-scale:hover { transform: scale(1.02); }
    .transition-all { transition: all 0.3s ease; }
    .extra-small { font-size: 0.7rem; }
    #ingCategoryTabs .ing-cat-tab.active {
        background: var(--brand-orange) !important;
        color: white !important;
        border-color: var(--brand-orange) !important;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            // Image Preview logic
            const $urlInput = $('#imageUrlInput');
            const $previewBox = $('#imagePreviewBox');

            function updatePreview(url) {
                if (url && url.length > 5) {
                    let sanitizedUrl = url;
                    if (url.startsWith("file:///")) {
                         const parts = url.split('/');
                         sanitizedUrl = "/images/" + parts[parts.length - 1];
                    }
                    
                    $previewBox.html(`<img src="${sanitizedUrl}" id="previewImg" class="img-fluid rounded-3 shadow-sm" onerror="handleImageError(this)">`);
                } else {
                    $previewBox.html(`
                        <div class="preview-placeholder">
                            <i class="bi bi-image fs-1 opacity-25"></i>
                            <p class="small text-muted mt-2">Chưa có hình ảnh</p>
                        </div>
                    `);
                }
            }

            window.handleImageError = function(el) {
                $(el).attr('src', '/images/placeholder-pizza.png').addClass('opacity-50');
            };

            $urlInput.on('input', function() {
                updatePreview($(this).val().trim());
            });

            // Ingredient Search logic
            const $ingRows = $('.ing-row');
            const $pageSize = $('#ingPageSize');
            const $pagination = $('#ingredientPagination');
            let currentIngPage = 1;
            let activeCat = 'all';

            $('#ingCategoryTabs').on('click', '.ing-cat-tab', function () {
                $('#ingCategoryTabs .ing-cat-tab').removeClass('active');
                $(this).addClass('active');
                activeCat = $(this).data('cat').toString();
                currentIngPage = 1;
                renderIngredientPaging();
            });

            function getFilteredRows() {
                const q = $('#ingSearch').val().toLowerCase();
                return $ingRows.filter(function() {
                    const name = ($(this).data('name') || '').toString();
                    if (name.indexOf(q) === -1) return false;
                    const cat = ($(this).data('cat') || '0').toString();
                    if (activeCat === 'all') return true;
                    return cat === activeCat;
                });
            }

            function renderIngredientPaging() {
                const filtered = getFilteredRows();
                const pageSize = parseInt($pageSize.val(), 10) || 20;
                const total = filtered.length;
                const totalPages = Math.max(1, Math.ceil(total / pageSize));
                if (currentIngPage > totalPages) currentIngPage = totalPages;

                $ingRows.hide();
                const start = (currentIngPage - 1) * pageSize;
                filtered.slice(start, start + pageSize).show();

                $pagination.empty();
                if (totalPages <= 1) return;

                const prevDisabled = currentIngPage <= 1 ? 'disabled' : '';
                $pagination.append(`<button type="button" class="btn btn-sm btn-light" data-page="prev" ${prevDisabled}>Trước</button>`);
                for (let p = 1; p <= totalPages; p++) {
                    const cls = p === currentIngPage ? 'btn btn-sm btn-brand-orange' : 'btn btn-sm btn-light';
                    $pagination.append(`<button type="button" class="${cls}" data-page="${p}">${p}</button>`);
                }
                const nextDisabled = currentIngPage >= totalPages ? 'disabled' : '';
                $pagination.append(`<button type="button" class="btn btn-sm btn-light" data-page="next" ${nextDisabled}>Sau</button>`);
            }

            $('#ingSearch').on('input', function() {
                currentIngPage = 1;
                renderIngredientPaging();
            });

            $pageSize.on('change', function() {
                currentIngPage = 1;
                renderIngredientPaging();
            });

            $pagination.on('click', 'button', function() {
                const page = $(this).data('page').toString();
                const filtered = getFilteredRows();
                const pageSize = parseInt($pageSize.val(), 10) || 20;
                const totalPages = Math.max(1, Math.ceil(filtered.length / pageSize));
                if (page === 'prev' && currentIngPage > 1) currentIngPage--;
                else if (page === 'next' && currentIngPage < totalPages) currentIngPage++;
                else if (!Number.isNaN(parseInt(page, 10))) currentIngPage = parseInt(page, 10);
                renderIngredientPaging();
            });

            // Selected count tracking
            function updateSelectedCount() {
                const count = $('.ing-qty-input').filter(function() {
                    return parseFloat($(this).val()) > 0;
                }).length;
                $('#selectedCount').text(`${count} nguyên liệu được chọn`);
                
                // Highlight active inputs
                $('.ing-qty-input').each(function() {
                    if (parseFloat($(this).val()) > 0) {
                        $(this).addClass('active');
                        $(this).closest('tr').addClass('bg-brand-bg-light');
                    } else {
                        $(this).removeClass('active');
                        $(this).closest('tr').removeClass('bg-brand-bg-light');
                    }
                });

                let cost = 0;
                $('.ing-row').each(function() {
                    const qtyInput = $(this).find('.ing-qty-input');
                    const qty = parseFloat(qtyInput.val()) || 0;
                    const unitPrice = parseFloat($(this).data('unit-price')) || 0;
                    const line = qty * unitPrice;
                    $(this).find('.ing-line-total').text(Math.round(line).toLocaleString('vi-VN') + '₫');
                    cost += line;
                });
                const margin = parseFloat($('#profitMarginInput').val()) || 0;
                const sale = Math.max(0, Math.round(cost * (1 + margin / 100)));
                $('#costPreview').val(Math.round(cost).toLocaleString('vi-VN') + '₫');
                $('#priceInput').val(sale);
            }

            $('.ing-qty-input').on('input', updateSelectedCount);
            $('#profitMarginInput').on('input', updateSelectedCount);
            updateSelectedCount(); // init
            renderIngredientPaging();
        });
    </script>
}
