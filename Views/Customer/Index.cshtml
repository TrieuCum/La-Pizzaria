@model IEnumerable<LaPizzaria.Models.Customer>

@{
    ViewData["Title"] = "Quản lý Khách hàng";
}

<style>
    /* GIỮ NGUYÊN CSS SIDEBAR CỦA BẠN */
    * {
        box-sizing: border-box;
    }

    body {
        font-size: 14px;
        margin: 0;
        padding: 0;
        font-family: 'Work Sans', sans-serif;
        background: #f8f7f5;
    }

    .v17_2729 {
        width: 256px;
        height: 100vh;
        background: rgba(255,255,255,1);
        position: fixed;
        top: 0;
        left: 0;
        z-index: 1010;
        border-right: 1px solid #f1f5f9;
        display: flex;
        flex-direction: column;
    }

    .v17_2730 {
        padding: 24px;
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 20px;
    }

    .v17_2731 {
        width: 40px;
        height: 40px;
        background: rgba(244,140,37,1);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 24px;
    }

    .v17_2735 {
        font-weight: 700;
        font-size: 18px;
        margin: 0;
    }

    .v17_2736 {
        font-size: 12px;
        color: rgba(107,114,128,1);
    }

    .sidebar-menu {
        flex-grow: 1;
        padding: 0 16px;
    }

    .v17_2738 {
        padding: 12px 16px;
        display: flex;
        align-items: center;
        gap: 12px;
        color: rgba(75,85,99,1);
        text-decoration: none;
        font-weight: 500;
        border-radius: 8px;
        transition: all 0.2s;
        margin-bottom: 4px;
    }

    .v17_2742 {
        background: rgba(244,140,37,0.1);
        color: rgba(244,140,37,1);
        font-weight: 600;
    }

    .main-wrapper {
        margin-left: 256px;
        padding: 40px;
        min-height: 100vh;
    }

    /* --- CẬP NHẬT GIAO DIỆN NỘI DUNG GIỐNG HÌNH 100% --- */

    /* Search & Filter Bar */
    .filter-section {
        display: flex;
        gap: 16px;
        margin-top: 24px;
        margin-bottom: 24px;
    }

    .search-input-wrapper {
        flex-grow: 1;
        background: white;
        border-radius: 12px;
        padding: 12px 16px;
        display: flex;
        align-items: center;
        gap: 10px;
        color: #9CA3AF;
        border: 1px solid transparent;
    }

    .filter-btn {
        background: white;
        padding: 12px 20px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 600;
        cursor: pointer;
    }

    .orange-dot {
        width: 12px;
        height: 12px;
        background: #A16207;
        border-radius: 3px;
    }

    /* Table & Card */
    .v17_2622 {
        background: white;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0,0,0,0.02);
    }

    .admin-table {
        width: 100%;
        border-collapse: collapse;
    }

        .admin-table th {
            padding: 16px 24px;
            text-align: left;
            color: #6B7280;
            font-weight: 600;
            font-size: 12px;
            text-transform: uppercase;
            border-bottom: 1px solid #F3F4F6;
        }

        .admin-table td {
            padding: 12px 24px;
            border-bottom: 1px solid #F9FAFB;
            vertical-align: middle;
        }

    /* Avatar & Badge */
    .avatar-circle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 13px;
        background: #FFEDD5;
        color: #9A3412;
    }

    .status-active {
        background: #DCFCE7;
        color: #166534;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .status-locked {
        background: #FEE2E2;
        color: #991B1B;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .points-text {
        color: #F97316;
        font-weight: 700;
        font-size: 15px;
    }

    /* Pagination (Số trang) */
    .pagination-footer {
        padding: 20px 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: #6B7280;
        font-size: 13px;
    }

    .page-numbers {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    .page-btn {
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        cursor: pointer;
        transition: 0.2s;
    }

        .page-btn.active {
            background: #F48C25;
            color: white;
            font-weight: 700;
        }

        .page-btn:hover:not(.active) {
            background: #F3F4F6;
        }
</style>

<div class="v17_2600">
    @* --- SIDEBAR (GIỮ NGUYÊN NHƯ BẠN YÊU CẦU) --- *@
    <aside class="v17_2729">
        <div class="v17_2730">
            <div class="v17_2731">🍕</div>
            <div>
                <h6 class="v17_2735">Pizza Admin</h6>
                <span class="v17_2736">Quản trị viên</span>
            </div>
        </div>

        <nav class="sidebar-menu">
            <a asp-controller="Statistics" asp-action="Daily" class="v17_2738">
                <i class="bi bi-grid"></i> Thống kê
            </a>
            <a asp-controller="Product" asp-action="Index" class="v17_2738">
                <i class="bi bi-box-seam"></i> Quản lý Sản phẩm
            </a>
            <a asp-controller="Table" asp-action="Index" class="v17_2738">
                <i class="bi bi-calendar-event"></i> Đặt bàn
            </a>
            <a href="#" class="v17_2738">
                <i class="bi bi-people"></i> Nhân viên
            </a>
            <a asp-controller="Ingredient" asp-action="Index" class="v17_2738">
                <i class="bi bi-egg-fried"></i> Nguyên liệu
            </a>
            <a asp-controller="Voucher" asp-action="Index" class="v17_2738">
                <i class="bi bi-ticket-perforated"></i> Voucher
            </a>
            <a href="#" class="v17_2738 v17_2742">
                <i class="bi bi-people-fill"></i> Khách hàng
            </a>
        </nav>

        <div style="padding: 20px;">
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" style="border:none; width:100%; cursor:pointer; padding:12px; background:#f3f4f6; border-radius:8px; font-weight:700; display:flex; align-items:center; justify-content:center; gap:8px;">
                    <i class="bi bi-box-arrow-right"></i> Đăng xuất
                </button>
            </form>
        </div>
    </aside>

    @* --- NỘI DUNG CHÍNH (ĐÃ SỬA GIỐNG HÌNH) --- *@
    <main class="main-wrapper">
        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
            <div>
                <h1 style="font-weight: 700; font-size: 28px; margin: 0;">Quản lý Khách hàng</h1>
                <p style="color: #6B7280; margin-top: 4px;">Xem và quản lý thông tin khách hàng thành viên</p>
            </div>
            <div style="background: #F48C25; color: white; padding: 10px; border-radius: 8px;">
                <i class="bi bi-app"></i>
            </div>
        </div>

        @* Thanh tìm kiếm & lọc *@
        <div class="filter-section">
            <div class="search-input-wrapper">
                <div class="orange-dot"></div>
                <span>Tìm kiếm theo tên, số điện thoại, email...</span>
            </div>
            <div class="filter-btn">
                <div class="orange-dot"></div>
                <span>Lọc theo trạng thái</span>
            </div>
        </div>

        <div class="v17_2622">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Tên khách hàng</th>
                        <th>Liên hệ</th>
                        <th>Trạng thái</th>
                        <th>Tổng đơn</th>
                        <th>Điểm tích lũy</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null)
                    {
                        @foreach (var customer in Model)
                        {
                            <tr>
                                <td>
                                    <div style="display: flex; align-items: center; gap: 12px;">
                                        <div class="avatar-circle">
                                            @customer.FullName.Substring(0, Math.Min(2, customer.FullName.Length)).ToUpper()
                                        </div>
                                        <div>
                                            <div style="font-weight:700; color: #111827;">@customer.FullName</div>
                                            <div style="font-size:11px; color:#9CA3AF;">ID: #CUS-@customer.Id.ToString("D3")</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div style="font-weight: 500;">@customer.Phone</div>
                                    <div style="font-size:12px; color:#6B7280;">@customer.Email</div>
                                </td>
                                <td>
                                    @if (customer.Points > 100)
                                    {
                                        <span class="status-active">Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="status-locked">Đã khóa</span>
                                    }
                                </td>
                                <td style="font-weight: 500;">15</td>
                                <td class="points-text">@customer.Points</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

            @* --- THANH PHÂN TRANG (PAGINATION) --- *@
            <div class="pagination-footer">
                <div>Hiển thị <b>1</b> đến <b>5</b> trong tổng số <b>128</b> khách hàng</div>
                <div class="page-numbers">
                    <div class="page-btn"><i class="bi bi-chevron-left"></i></div>
                    <div class="page-btn active">1</div>
                    <div class="page-btn">2</div>
                    <div class="page-btn"><i class="bi bi-chevron-right"></i></div>
                </div>
            </div>
        </div>
    </main>
</div>